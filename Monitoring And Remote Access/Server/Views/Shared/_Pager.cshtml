@using Microsoft.AspNetCore.Routing
@model Server.Models.PagerViewModel
@{
    // A single page needs no controls at all.
    if (Model.PageCount <= 1)
    {
        return;
    }

    // Paging must not drop the filter that produced the list, so the current
    // route values are carried through and only the page number is replaced.
    Func<int, RouteValueDictionary> pageLink = page =>
    {
        var values = Model.RouteValues is null
            ? new RouteValueDictionary()
            : new RouteValueDictionary(Model.RouteValues);
        values["page"] = page;
        return values;
    };

    var onFirst = Model.Page <= 1;
    var onLast = Model.Page >= Model.PageCount;
}
@*
    An unavailable direction is rendered as a span, not a disabled link. A link
    with Bootstrap's .disabled class still takes keyboard focus and still
    carries an href, so the keyboard user gets a focus stop that goes nowhere -
    in this case to a nonsense page=0.
*@
<nav class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2" aria-label="@Model.ItemNoun pages">
    <span class="small text-muted">@Model.TotalCount @Model.ItemNoun</span>
    <div class="d-flex align-items-center gap-2">
        @if (onFirst)
        {
            <span class="btn btn-sm btn-outline-secondary disabled" aria-hidden="true">Previous</span>
        }
        else
        {
            <a class="btn btn-sm btn-outline-secondary"
               rel="prev"
               href="@Url.Action(Model.Action, pageLink(Model.Page - 1))">Previous</a>
        }
        <span class="small">Page @Model.Page of @Model.PageCount</span>
        @if (onLast)
        {
            <span class="btn btn-sm btn-outline-secondary disabled" aria-hidden="true">Next</span>
        }
        else
        {
            <a class="btn btn-sm btn-outline-secondary"
               rel="next"
               href="@Url.Action(Model.Action, pageLink(Model.Page + 1))">Next</a>
        }
    </div>
</nav>
