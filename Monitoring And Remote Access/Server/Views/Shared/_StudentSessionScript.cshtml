    <!-- Warning / Notification Popup Modal -->
    <div class="modal fade" id="alertModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 text-white surface-brand" id="alertModalHeader">
                    <h5 class="modal-title fw-bold" id="alertModalTitle">Notification</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4 fs-6" id="alertModalBody">-</div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-emerald rounded-pill px-4" data-bs-dismiss="modal">I Understand</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const conn = new signalR.HubConnectionBuilder().withUrl("/remoteMonitoringHub").withAutomaticReconnect().build();
        let sStatus = "None";
        let sElapsed = 0;
        const tTimer = document.getElementById("toolbarTimer");
        const tSession = document.getElementById("toolbarSession");
        const alertModalEl = document.getElementById("alertModal");

        function fmt(sec) {
            const m = Math.floor(sec / 60), s = sec % 60;
            return String(m).padStart(2, "0") + ":" + String(s).padStart(2, "0");
        }
        function render() {
            tTimer.textContent = fmt(Math.max(0, sElapsed));
            tTimer.classList.remove("expired", "warn");
            tSession.textContent = sStatus;
            tSession.className = "badge rounded-pill px-3 py-2 " + (sStatus === "Running" ? "badge-active" : sStatus === "Paused" ? "bg-warning text-dark" : "bg-secondary");
        }
        setInterval(() => { if (sStatus === "Running") { sElapsed++; render(); } }, 1000);
        render();

        conn.on("GlobalSessionState", (state) => {
            sStatus = state.status;
            if (state.status === "Running") sElapsed = state.elapsedSeconds;
            render();
        });
        conn.on("SessionEnded", () => {
            sStatus = "Ended"; sElapsed = 0; render();
            document.getElementById("alertModalHeader").style.backgroundColor = "var(--cams-danger)";
            document.getElementById("alertModalTitle").textContent = "Session ended";
            document.getElementById("alertModalBody").textContent = "The laboratory session has been ended by the teacher. You will now be logged out.";
            alertModalEl.addEventListener("hidden.bs.modal", () => { location.href = "/Account/Logout"; }, { once: true });
            bootstrap.Modal.getOrCreateInstance(alertModalEl).show();
        });
        // Messages from the teacher surface as toasts that fade on their own.
        // Only the end-of-session notice still blocks, because it logs the
        // student out and must be acknowledged.
        conn.on("SendWarningPopup", (w) => {
            CamsToast.show(w.message || "", { type: "error", title: w.title || "Warning", timeout: 10000 });
        });
        conn.on("SendNotification", (n) => {
            CamsToast.show(n.message || "", { title: n.title || "Notification", timeout: 7000 });
        });
        let dismissBroadcastToast = null;
        conn.on("BroadcastScreen", (b) => {
            if (dismissBroadcastToast) dismissBroadcastToast();
            dismissBroadcastToast = CamsToast.show(
                "Your teacher is sharing their screen. Watch the broadcast window on the Student Client.",
                { title: "Screen broadcast", icon: "bi-broadcast", timeout: 8000 });
        });
        conn.on("BroadcastStopped", () => {
            if (dismissBroadcastToast) { dismissBroadcastToast(); dismissBroadcastToast = null; }
        });

        conn.start().catch(console.error);
    </script>
