@model Server.Models.Class
@using Server.Models
@{
    ViewData["Title"] = "Class Details - " + Model.ClassName;
    Layout = "_Layout";
    var roster = Model.ClassStudents.Where(cs => cs.Student != null).OrderBy(cs => cs.Student!.LastName).ThenBy(cs => cs.Student!.FirstName).ToList();
    var students = ViewBag.AllStudents as IEnumerable<Student> ?? Enumerable.Empty<Student>();
    var teachers = ViewBag.AvailableTeachers as IEnumerable<Teacher> ?? Enumerable.Empty<Teacher>();
    var activeTeacher = Model.Teacher != null && (Model.Teacher.Status == "Active" || string.IsNullOrEmpty(Model.Teacher.Status));
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <a asp-controller="Admin" asp-action="Classes" class="btn btn-outline-emerald btn-sm rounded-pill mb-3 px-3"><i class="bi bi-arrow-left me-1"></i>Back to classes</a>
        <h2 class="fw-extrabold mb-1 text-dark">@Model.ClassName</h2>
        <p class="text-muted mb-0 small">@Model.Section · @Model.GradeLevel · @Model.Subject</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="badge @(Model.IsArchived ? "bg-secondary" : !activeTeacher ? "bg-warning text-dark" : "badge-active") fs-6 px-3 py-2">@(Model.IsArchived ? "Archived" : !activeTeacher ? "Needs assignment" : "Active")</span>
        <form method="post" asp-controller="Admin" asp-action="ArchiveClass" class="m-0"><input type="hidden" name="id" value="@Model.ClassId" />@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-secondary rounded-pill">@(Model.IsArchived ? "Restore" : "Archive")</button></form>
        <form method="post" asp-controller="Admin" asp-action="DeleteClass" class="m-0" data-confirm="Delete this class and its enrollment links? Student accounts will be preserved." data-confirm-title="Delete class" data-confirm-label="Delete"><input type="hidden" name="classId" value="@Model.ClassId" />@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-danger rounded-pill">Delete</button></form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3 col-sm-6"><div class="metric-card"><div class="metric-title">Teacher</div><div class="metric-value fs-5">@(Model.Teacher == null ? "Unassigned" : activeTeacher ? $"{Model.Teacher.FirstName} {Model.Teacher.LastName}" : "Inactive teacher")</div></div></div>
    <div class="col-md-3 col-sm-6"><div class="metric-card"><div class="metric-title">Academic Year</div><div class="metric-value fs-5">@Model.AcademicYear</div></div></div>
    <div class="col-md-3 col-sm-6"><div class="metric-card metric-card-emerald"><div class="metric-title">Students</div><div class="metric-value fs-5 text-success">@roster.Count</div></div></div>
    <div class="col-md-3 col-sm-6"><div class="metric-card"><div class="metric-title">Schedule</div><div class="metric-value fs-6">@(string.IsNullOrWhiteSpace(Model.Schedule) ? "Flexible" : Model.Schedule)</div></div></div>
</div>

<div class="action-card mb-4">
    <div><h5 class="fw-bold mb-1 text-dark"><i class="bi bi-person-badge-fill me-2"></i>Teacher assignment</h5><p class="text-muted small mb-0">Active classes must have one active teacher.</p></div>
    <button type="button" class="btn btn-outline-emerald rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#assignTeacherModal">Manage teacher</button>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center"><h5 class="fw-bold mb-0 text-dark">Enrolled Students</h5><span class="badge bg-light text-dark font-monospace fs-6">@roster.Count Students</span></div>
    <div class="table-responsive"><table class="table custom-table mb-0"><thead><tr><th>Student ID</th><th>Full Name</th><th>Username</th><th>Date Enrolled</th><th class="text-end">Actions</th></tr></thead><tbody>
        @foreach (var membership in roster)
        {
            <tr><td class="fw-bold text-muted font-monospace">@membership.Student!.StudentNumber</td><td><div class="d-flex align-items-center gap-2"><div class="user-avatar-circle" style="width:32px;height:32px;font-size:.85rem;"><i class="bi bi-person-fill"></i></div><span class="fw-bold text-dark">@membership.Student.FullName</span></div></td><td class="font-monospace text-emerald-700">&#64;@membership.Student.Username</td><td>@membership.EnrolledAt.ToString("MMM dd, yyyy")</td><td class="text-end"><form method="post" asp-controller="Admin" asp-action="RemoveStudent" class="m-0" data-confirm="Remove this student from the class? The account will be preserved." data-confirm-title="Remove student" data-confirm-label="Remove"><input type="hidden" name="classId" value="@Model.ClassId" /><input type="hidden" name="studentId" value="@membership.StudentId" />@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="bi bi-person-x me-1"></i>Remove</button></form></td></tr>
        }
        @if (roster.Count == 0)
        {
            <tr><td colspan="5" class="text-center py-4 text-muted">No students are enrolled in this class yet.</td></tr>
        }
    </tbody></table></div>
</div>

@if (!Model.IsArchived)
{
<div class="row g-3">
    <div class="col-lg-4"><div class="action-card"><div><i class="bi bi-person-plus-fill fs-3"></i><h5 class="fw-bold mt-2 mb-1">Create student</h5><p class="text-muted small mb-0">Create an account and enroll it immediately.</p></div><button class="btn btn-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#createStudentForClassModal">Create</button></div></div>
    <div class="col-lg-4"><div class="action-card"><div><i class="bi bi-person-check-fill fs-3"></i><h5 class="fw-bold mt-2 mb-1">Enroll student</h5><p class="text-muted small mb-0">Choose an existing registered student.</p></div><button class="btn btn-outline-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#enrollStudentModal">Enroll</button></div></div>
    <div class="col-lg-4"><div class="action-card"><div><i class="bi bi-people-fill fs-3"></i><h5 class="fw-bold mt-2 mb-1">Import students</h5><p class="text-muted small mb-0">Use quick rows or preview a CSV file.</p></div><button class="btn btn-outline-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#importStudentsModal">Import</button></div></div>
</div>
}

<div class="modal fade" id="assignTeacherModal" tabindex="-1" aria-labelledby="assignTeacherModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header modal-header-themed"><h5 class="modal-title" id="assignTeacherModalLabel"><i class="bi bi-person-badge-fill me-2"></i>Assign teacher</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div><form method="post" asp-controller="Admin" asp-action="AssignTeacher">@Html.AntiForgeryToken()<input type="hidden" name="classId" value="@Model.ClassId" /><div class="modal-body"><label class="form-label">Active teacher</label><select name="teacherId" class="form-select" required><option value="">Select a teacher</option>@foreach (var teacher in teachers){<option value="@teacher.TeacherId" selected="@(Model.TeacherId == teacher.TeacherId ? "selected" : null)">@teacher.FirstName @teacher.LastName (@teacher.Username)</option>}</select></div><div class="modal-footer"><button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-emerald rounded-pill px-4">Save assignment</button></div></form></div></div></div>

@if (!Model.IsArchived)
{
<div class="modal fade" id="createStudentForClassModal" tabindex="-1" aria-labelledby="createStudentForClassModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content"><div class="modal-header modal-header-themed"><h5 class="modal-title" id="createStudentForClassModalLabel"><i class="bi bi-person-plus-fill me-2"></i>Create and enroll student</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div><form method="post" asp-controller="Admin" asp-action="AddStudentToClass">@Html.AntiForgeryToken()<input type="hidden" name="classId" value="@Model.ClassId" /><div class="modal-body"><p class="text-muted small">The new account will be added to @Model.ClassName immediately.</p><div class="row g-3"><div class="col-md-6"><label class="form-label">First name</label><input name="firstName" class="form-control" required /></div><div class="col-md-6"><label class="form-label">Last name</label><input name="lastName" class="form-control" required /></div><div class="col-md-6"><label class="form-label">Username <span class="text-muted">(optional)</span></label><input name="username" class="form-control" /></div><div class="col-md-6"><label class="form-label">Password</label><input name="password" type="password" minlength="6" class="form-control" required /></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-emerald rounded-pill px-4">Create and enroll</button></div></form></div></div></div>

<div class="modal fade" id="enrollStudentModal" tabindex="-1" aria-labelledby="enrollStudentModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header modal-header-themed"><h5 class="modal-title" id="enrollStudentModalLabel"><i class="bi bi-person-check-fill me-2"></i>Enroll existing student</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div><form method="post" asp-controller="Admin" asp-action="EnrollStudent" id="existingStudentForm">@Html.AntiForgeryToken()<input type="hidden" name="classId" value="@Model.ClassId" /><input type="hidden" name="moveStudent" id="moveStudent" value="false" /><div class="modal-body"><p class="text-muted small">Moving a student from another class requires confirmation.</p><label class="form-label">Registered student</label><select name="studentId" id="existingStudentSelect" class="form-select" required><option value="">Select a student</option>@foreach (var student in students.Where(s => !roster.Any(r => r.StudentId == s.Id))){<option value="@student.Id" data-current-class="@(student.ClassId.HasValue ? student.Class?.ClassName : "")">@student.StudentNumber - @student.FullName (&#64;@student.Username)@(student.ClassId.HasValue ? $" · Currently: {student.Class?.ClassName}" : "")</option>}</select></div><div class="modal-footer"><button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-emerald rounded-pill px-4">Enroll student</button></div></form></div></div></div>

<div class="modal fade" id="importStudentsModal" tabindex="-1" aria-labelledby="importStudentsModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable"><div class="modal-content"><div class="modal-header modal-header-themed"><h5 class="modal-title" id="importStudentsModalLabel"><i class="bi bi-people-fill me-2"></i>Import students</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="modal-section mb-3"><h6 class="fw-bold">Quick bulk entry</h6><p class="text-muted small">Fill one or more rows. Every filled row needs a six-character password.</p><form method="post" asp-controller="Admin" asp-action="BulkAddStudents">@Html.AntiForgeryToken()<input type="hidden" name="classId" value="@Model.ClassId" /><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>First</th><th>Last</th><th>Username</th><th>Password</th></tr></thead><tbody>@for (var i = 0; i < 5; i++){<tr><td><input name="bulkFirstNames" class="form-control form-control-sm" /></td><td><input name="bulkLastNames" class="form-control form-control-sm" /></td><td><input name="bulkUserNames" class="form-control form-control-sm" /></td><td><input name="bulkPasswords" type="password" minlength="6" class="form-control form-control-sm" /></td></tr>}</tbody></table></div><button type="submit" class="btn btn-emerald rounded-pill mt-3 px-4">Add filled rows</button></form></div><div class="modal-section"><h6 class="fw-bold">CSV preview</h6><form method="post" enctype="multipart/form-data" asp-controller="Admin" asp-action="BulkPreviewCsv">@Html.AntiForgeryToken()<input type="hidden" name="classId" value="@Model.ClassId" /><input type="file" name="file" accept=".csv,text/csv" class="form-control" required /><div class="form-text">Columns: student number, first name, last name, full name, username, password.</div><button type="submit" class="btn btn-outline-emerald rounded-pill mt-3 px-4">Preview CSV</button></form></div></div><div class="modal-footer"><button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button></div></div></div></div>
}

@section Scripts {
    <script>
        document.getElementById('existingStudentForm')?.addEventListener('submit', async function (event) {
            const select = document.getElementById('existingStudentSelect');
            const option = select?.selectedOptions[0];
            const currentClass = option?.dataset.currentClass || '';
            const moveField = document.getElementById('moveStudent');
            if (!currentClass || moveField.value === 'true') return;
            event.preventDefault();
            const confirmed = await window.camsConfirm({ title: 'Move student', message: `Move this student from ${currentClass} to @Model.ClassName?`, confirmLabel: 'Move student', variant: 'warning' });
            if (!confirmed) return;
            moveField.value = 'true';
            this.requestSubmit();
        });
    </script>
}
