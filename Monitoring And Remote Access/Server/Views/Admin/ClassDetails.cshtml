@model Server.Models.Class
@{
    ViewData["Title"] = "Class Details – " + Model.ClassName;
    Layout = "_Layout";
}

<!-- Breadcrumb & Header -->
<div class="mb-4">
    <a href="/Admin/Classes" class="btn btn-outline-emerald btn-sm rounded-pill mb-3 px-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Class Management
    </a>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">@Model.ClassName</h2>
            <p class="text-muted mb-0 small">Section: <strong class="text-dark">@Model.Section</strong> | Subject: <strong class="text-dark">@Model.Subject</strong></p>
        </div>
        <span class="badge badge-emerald fs-6 px-3 py-2">
            <i class="bi bi-people-fill me-1"></i> @Model.ClassStudents.Count Enrolled
        </span>
    </div>
</div>

<!-- Class Specs Metric Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Section</div>
                <div class="metric-value fs-4 text-dark">@(string.IsNullOrEmpty(Model.Section) ? "Main" : Model.Section)</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-diagram-3-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Subject</div>
                <div class="metric-value fs-4 text-success">@(string.IsNullOrEmpty(Model.Subject) ? "General" : Model.Subject)</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-book-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Grade Level</div>
                <div class="metric-value fs-4 text-dark">@(string.IsNullOrEmpty(Model.GradeLevel) ? "General" : Model.GradeLevel)</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-mortarboard-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="metric-card metric-card-active d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Schedule</div>
                <div class="metric-value fs-5 text-dark">@(string.IsNullOrEmpty(Model.Schedule) ? "Flexible" : Model.Schedule)</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-calendar-event fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Enrolled Students Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Enrolled Students Roster</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@Model.ClassStudents.Count Students</span>
    </div>
    <div class="table-responsive">
        <table class="table custom-table mb-0">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Date Enrolled</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cs in Model.ClassStudents.OrderBy(cs => cs.Student?.FullName))
                {
                    <tr>
                        <td class="fw-bold text-muted font-monospace">@cs.Student?.StudentNumber</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar-circle" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="fw-bold text-dark">@cs.Student?.FullName</span>
                            </div>
                        </td>
                        <td>@cs.EnrolledAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <form method="post" action="/Admin/RemoveStudent" style="margin:0;" onsubmit="return confirm('Remove student from class?');">
                                <input type="hidden" name="classId" value="@Model.ClassId" />
                                <input type="hidden" name="studentId" value="@cs.StudentId" />
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="bi bi-person-x me-1"></i> Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.ClassStudents.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No students currently enrolled in this class section.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Enroll Student Card -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <h5 class="fw-bold mb-3 text-dark">
        <i class="bi bi-person-plus-fill me-2 text-emerald-700"></i> Enroll Student to @Model.ClassName
    </h5>
    <form method="post" action="/Admin/EnrollStudent" class="row g-3 align-items-center">
        <input type="hidden" name="classId" value="@Model.ClassId" />
        <div class="col-md-9">
            <select name="studentId" class="form-select filter-control" required>
                <option value="">-- Select a registered student to enroll --</option>
                @foreach (var s in (ViewBag.AllStudents as IEnumerable<Server.Models.Student>) ?? new List<Server.Models.Student>())
                {
                    @if (!Model.ClassStudents.Any(cs => cs.StudentId == s.Id))
                    {
                        <option value="@s.Id">@s.StudentNumber — @s.FullName (@@@s.Username)</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-emerald w-100 py-2 fw-bold text-white rounded-pill">
                <i class="bi bi-plus-circle me-1"></i> Enroll Student
            </button>
        </div>
    </form>
</div>