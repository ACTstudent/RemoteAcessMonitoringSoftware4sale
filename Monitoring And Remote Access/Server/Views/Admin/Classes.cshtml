@model IEnumerable<Server.Models.Class>
@using Server.Models
@{
    ViewData["Title"] = "Class Management";
    Layout = "_Layout";
    var teachers = ViewBag.TeacherList as IEnumerable<Teacher> ?? Enumerable.Empty<Teacher>();
    var classes = Model.OrderBy(c => c.IsArchived).ThenBy(c => c.ClassName).ToList();
    var activeCount = classes.Count(c => !c.IsArchived);
    var archivedCount = classes.Count(c => c.IsArchived);
    var grades = classes.Select(c => c.GradeLevel?.Trim()).Where(g => !string.IsNullOrWhiteSpace(g)).Distinct().OrderBy(g => g).ToList();
    var totalStudentsEnrolled = classes.Sum(c => c.ClassStudents.Count);
}

<div class="crud-page-header d-flex align-items-center gap-3 mb-4">
    <div class="icon-box-primary"><i class="bi bi-collection-fill fs-3" aria-hidden="true"></i></div>
    <div>
        <h2 class="fw-extrabold mb-1 text-dark">Class Management</h2>
        <p class="text-muted mb-0 small">Manage sections, teachers, and student profiles. @totalStudentsEnrolled enrolled student profile(s).</p>
    </div>
</div>

<div class="row g-3 mb-4 crud-metrics">
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div><div class="metric-title">Total Classes</div><div class="metric-value">@classes.Count</div></div>
            <div class="metric-icon-box"><i class="bi bi-folder-fill" aria-hidden="true"></i></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div><div class="metric-title">Active Classes</div><div class="metric-value">@activeCount</div></div>
            <div class="metric-icon-box"><i class="bi bi-folder-check" aria-hidden="true"></i></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card metric-card-muted d-flex justify-content-between align-items-center">
            <div><div class="metric-title">Archived Classes</div><div class="metric-value">@archivedCount</div></div>
            <div class="metric-icon-box bg-light text-secondary"><i class="bi bi-archive-fill" aria-hidden="true"></i></div>
        </div>
    </div>
</div>

<section class="crud-panel" data-crud-list data-crud-label="classes" data-crud-page-size="6" aria-label="Class directory">
    <div class="crud-toolbar">
        <input type="search" class="form-control crud-search" data-crud-search aria-label="Search classes" placeholder="Search classes..." />
        <select class="form-select" data-crud-filter="grade" aria-label="Filter class grade">
            <option value="">All grades</option>
            @foreach (var grade in grades)
            {
                <option value="@grade">@grade</option>
            }
        </select>
        <select class="form-select" data-crud-filter="status" aria-label="Filter class status">
            <option value="">All statuses</option>
            <option value="Active">Active</option>
            <option value="Archived">Archived</option>
        </select>
        <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#createClassModal"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Create Class</button>
    </div>
    <div class="crud-grid row g-3">
        @foreach (var item in classes)
        {
            var status = item.IsArchived ? "Archived" : "Active";
            var hasTeacher = item.Teacher != null && (item.Teacher.Status == "Active" || string.IsNullOrEmpty(item.Teacher.Status));
            <div class="col-xl-4 col-md-6" data-crud-item data-status="@status" data-grade="@(item.GradeLevel?.Trim())" data-crud-search-text="@($"{item.ClassName} {item.Section} {item.GradeLevel} {item.Subject} {item.AcademicYear} {item.Schedule} {item.Teacher?.FirstName} {item.Teacher?.LastName}")">
                <article class="class-card h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <h3 class="h6 fw-bold mb-1 text-dark">@item.ClassName</h3>
                            <span class="text-muted small">@(string.IsNullOrWhiteSpace(item.Section) ? "Main section" : item.Section) · @(string.IsNullOrWhiteSpace(item.GradeLevel) ? "Grade not set" : item.GradeLevel)</span>
                        </div>
                        <span class="badge @(item.IsArchived ? "bg-secondary-subtle text-secondary" : "badge-active")">@status</span>
                    </div>
                    <div class="info-list mb-3">
                        <div class="d-flex justify-content-between gap-3 py-1"><span class="text-muted small">Academic year</span><span class="fw-semibold text-dark small text-end">@(string.IsNullOrWhiteSpace(item.AcademicYear) ? "Not set" : item.AcademicYear)</span></div>
                        <div class="d-flex justify-content-between gap-3 py-1"><span class="text-muted small">Teacher</span><span class="fw-semibold small text-end @(hasTeacher ? "text-dark" : "text-warning-emphasis")">@(hasTeacher ? $"{item.Teacher!.FirstName} {item.Teacher.LastName}" : item.Teacher == null ? "Not assigned" : "Teacher inactive")</span></div>
                        <div class="d-flex justify-content-between gap-3 py-1"><span class="text-muted small">Subject</span><span class="fw-semibold text-dark small text-end">@(string.IsNullOrWhiteSpace(item.Subject) ? "General" : item.Subject)</span></div>
                        <div class="d-flex justify-content-between gap-3 py-1"><span class="text-muted small">Students</span><span class="fw-semibold text-dark small">@item.ClassStudents.Count</span></div>
                    </div>
                    <a asp-controller="Admin" asp-action="ClassDetails" asp-route-id="@item.ClassId" class="btn btn-view-class w-100 mt-auto">View Class<span class="visually-hidden"> @item.ClassName</span></a>
                    <div class="crud-card-actions d-flex justify-content-end flex-wrap gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-outline-emerald" data-bs-toggle="modal" data-bs-target="#editClassModal-@item.ClassId" title="Edit class"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit<span class="visually-hidden"> @item.ClassName</span></button>
                        <form method="post" asp-controller="Admin" asp-action="ArchiveClass" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.ClassId" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(item.IsArchived ? "Restore class" : "Archive class")"><i class="bi @(item.IsArchived ? "bi-arrow-counterclockwise" : "bi-archive") me-1" aria-hidden="true"></i>@(item.IsArchived ? "Restore" : "Archive")<span class="visually-hidden"> @item.ClassName</span></button>
                        </form>
                        <form method="post" asp-controller="Admin" asp-action="DeleteClass" class="m-0" data-confirm="Delete this class and its enrollment links? Student accounts will be preserved." data-confirm-title="Delete class" data-confirm-label="Delete">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="classId" value="@item.ClassId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete class"><i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">Delete @item.ClassName</span></button>
                        </form>
                    </div>
                </article>
            </div>
        }
    </div>
    <div class="crud-no-results" data-crud-empty hidden>
        @if (classes.Count == 0)
        {
            <i class="bi bi-folder-plus" aria-hidden="true"></i><h3 class="h6 mt-2">No classes yet</h3><p class="small mb-0">Select Create Class to add your first section.</p>
        }
        else
        {
            <span>No classes match your search.</span>
        }
    </div>
    <div class="crud-footer" data-crud-pagination></div>
</section>
<div class="modal fade" id="createClassModal" tabindex="-1" aria-labelledby="createClassModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white surface-brand"><h5 class="modal-title fw-bold" id="createClassModalLabel"><i class="bi bi-folder-plus me-2"></i>Create New Class</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <form method="post" asp-controller="Admin" asp-action="CreateClass">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="row g-3">
                        <div class="col-md-8"><label class="form-label fw-semibold small" for="classes-class-name">Class name <span class="text-danger">*</span></label><input id="classes-class-name" name="ClassName" class="form-control filter-control" required placeholder="e.g. Grade 6 - Sampaguita" /></div>
                        <div class="col-md-4"><label class="form-label fw-semibold small" for="classes-academic-year">Academic year</label><input id="classes-academic-year" name="AcademicYear" class="form-control filter-control" value="2026-2027" /></div>
                        <div class="col-md-6"><label class="form-label fw-semibold small" for="classes-section">Section</label><input id="classes-section" name="Section" class="form-control filter-control" placeholder="e.g. Section A" /></div>
                        <div class="col-md-6"><label class="form-label fw-semibold small" for="classes-grade-level">Grade level</label><input id="classes-grade-level" name="GradeLevel" class="form-control filter-control" placeholder="e.g. Grade 6" /></div>
                        <div class="col-md-6"><label class="form-label fw-semibold small" for="classes-subject">Subject</label><input id="classes-subject" name="Subject" class="form-control filter-control" placeholder="e.g. Computer Science" /></div>
                        <div class="col-md-6"><label class="form-label fw-semibold small" for="classes-schedule">Schedule</label><input id="classes-schedule" name="Schedule" class="form-control filter-control" placeholder="e.g. M/W/F 8:00 AM" /></div>
                        <div class="col-12"><label class="form-label fw-semibold small" for="classes-assigned-teacher-optional">Assigned teacher <span class="text-muted">(optional)</span></label><select id="classes-assigned-teacher-optional" name="TeacherId" class="form-select filter-control"><option value="">Leave unassigned</option>@foreach (var teacher in teachers){<option value="@teacher.TeacherId">@teacher.FirstName @teacher.LastName (@teacher.Username)</option>}</select></div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0"><button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-emerald rounded-pill px-4">Create class</button></div>
            </form>
        </div>
    </div>
</div>

@foreach (var item in Model)
{
    <div class="modal fade" id="editClassModal-@item.ClassId" tabindex="-1" aria-labelledby="editClassModalLabel-@item.ClassId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 text-white surface-brand"><h5 class="modal-title fw-bold" id="editClassModalLabel-@item.ClassId"><i class="bi bi-pencil-square me-2"></i>Edit @item.ClassName</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <form method="post" asp-controller="Admin" asp-action="UpdateClass">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ClassId" value="@item.ClassId" />
                    <div class="modal-body py-4">
                        <div class="row g-3">
                            <div class="col-md-8"><label class="form-label fw-semibold small" for="classes-class-name-@item.ClassId">Class name</label><input id="classes-class-name-@item.ClassId" name="ClassName" class="form-control filter-control" value="@item.ClassName" required /></div>
                            <div class="col-md-4"><label class="form-label fw-semibold small" for="classes-academic-year-@item.ClassId">Academic year</label><input id="classes-academic-year-@item.ClassId" name="AcademicYear" class="form-control filter-control" value="@item.AcademicYear" /></div>
                            <div class="col-md-6"><label class="form-label fw-semibold small" for="classes-section-@item.ClassId">Section</label><input id="classes-section-@item.ClassId" name="Section" class="form-control filter-control" value="@item.Section" /></div>
                            <div class="col-md-6"><label class="form-label fw-semibold small" for="classes-grade-level-@item.ClassId">Grade level</label><input id="classes-grade-level-@item.ClassId" name="GradeLevel" class="form-control filter-control" value="@item.GradeLevel" /></div>
                            <div class="col-md-6"><label class="form-label fw-semibold small" for="classes-subject-@item.ClassId">Subject</label><input id="classes-subject-@item.ClassId" name="Subject" class="form-control filter-control" value="@item.Subject" /></div>
                            <div class="col-md-6"><label class="form-label fw-semibold small" for="classes-schedule-@item.ClassId">Schedule</label><input id="classes-schedule-@item.ClassId" name="Schedule" class="form-control filter-control" value="@item.Schedule" /></div>
                            <div class="col-12"><label class="form-label fw-semibold small" for="classes-assigned-teacher-optional-@item.ClassId">Assigned teacher <span class="text-muted">(optional)</span></label><select id="classes-assigned-teacher-optional-@item.ClassId" name="TeacherId" class="form-select filter-control"><option value="">Leave unassigned</option>@foreach (var teacher in teachers){<option value="@teacher.TeacherId" selected="@(item.TeacherId == teacher.TeacherId ? "selected" : null)">@teacher.FirstName @teacher.LastName (@teacher.Username)</option>}</select></div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0"><button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-emerald rounded-pill px-4">Save Changes</button></div>
                </form>
            </div>
        </div>
    </div>
}
