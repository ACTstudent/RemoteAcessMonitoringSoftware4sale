@model IEnumerable<Server.Models.Class>
@{
    ViewData["Title"] = "Class Management";
    Layout = "_Layout";

    var activeCount = Model.Count(c => !c.IsArchived);
    var archivedCount = Model.Count(c => c.IsArchived);
    var totalStudentsEnrolled = Model.Sum(c => c.ClassStudents.Count);
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-folder-symlink-fill fs-3"></i>
        </div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">Class Management</h2>
            <p class="text-muted mb-0 small">Manage advisory sections, instructor subjects & schedules</p>
        </div>
    </div>
    <button class="btn btn-emerald rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#createClassModal">
        <i class="bi bi-plus-circle-fill me-1"></i> Create Class
    </button>
</div>

<!-- Metric Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Active Classes</div>
                <div class="metric-value">@activeCount</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-folder-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Enrolled Students</div>
                <div class="metric-value text-success">@totalStudentsEnrolled</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-people-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Archived Classes</div>
                <div class="metric-value text-muted">@archivedCount</div>
            </div>
            <div class="metric-icon-box bg-light text-secondary">
                <i class="bi bi-archive-fill fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Class Section Cards Grid -->
<h5 class="fw-bold mb-3 text-dark">Active Class Sections</h5>
<div class="row g-4 mb-5">
    @foreach (var item in Model.Where(c => !c.IsArchived))
    {
        <div class="col-md-4 col-sm-6">
            <div class="class-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <!-- Card Header -->
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">@item.ClassName</h5>
                            <span class="text-muted small">@item.Section (@item.GradeLevel)</span>
                        </div>
                        <span class="badge badge-active">Active</span>
                    </div>

                    <!-- Card Info Rows -->
                    <div class="info-list mb-4">
                        <div class="d-flex justify-content-between py-1 border-bottom-subtle">
                            <span class="text-muted small">Subject:</span>
                            <span class="fw-bold text-dark small">@(string.IsNullOrEmpty(item.Subject) ? "General" : item.Subject)</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom-subtle">
                            <span class="text-muted small">Schedule:</span>
                            <span class="fw-semibold text-dark small">@(string.IsNullOrEmpty(item.Schedule) ? "Flexible" : item.Schedule)</span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-muted small">Students Enrolled:</span>
                            <span class="fw-bold text-success small">@item.ClassStudents.Count</span>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-2">
                    <a href="/Admin/ClassDetails/@item.ClassId" class="btn btn-view-class flex-grow-1 py-2 fw-semibold">
                        <i class="bi bi-people me-1"></i> Roster
                    </a>
                    <form method="post" action="/Admin/ArchiveClass" style="margin: 0;">
                        <input type="hidden" name="id" value="@item.ClassId" />
                        <button class="btn btn-outline-danger py-2" title="Archive Class">
                            <i class="bi bi-archive"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any(c => !c.IsArchived))
    {
        <div class="col-12">
            <div class="card p-5 text-center text-muted">
                <i class="bi bi-folder-x fs-1 mb-2"></i>
                <h5>No active classes found</h5>
                <p class="small">Click "Create Class" above to set up your first class section.</p>
            </div>
        </div>
    }
</div>

@if (Model.Any(c => c.IsArchived))
{
    <h5 class="fw-bold mb-3 text-muted">Archived Classes</h5>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table custom-table mb-0 text-muted">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Section</th>
                        <th>Subject</th>
                        <th>Grade</th>
                        <th>Schedule</th>
                        <th>Students</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cls in Model.Where(c => c.IsArchived))
                    {
                        <tr>
                            <td class="fw-bold">@cls.ClassName</td>
                            <td>@cls.Section</td>
                            <td>@cls.Subject</td>
                            <td>@cls.GradeLevel</td>
                            <td>@cls.Schedule</td>
                            <td>@cls.ClassStudents.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Modal: Create Class -->
<div class="modal fade" id="createClassModal" tabindex="-1" aria-labelledby="createClassModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                <h5 class="modal-title fw-bold" id="createClassModalLabel">
                    <i class="bi bi-folder-plus me-2"></i> Create New Class
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/CreateClass">
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Class Name <span class="text-danger">*</span></label>
                        <input type="text" name="ClassName" class="form-control filter-control" required placeholder="e.g. Grade 6 - Sampaguita" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small">Section</label>
                            <input type="text" name="Section" class="form-control filter-control" placeholder="e.g. Section A" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small">Grade Level</label>
                            <input type="text" name="GradeLevel" class="form-control filter-control" placeholder="e.g. Grade 6" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Subject</label>
                        <input type="text" name="Subject" class="form-control filter-control" placeholder="e.g. Computer Science" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Schedule</label>
                        <input type="text" name="Schedule" class="form-control filter-control" placeholder="e.g. M/W/F 8:00 AM - 9:00 AM" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Create Class</button>
                </div>
            </form>
        </div>
    </div>
</div>