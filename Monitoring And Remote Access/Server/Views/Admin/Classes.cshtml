@model IEnumerable<Server.Models.Class>
@using Server.Models
@{
    ViewData["Title"] = "Class Management";
    Layout = "_Layout";
    var teachers = ViewBag.TeacherList as IEnumerable<Teacher> ?? Enumerable.Empty<Teacher>();
    var activeClasses = Model.Where(c => !c.IsArchived).ToList();
    var archivedClasses = Model.Where(c => c.IsArchived).ToList();
    var activeCount = activeClasses.Count;
    var archivedCount = archivedClasses.Count;
    var totalStudentsEnrolled = Model.Sum(c => c.ClassStudents.Count);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary"><i class="bi bi-folder-symlink-fill fs-3"></i></div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark">Class Management</h2>
            <p class="text-muted mb-0 small">Keep sections, teachers, schedules, and student profiles in one place.</p>
        </div>
    </div>
    <button class="btn btn-emerald rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#createClassModal">
        <i class="bi bi-plus-circle-fill me-1"></i> Create Class
    </button>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div><div class="metric-title">Active Classes</div><div class="metric-value">@activeCount</div></div>
            <div class="metric-icon-box"><i class="bi bi-folder-fill fs-3"></i></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div><div class="metric-title">Student Profiles</div><div class="metric-value text-success">@totalStudentsEnrolled</div></div>
            <div class="metric-icon-box"><i class="bi bi-people-fill fs-3"></i></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div><div class="metric-title">Archived Classes</div><div class="metric-value text-muted">@archivedCount</div></div>
            <div class="metric-icon-box bg-light text-secondary"><i class="bi bi-archive-fill fs-3"></i></div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0 text-dark">Active Class Sections</h5>
    <span class="text-muted small">@activeCount section(s)</span>
</div>
<div class="row g-4 mb-5">
    @foreach (var item in activeClasses)
    {
        var hasTeacher = item.Teacher != null && (item.Teacher.Status == "Active" || string.IsNullOrEmpty(item.Teacher.Status));
        <div class="col-xl-4 col-md-6">
            <div class="class-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">@item.ClassName</h5>
                            <span class="text-muted small">@(string.IsNullOrWhiteSpace(item.Section) ? "Main section" : item.Section) · @(string.IsNullOrWhiteSpace(item.GradeLevel) ? "Grade not set" : item.GradeLevel)</span>
                        </div>
                        <span class="badge @(hasTeacher ? "badge-active" : "bg-warning text-dark")">@(hasTeacher ? "Active" : "Needs assignment")</span>
                    </div>
                    <div class="info-list mb-4">
                        <div class="d-flex justify-content-between gap-3 py-1 border-bottom-subtle"><span class="text-muted small">Teacher</span><span class="fw-semibold text-dark small text-end">@(hasTeacher ? $"{item.Teacher!.FirstName} {item.Teacher.LastName}" : item.Teacher == null ? "Not assigned" : "Teacher inactive")</span></div>
                        <div class="d-flex justify-content-between gap-3 py-1 border-bottom-subtle"><span class="text-muted small">Subject</span><span class="fw-semibold text-dark small text-end">@(string.IsNullOrWhiteSpace(item.Subject) ? "General" : item.Subject)</span></div>
                        <div class="d-flex justify-content-between gap-3 py-1"><span class="text-muted small">Students</span><span class="fw-bold text-success small">@item.ClassStudents.Count</span></div>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Admin" asp-action="ClassDetails" asp-route-id="@item.ClassId" class="btn btn-view-class flex-grow-1 py-2 fw-semibold"><i class="bi bi-people me-1"></i> Student Profiles</a>
                    <button type="button" class="btn btn-outline-emerald py-2" data-bs-toggle="modal" data-bs-target="#editClassModal-@item.ClassId" title="Edit class"><i class="bi bi-pencil"></i><span class="visually-hidden">Edit</span></button>
                    <form method="post" asp-controller="Admin" asp-action="ArchiveClass" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.ClassId" />
                        <button type="submit" class="btn btn-outline-secondary py-2" title="Archive class"><i class="bi bi-archive"></i><span class="visually-hidden">Archive</span></button>
                    </form>
                    <form method="post" asp-controller="Admin" asp-action="DeleteClass" class="m-0" data-confirm="Delete this class and its enrollment links? Student accounts will be preserved." data-confirm-title="Delete class" data-confirm-label="Delete">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="classId" value="@item.ClassId" />
                        <button type="submit" class="btn btn-outline-danger py-2" title="Delete class"><i class="bi bi-trash"></i><span class="visually-hidden">Delete</span></button>
                    </form>
                </div>
            </div>
        </div>
    }
    @if (activeClasses.Count == 0)
    {
        <div class="col-12"><div class="card p-5 text-center text-muted"><i class="bi bi-folder-x fs-1 mb-2"></i><h5>No active classes</h5><p class="small mb-0">Create a class to start adding student profiles.</p></div></div>
    }
</div>

@if (archivedClasses.Count > 0)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-muted">Archived Classes</h5>
        <span class="text-muted small">Archived records remain available for review.</span>
    </div>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table custom-table mb-0">
                <thead><tr><th>Class</th><th>Teacher</th><th>Academic Year</th><th>Students</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                    @foreach (var item in archivedClasses)
                    {
                        <tr>
                            <td><strong>@item.ClassName</strong><span class="d-block text-muted small">@item.Section · @item.GradeLevel</span></td>
                            <td>@(item.Teacher == null ? "Needs assignment" : $"{item.Teacher.FirstName} {item.Teacher.LastName} ({item.Teacher.Status})")</td>
                            <td>@item.AcademicYear</td>
                            <td>@item.ClassStudents.Count</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-controller="Admin" asp-action="ClassDetails" asp-route-id="@item.ClassId" class="btn btn-sm btn-outline-emerald rounded-pill">Student Profiles</a>
                                    <button type="button" class="btn btn-sm btn-outline-emerald rounded-pill" data-bs-toggle="modal" data-bs-target="#editClassModal-@item.ClassId">Edit</button>
                                    <form method="post" asp-controller="Admin" asp-action="ArchiveClass" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ClassId" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill">Restore</button>
                                    </form>
                                    <form method="post" asp-controller="Admin" asp-action="DeleteClass" class="m-0" data-confirm="Delete this class and its enrollment links? Student accounts will be preserved." data-confirm-title="Delete class" data-confirm-label="Delete">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="classId" value="@item.ClassId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="modal fade" id="createClassModal" tabindex="-1" aria-labelledby="createClassModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);"><h5 class="modal-title fw-bold" id="createClassModalLabel"><i class="bi bi-folder-plus me-2"></i>Create New Class</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <form method="post" asp-controller="Admin" asp-action="CreateClass">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="row g-3">
                        <div class="col-md-8"><label class="form-label fw-semibold small">Class name <span class="text-danger">*</span></label><input name="ClassName" class="form-control filter-control" required placeholder="e.g. Grade 6 - Sampaguita" /></div>
                        <div class="col-md-4"><label class="form-label fw-semibold small">Academic year</label><input name="AcademicYear" class="form-control filter-control" value="2026-2027" /></div>
                        <div class="col-md-6"><label class="form-label fw-semibold small">Section</label><input name="Section" class="form-control filter-control" placeholder="e.g. Section A" /></div>
                        <div class="col-md-6"><label class="form-label fw-semibold small">Grade level</label><input name="GradeLevel" class="form-control filter-control" placeholder="e.g. Grade 6" /></div>
                        <div class="col-md-6"><label class="form-label fw-semibold small">Subject</label><input name="Subject" class="form-control filter-control" placeholder="e.g. Computer Science" /></div>
                        <div class="col-md-6"><label class="form-label fw-semibold small">Schedule</label><input name="Schedule" class="form-control filter-control" placeholder="e.g. M/W/F 8:00 AM" /></div>
                        <div class="col-12"><label class="form-label fw-semibold small">Assigned teacher <span class="text-muted">(optional)</span></label><select name="TeacherId" class="form-select filter-control"><option value="">Leave unassigned</option>@foreach (var teacher in teachers){<option value="@teacher.TeacherId">@teacher.FirstName @teacher.LastName (@teacher.Username)</option>}</select></div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0"><button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-emerald rounded-pill px-4">Create Class</button></div>
            </form>
        </div>
    </div>
</div>

@foreach (var item in Model)
{
    <div class="modal fade" id="editClassModal-@item.ClassId" tabindex="-1" aria-labelledby="editClassModalLabel-@item.ClassId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);"><h5 class="modal-title fw-bold" id="editClassModalLabel-@item.ClassId"><i class="bi bi-pencil-square me-2"></i>Edit @item.ClassName</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <form method="post" asp-controller="Admin" asp-action="UpdateClass">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ClassId" value="@item.ClassId" />
                    <div class="modal-body py-4">
                        <div class="row g-3">
                            <div class="col-md-8"><label class="form-label fw-semibold small">Class name</label><input name="ClassName" class="form-control filter-control" value="@item.ClassName" required /></div>
                            <div class="col-md-4"><label class="form-label fw-semibold small">Academic year</label><input name="AcademicYear" class="form-control filter-control" value="@item.AcademicYear" /></div>
                            <div class="col-md-6"><label class="form-label fw-semibold small">Section</label><input name="Section" class="form-control filter-control" value="@item.Section" /></div>
                            <div class="col-md-6"><label class="form-label fw-semibold small">Grade level</label><input name="GradeLevel" class="form-control filter-control" value="@item.GradeLevel" /></div>
                            <div class="col-md-6"><label class="form-label fw-semibold small">Subject</label><input name="Subject" class="form-control filter-control" value="@item.Subject" /></div>
                            <div class="col-md-6"><label class="form-label fw-semibold small">Schedule</label><input name="Schedule" class="form-control filter-control" value="@item.Schedule" /></div>
                            <div class="col-12"><label class="form-label fw-semibold small">Assigned teacher <span class="text-muted">(optional)</span></label><select name="TeacherId" class="form-select filter-control"><option value="">Leave unassigned</option>@foreach (var teacher in teachers){<option value="@teacher.TeacherId" selected="@(item.TeacherId == teacher.TeacherId ? "selected" : null)">@teacher.FirstName @teacher.LastName (@teacher.Username)</option>}</select></div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0"><button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-emerald rounded-pill px-4">Save Changes</button></div>
                </form>
            </div>
        </div>
    </div>
}
