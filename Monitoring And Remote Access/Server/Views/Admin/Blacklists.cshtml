@model IEnumerable<Server.Models.BlacklistItem>
@{
    ViewData["Title"] = "Blacklists";
    Layout = "_Layout";
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-ban fs-3"></i>
        </div>
        <div>
            <h2 class="page-title">Blacklist Directory</h2>
            <p class="text-muted mb-0 small">Enforce forbidden website domains and prohibited application executables</p>
        </div>
    </div>
</div>

<!-- Blacklist Items Card -->
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="metric-card d-flex justify-content-between align-items-center"><div><div class="metric-title">Total Items</div><div class="metric-value">@Model.Count()</div></div><div class="metric-icon-box"><i class="bi bi-shield-check fs-3" aria-hidden="true"></i></div></div></div>
    <div class="col-md-4"><div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center"><div><div class="metric-title">Active Items</div><div class="metric-value">@Model.Count(rule => rule.IsActive)</div></div><div class="metric-icon-box"><i class="bi bi-check-circle fs-3" aria-hidden="true"></i></div></div></div>
    <div class="col-md-4"><div class="metric-card d-flex justify-content-between align-items-center"><div><div class="metric-title">Inactive Items</div><div class="metric-value">@Model.Count(rule => !rule.IsActive)</div></div><div class="metric-icon-box"><i class="bi bi-pause-circle fs-3" aria-hidden="true"></i></div></div></div>
</div>

<div class="card crud-panel border-0 shadow-sm rounded-4 overflow-hidden mb-4" data-crud-list data-crud-label="blacklist items" data-crud-page-size="6">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Blacklisted Domains & Applications</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@Model.Count() Items</span>
    </div>
    <div class="crud-toolbar">
        <input type="search" class="form-control crud-search" data-crud-search aria-label="Search blacklist items" placeholder="Search blacklist item..." />
        <select class="form-select" data-crud-filter="status" aria-label="Filter blacklist items by status"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option></select>
        <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#createBlacklistModal"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Blacklist Item</button>
    </div>
    <div class="table-responsive">
        <table class="table custom-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Target Type</th>
                    <th>Forbidden Target (URL / App)</th>
                    <th>Reason / Category</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr data-crud-item data-status="@(b.IsActive ? "Active" : "Inactive")">
                        <td>
                            <span class="badge bg-danger rounded-pill px-3 py-1 font-monospace">@b.TargetType</span>
                        </td>
                        <td class="fw-bold font-monospace text-emerald-700">@b.Value</td>
                        <td>@(string.IsNullOrEmpty(b.Reason) ? "Policy violation" : b.Reason)</td>
                        <td>
                            <span class="badge @(b.IsActive ? "bg-success" : "bg-secondary") rounded-pill px-2 py-1">
                                @(b.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editBlacklist-@b.BlacklistItemId">Edit</button>
                            <form method="post" action="/Admin/DeleteBlacklist" class="form-inline-action" data-confirm="Remove this item from the blacklist?" data-confirm-title="Remove blacklist item" data-confirm-label="Remove">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@b.BlacklistItemId" />
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="bi bi-trash me-1"></i> Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center empty-state"><i class="bi bi-slash-circle empty-state-icon" aria-hidden="true"></i><span class="empty-state-message">No items in blacklist directory. Click "Add Blacklist Item" above.</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="crud-no-results" data-crud-empty hidden>No blacklist items match your search.</div>
    <div class="crud-footer" data-crud-pagination></div>
</div>

@foreach (var b in Model)
{
    <div class="modal fade" id="editBlacklist-@b.BlacklistItemId" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" action="/Admin/UpdateBlacklist">@Html.AntiForgeryToken()<input type="hidden" name="BlacklistItemId" value="@b.BlacklistItemId" /><div class="modal-header"><h5>Edit Blacklist Item</h5></div><div class="modal-body"><label for="blacklists-target-type-@b.BlacklistItemId">Target Type</label><select id="blacklists-target-type-@b.BlacklistItemId" name="TargetType" class="form-select mb-2"><option value="Application" selected="@(b.TargetType == "Application" ? "selected" : null)">Application</option><option value="Website" selected="@(b.TargetType == "Website" ? "selected" : null)">Website</option><option value="Domain" selected="@(b.TargetType == "Domain" ? "selected" : null)">Domain</option><option value="Process" selected="@(b.TargetType == "Process" ? "selected" : null)">Process</option></select><label for="blacklists-value-@b.BlacklistItemId">Value</label><input id="blacklists-value-@b.BlacklistItemId" name="Value" value="@b.Value" required maxlength="300" class="form-control mb-2" /><label for="blacklists-reason-@b.BlacklistItemId">Reason</label><input id="blacklists-reason-@b.BlacklistItemId" name="Reason" value="@b.Reason" maxlength="500" class="form-control mb-2" /><label><input type="checkbox" name="IsActive" value="true" @(b.IsActive ? "checked" : "") /> Active</label></div><div class="modal-footer"><button class="btn btn-emerald">Save</button></div></form></div></div></div>
}

<!-- Modal: Create Blacklist Item -->
<div class="modal fade" id="createBlacklistModal" tabindex="-1" aria-labelledby="createBlacklistModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white surface-brand">
                <h5 class="modal-title fw-bold" id="createBlacklistModalLabel">
                    <i class="bi bi-ban me-2"></i> Add Blacklist Item
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/CreateBlacklist">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="blacklists-target-type">Target Type</label>
                        <select id="blacklists-target-type" name="TargetType" class="form-select filter-control">
                            <option value="Website">Website Domain (URL)</option>
                            <option value="Application">Application Executable</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="blacklists-forbidden-url-app-name">Forbidden URL / App Name <span class="text-danger">*</span></label>
                        <input id="blacklists-forbidden-url-app-name" type="text" name="Value" class="form-control filter-control" required placeholder="e.g. facebook.com, roblox.exe" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="blacklists-reason-note">Reason / Note</label>
                        <input id="blacklists-reason-note" type="text" name="Reason" class="form-control filter-control" placeholder="e.g. Social media distraction during lab" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Blacklist Target</button>
                </div>
            </form>
        </div>
    </div>
</div>
