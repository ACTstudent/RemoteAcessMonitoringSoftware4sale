@model IEnumerable<Server.Models.Student>
@{
    ViewData["Title"] = "Student Management";
    Layout = "_Layout";
    var computers = ViewBag.Computers as List<Server.Models.Computer> ?? new List<Server.Models.Computer>();
    var classes = ViewBag.Classes as IEnumerable<Server.Models.Class> ?? Enumerable.Empty<Server.Models.Class>();

    var totalStudents = Model.Count();
    var mappedStudents = computers.Count(c => !string.IsNullOrEmpty(c.AssignedTo));
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-mortarboard-fill fs-3"></i>
        </div>
        <div>
            <h2 class="page-title">Student Management</h2>
            <p class="text-muted mb-0 small">Manage student profiles, LRNs, and workstation assignments</p>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap justify-content-end">
        @if (!User.IsInRole("Teacher"))
        {
            <a href="/Admin/Settings" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold">
                <i class="bi bi-shield-lock me-1"></i> Admin Accounts
            </a>
        }
        <button class="btn btn-emerald rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#createStudentModal">
            <i class="bi bi-person-plus-fill me-1"></i> Register Student
        </button>
        <button class="btn btn-outline-emerald rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#bulkStudentsModal">
            <i class="bi bi-people-fill me-1"></i> Bulk Import
        </button>
    </div>
</div>

<!-- Metric Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Enrolled Students</div>
                <div class="metric-value">@totalStudents</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-mortarboard-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Mapped Workstations</div>
                <div class="metric-value text-success">@mappedStudents</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-pc-display-horizontal fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Available Stations</div>
                <div class="metric-value text-muted">@(computers.Count - mappedStudents)</div>
            </div>
            <div class="metric-icon-box bg-light text-secondary">
                <i class="bi bi-display fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Student Roster Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="fw-bold mb-0 text-dark">Student Directory</h5>
        <div class="search-input-wrapper" style="width: 280px;">
            <input aria-label="Search student name, ID..." id="studentSearch" type="text" class="form-control filter-control search-input" placeholder="Search student name, ID..." />
            <i class="bi bi-search search-icon text-muted"></i>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table custom-table mb-0" id="studentTable">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Username</th>
                    <th>Account Status</th>
                    <th>Class Assignment</th>
                    <th>Assigned Workstation</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var assigned = computers.FirstOrDefault(c => c.AssignedTo == s.Id.ToString());
                    var isActive = string.IsNullOrWhiteSpace(s.Status) || string.Equals(s.Status, "Active", StringComparison.OrdinalIgnoreCase);
                    var isLocked = s.LockoutEndUtc.HasValue && s.LockoutEndUtc.Value > DateTime.UtcNow;
                    <tr>
                        <td class="fw-bold text-muted font-monospace">@s.StudentNumber</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar-circle" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="fw-bold text-dark">@s.FullName</span>
                            </div>
                        </td>
                        <td class="font-monospace text-emerald-700">@@@s.Username</td>
                        <td>
                            <span class="badge @(isActive ? "bg-success" : "bg-secondary") rounded-pill px-3 py-1">@(isActive ? "Active" : "Inactive")</span>
                            @if (isLocked)
                            {
                                <span class="badge bg-danger rounded-pill px-2 py-1 ms-1">Locked</span>
                            }
                        </td>
                        <td>
                            <form method="post" action="/Admin/AssignStudentToClass" class="student-class-form d-flex gap-2 align-items-center form-inline-action">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="studentId" value="@s.Id" />
                                <input type="hidden" name="moveStudent" value="false" />
                                <select aria-label="Class for @s.FullName" name="classId" class="form-select filter-control py-1 px-2" style="font-size: 0.85rem; min-width: 190px;" data-current-class="@(s.Class?.ClassName ?? "")" data-current-class-id="@(s.ClassId?.ToString() ?? "")">
                                    <option value="">-- Unassigned --</option>
                                    @foreach (var cls in classes)
                                    {
                                        <option value="@cls.ClassId" selected="@(s.ClassId == cls.ClassId ? "selected" : null)">@cls.ClassName@(cls.Teacher == null ? "" : $" · {cls.Teacher.FirstName} {cls.Teacher.LastName}")</option>
                                    }
                                </select>
                                <button class="btn btn-sm btn-outline-emerald rounded-pill px-3">Assign</button>
                            </form>
                        </td>
                        <td>
                            <form method="post" action="/Admin/AssignComputer" class="d-flex gap-2 align-items-center form-inline-action">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="studentId" value="@s.Id" />
                                <select aria-label="Workstation for @s.FullName" name="computerId" class="form-select filter-control py-1 px-2" style="font-size: 0.85rem; width: 180px;">
                                    <option value="">-- Unassigned --</option>
                                    @foreach (var c in computers.Where(c => c.AssignedTo == s.Id.ToString() || c.AssignedTo == null))
                                    {
                                        <option value="@c.ComputerId" selected="@(c.AssignedTo == s.Id.ToString())">@c.LaboratoryStation</option>
                                    }
                                </select>
                                <button class="btn btn-sm btn-outline-emerald rounded-pill px-3">Map</button>
                            </form>
                        </td>
                        <td>
                            <div class="d-flex justify-content-end gap-1 flex-wrap">
                                @if (isLocked || s.FailedLoginAttempts > 0)
                                {
                                    <form method="post" action="/Admin/UnlockAccount" class="form-inline-action">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="accountRole" value="Student" />
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <button class="btn btn-sm btn-outline-warning rounded-pill px-3"><i class="bi bi-unlock me-1"></i>Unlock</button>
                                    </form>
                                }
                                <form method="post" action="/Admin/SetAccountActive" class="form-inline-action" data-confirm="@(isActive ? "Deactivate" : "Activate") this student account across CAMS?" data-confirm-title="@(isActive ? "Deactivate" : "Activate") student" data-confirm-label="@(isActive ? "Deactivate" : "Activate")" data-confirm-variant="@(isActive ? "danger" : "success")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="accountRole" value="Student" />
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <input type="hidden" name="isActive" value="@((!isActive).ToString())" />
                                    <button class="btn btn-sm @(isActive ? "btn-outline-secondary" : "btn-outline-success") rounded-pill px-3">
                                        <i class="bi @(isActive ? "bi-person-dash" : "bi-person-check") me-1"></i>@(isActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                                <button type="button" class="btn btn-sm btn-outline-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editStudentModal-@s.Id">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </button>
                                <form method="post" action="/Admin/DeleteStudent" class="form-inline-action" data-confirm="Deactivate this student across CAMS while retaining historical records?" data-confirm-title="Deactivate student" data-confirm-label="Deactivate">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="bi bi-archive me-1"></i> Archive
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center empty-state"><i class="bi bi-mortarboard empty-state-icon" aria-hidden="true"></i><span class="empty-state-message">No student records registered yet.</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Bulk Import Students -->
<div class="modal fade" id="bulkStudentsModal" tabindex="-1" aria-labelledby="bulkStudentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white surface-brand">
                <h5 class="modal-title fw-bold" id="bulkStudentsModalLabel"><i class="bi bi-people-fill me-2"></i>Bulk Import Students</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/BulkCreateStudents">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <p class="text-muted small mb-2">Create profiles now and assign them to classes later. Every filled row needs a first name, last name, and a password of at least 8 characters. Student IDs and blank usernames are generated automatically.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>First</th><th>Last</th><th>Username <span class="text-muted">(optional)</span></th><th>Password</th></tr></thead>
                            <tbody id="adminStudentBulkRows">
                                <tr>
                                    <td><input aria-label="First name" name="bulkFirstNames" class="form-control form-control-sm filter-control" /></td>
                                    <td><input aria-label="Last name" name="bulkLastNames" class="form-control form-control-sm filter-control" /></td>
                                    <td><input aria-label="Username (optional)" name="bulkUserNames" class="form-control form-control-sm filter-control" /></td>
                                    <td><input aria-label="Password" name="bulkPasswords" type="password" minlength="8" class="form-control form-control-sm filter-control" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-outline-emerald rounded-pill px-4 mt-3" data-bulk-add="#adminStudentBulkRows"><i class="bi bi-plus-lg me-1"></i>Add more rows</button>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Create Profiles</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Create Student -->
<div class="modal fade" id="createStudentModal" tabindex="-1" aria-labelledby="createStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white surface-brand">
                <h5 class="modal-title fw-bold" id="createStudentModalLabel">
                    <i class="bi bi-person-plus me-2"></i> Register New Student
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/CreateStudent">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="students-student-id-lrn-number">Student ID / LRN Number <span class="text-danger">*</span></label>
                        <input id="students-student-id-lrn-number" type="text" name="StudentNumber" class="form-control filter-control" required placeholder="e.g. STU-2026-001" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="students-full-name">Full Name <span class="text-danger">*</span></label>
                        <input id="students-full-name" type="text" name="FullName" class="form-control filter-control" required placeholder="e.g. John Doe" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="students-username">Username <span class="text-danger">*</span></label>
                        <input id="students-username" type="text" name="Username" class="form-control filter-control" required placeholder="e.g. student1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="students-password">Password <span class="text-danger">*</span></label>
                        <input id="students-password" type="password" name="PasswordHash" class="form-control filter-control" required placeholder="••••••••" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Student</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modals: Edit Student -->
@foreach (var s in Model)
{
    <div class="modal fade" id="editStudentModal-@s.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 text-white surface-brand">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-2"></i> Edit Student - @s.FullName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="/Admin/UpdateStudent">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@s.Id" />
                    <div class="modal-body py-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="students-student-id-number-@s.Id">Student ID Number</label>
                            <input id="students-student-id-number-@s.Id" type="text" name="StudentNumber" class="form-control filter-control" value="@s.StudentNumber" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="students-full-name-@s.Id">Full Name</label>
                            <input id="students-full-name-@s.Id" type="text" name="FullName" class="form-control filter-control" value="@s.FullName" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="students-username-@s.Id">Username</label>
                            <input id="students-username-@s.Id" type="text" name="Username" class="form-control filter-control" value="@s.Username" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="students-new-password-leave-blank-to-keep-current-@s.Id">New Password <span class="text-muted font-normal">(Leave blank to keep current)</span></label>
                            <input id="students-new-password-leave-blank-to-keep-current-@s.Id" type="password" name="newPassword" class="form-control filter-control" placeholder="Optional new password" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<script>
    document.getElementById("studentSearch")?.addEventListener("input", function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll("#studentTable tbody tr").forEach(tr => {
            tr.style.display = tr.textContent.toLowerCase().includes(q) ? "" : "none";
        });
    });

    document.querySelectorAll(".student-class-form").forEach(function (form) {
        form.addEventListener("submit", async function (event) {
            const select = form.querySelector("select[name='classId']");
            const currentClass = select?.dataset.currentClass || "";
            const currentClassId = select?.dataset.currentClassId || "";
            const selectedClassId = select?.value || "";
            const selectedClass = select?.selectedOptions[0]?.textContent?.trim() || "";
            const moveField = form.querySelector("input[name='moveStudent']");
            if (!currentClass || !currentClassId || !selectedClassId || selectedClassId === currentClassId || moveField.value === "true") return;
            event.preventDefault();
            const confirmed = await window.camsConfirm({ title: "Move student", message: `Move this student from ${currentClass} to ${selectedClass}?`, confirmLabel: "Move student", variant: "warning" });
            if (!confirmed) return;
            moveField.value = "true";
            form.requestSubmit();
        });
    });
</script>
