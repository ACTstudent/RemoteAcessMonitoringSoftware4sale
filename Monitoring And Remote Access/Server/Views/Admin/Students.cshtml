@model IEnumerable<Server.Models.Student>
@{
    ViewData["Title"] = "Student Accounts";
    Layout = "_Layout";
}

<h4 class="fw-bold mb-4"><i class="bi bi-people"></i> Manage Student Accounts</h4>

<div class="card mb-4">
    <div class="card-header fw-bold">Add Student</div>
    <div class="card-body">
        <form method="post" action="/Admin/CreateStudent" class="row g-2">
            <div class="col-md-3"><input name="StudentNumber" class="form-control" placeholder="Student Number" required /></div>
            <div class="col-md-3"><input name="FullName" class="form-control" placeholder="Full Name" required /></div>
            <div class="col-md-3"><input name="Username" class="form-control" placeholder="Username" required /></div>
            <div class="col-md-3"><input name="PasswordHash" class="form-control" placeholder="Password" required /></div>
            <div class="col-md-3"><button class="btn btn-primary w-100">Add Student</button></div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header fw-bold">Student List</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>ID</th><th>Student No.</th><th>Name</th><th>Username</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <form method="post" action="/Admin/UpdateStudent">
                            <input type="hidden" name="Id" value="@s.Id" />
                            <td>@s.Id</td>
                            <td><input class="form-control form-control-sm" name="StudentNumber" value="@s.StudentNumber" /></td>
                            <td><input class="form-control form-control-sm" name="FullName" value="@s.FullName" /></td>
                            <td><input class="form-control form-control-sm" name="Username" value="@s.Username" /></td>
                            <td class="d-flex gap-1">
                                <button class="btn btn-sm btn-success">Save</button>
                        </form>
                                <form method="post" action="/Admin/DeleteStudent"><input type="hidden" name="id" value="@s.Id" /><button class="btn btn-sm btn-danger">Delete</button></form>
                            </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
