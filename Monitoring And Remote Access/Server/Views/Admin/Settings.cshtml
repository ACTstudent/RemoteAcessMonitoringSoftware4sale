@using Microsoft.AspNetCore.Http
@model Server.Models.PasswordChangeInput
@{
    ViewData["Title"] = "Account Security";
    Layout = "_Layout";
    var admins = ViewBag.Admins as IEnumerable<Server.Models.Admin> ?? Enumerable.Empty<Server.Models.Admin>();
    var currentAdminId = Context.Session.GetInt32("AdminId");
    var activeAdminCount = admins.Count(admin => admin.IsActive);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary"><i class="bi bi-shield-lock-fill fs-3"></i></div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark">Account Security</h2>
            <p class="text-muted mb-0 small">Manage your password and administrator account availability</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/Teachers" class="btn btn-outline-secondary rounded-pill px-3">Teacher Accounts</a>
        <a href="/Admin/Students" class="btn btn-outline-secondary rounded-pill px-3">Student Accounts</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0"><i class="bi bi-key me-2 text-emerald-700"></i>Change My Password</h5>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary(false, "Please correct the following:", new { @class = "alert alert-danger" })
                }
                <form method="post" action="/Admin/ChangePassword">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="adminCurrentPassword">Current Password</label>
                        <input id="adminCurrentPassword" type="password" name="CurrentPassword" class="form-control filter-control" autocomplete="current-password" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="adminNewPassword">New Password</label>
                        <input id="adminNewPassword" type="password" name="NewPassword" class="form-control filter-control" minlength="8" autocomplete="new-password" required />
                        <div class="form-text">Use at least 8 characters.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="adminConfirmPassword">Confirm New Password</label>
                        <input id="adminConfirmPassword" type="password" name="ConfirmPassword" class="form-control filter-control" minlength="8" autocomplete="new-password" required />
                    </div>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Change Password</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-person-gear me-2 text-emerald-700"></i>Administrator Accounts</h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success rounded-pill">@activeAdminCount active</span>
                    <button class="btn btn-emerald btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#createAdminModal"><i class="bi bi-person-plus me-1"></i>Add Administrator</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table custom-table mb-0">
                    <thead>
                        <tr>
                            <th>Administrator</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var admin in admins)
                        {
                            var isLocked = admin.LockoutEndUtc.HasValue && admin.LockoutEndUtc.Value > DateTime.UtcNow;
                            var isCurrent = currentAdminId == admin.Id;
                            var isLastActive = admin.IsActive && activeAdminCount <= 1;
                            <tr>
                                <td>
                                    <span class="fw-bold">@admin.FullName</span>
                                    @if (isCurrent)
                                    {
                                        <span class="badge bg-light text-dark ms-1">You</span>
                                    }
                                    <div class="small text-muted font-monospace">@@@admin.Username</div>
                                </td>
                                <td>
                                    <span class="badge @(admin.IsActive ? "bg-success" : "bg-secondary") rounded-pill">@(admin.IsActive ? "Active" : "Inactive")</span>
                                    @if (isLocked)
                                    {
                                        <span class="badge bg-danger rounded-pill ms-1">Locked</span>
                                        <div class="small text-muted mt-1">Until @admin.LockoutEndUtc.GetValueOrDefault().ToLocalTime().ToString("g")</div>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-end gap-1 flex-wrap">
                                        @if (isLocked || admin.FailedLoginAttempts > 0)
                                        {
                                            <form method="post" action="/Admin/UnlockAccount" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="accountRole" value="Admin" />
                                                <input type="hidden" name="id" value="@admin.Id" />
                                                <button class="btn btn-sm btn-outline-warning rounded-pill px-3"><i class="bi bi-unlock me-1"></i>Unlock</button>
                                            </form>
                                        }
                                        <form method="post" action="/Admin/SetAccountActive" style="margin:0;" data-confirm="@(admin.IsActive ? "Deactivate" : "Activate") this administrator account?" data-confirm-title="@(admin.IsActive ? "Deactivate" : "Activate") administrator" data-confirm-label="@(admin.IsActive ? "Deactivate" : "Activate")" data-confirm-variant="@(admin.IsActive ? "danger" : "success")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="accountRole" value="Admin" />
                                            <input type="hidden" name="id" value="@admin.Id" />
                                            <input type="hidden" name="isActive" value="@(!admin.IsActive)" />
                                            <button class="btn btn-sm @(admin.IsActive ? "btn-outline-secondary" : "btn-outline-success") rounded-pill px-3" disabled="@(isLastActive ? "disabled" : null)" title="@(isLastActive ? "The last active administrator cannot be deactivated." : null)">
                                                @(admin.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editAdminModal-@admin.Id"><i class="bi bi-pencil me-1"></i>Edit</button>
                                        <form method="post" action="/Admin/DeleteAdmin" style="margin:0;" data-confirm="Delete this administrator account? This action cannot be undone." data-confirm-title="Delete administrator" data-confirm-label="Delete">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@admin.Id" />
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" disabled="@(isCurrent ? "disabled" : null)" title="@(isCurrent ? "You cannot delete the account you are signed in as." : null)"><i class="bi bi-trash me-1"></i>Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createAdminModal" tabindex="-1" aria-labelledby="createAdminModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                <h5 class="modal-title fw-bold" id="createAdminModalLabel"><i class="bi bi-person-plus me-2"></i>Add Administrator</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/CreateAdmin">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" class="form-control filter-control" required placeholder="e.g. System Administrator" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Username <span class="text-danger">*</span></label>
                        <input type="text" name="Username" class="form-control filter-control" required placeholder="e.g. admin2" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Password <span class="text-danger">*</span></label>
                        <input type="password" name="PasswordHash" class="form-control filter-control" required placeholder="••••••••" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Administrator</button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var admin in admins)
{
    <div class="modal fade" id="editAdminModal-@admin.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Administrator - @admin.FullName</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="/Admin/UpdateAdmin">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@admin.Id" />
                    <div class="modal-body py-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Full Name</label>
                            <input type="text" name="FullName" class="form-control filter-control" value="@admin.FullName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Username</label>
                            <input type="text" name="Username" class="form-control filter-control" value="@admin.Username" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">New Password <span class="text-muted">(Leave blank to keep current)</span></label>
                            <input type="password" name="newPassword" class="form-control filter-control" placeholder="Optional new password" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
