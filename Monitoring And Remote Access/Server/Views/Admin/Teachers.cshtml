@model IEnumerable<Server.Models.Teacher>
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Teacher Management";
    Layout = "_Layout";

    var totalTeachers = Model.Count();
    var activeTeachers = Model.Count(t => t.Status == "Active");
    var inactiveTeachers = totalTeachers - activeTeachers;
    var actorTeacherId = Context.Session.GetInt32("TeacherId");
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-person-badge-fill fs-3"></i>
        </div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">Teacher Management</h2>
            <p class="text-muted mb-0 small">Manage faculty, advisers, and instructor accounts</p>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap justify-content-end">
        @if (!User.IsInRole("Teacher"))
        {
            <a href="/Admin/Settings" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold">
                <i class="bi bi-shield-lock me-1"></i> Admin Accounts
            </a>
        }
        <button class="btn btn-emerald rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#createTeacherModal">
            <i class="bi bi-person-plus-fill me-1"></i> Add Teacher
        </button>
    </div>
</div>

<!-- Metric Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Faculty</div>
                <div class="metric-value">@totalTeachers</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-person-badge-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Active Instructors</div>
                <div class="metric-value text-success">@activeTeachers</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-check-circle-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Inactive / On Leave</div>
                <div class="metric-value text-muted">@inactiveTeachers</div>
            </div>
            <div class="metric-icon-box bg-light text-secondary">
                <i class="bi bi-dash-circle-fill fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Teacher Directory Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Faculty Directory</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@totalTeachers Registered</span>
    </div>
    <div class="table-responsive">
        <table class="table custom-table mb-0">
            <thead>
                <tr>
                    <th>Teacher ID</th>
                    <th>Full Name</th>
                    <th>Username</th>
                    <th>Email Address</th>
                    <th>Contact No.</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    var isActive = string.IsNullOrWhiteSpace(t.Status) || string.Equals(t.Status, "Active", StringComparison.OrdinalIgnoreCase);
                    var isLocked = t.LockoutEndUtc.HasValue && t.LockoutEndUtc.Value > DateTime.UtcNow;
                    var isSelf = actorTeacherId.HasValue && actorTeacherId.Value == t.TeacherId;
                    <tr>
                        <td class="fw-bold text-muted">#T-@t.TeacherId.ToString("D3")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar-circle" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    @(!string.IsNullOrEmpty(t.FirstName) ? t.FirstName.Substring(0, 1) : "T")
                                </div>
                                <span class="fw-bold text-dark">@t.FirstName @t.LastName</span>
                            </div>
                        </td>
                        <td class="font-monospace text-emerald-700">@@@t.Username</td>
                        <td>@(string.IsNullOrEmpty(t.Email) ? "-" : t.Email)</td>
                        <td>@(string.IsNullOrEmpty(t.ContactNumber) ? "-" : t.ContactNumber)</td>
                        <td>
                            <span class="badge @(isActive ? "bg-success" : "bg-secondary") rounded-pill px-3 py-1">
                                @(isActive ? "Active" : "Inactive")
                            </span>
                            @if (isLocked)
                            {
                                <span class="badge bg-danger rounded-pill px-2 py-1 ms-1">Locked</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex justify-content-end gap-1 flex-wrap">
                                @if (isLocked || t.FailedLoginAttempts > 0)
                                {
                                    <form method="post" action="/Admin/UnlockAccount" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="accountRole" value="Teacher" />
                                        <input type="hidden" name="id" value="@t.TeacherId" />
                                        <button class="btn btn-sm btn-outline-warning rounded-pill px-3"><i class="bi bi-unlock me-1"></i>Unlock</button>
                                    </form>
                                }
                                @if (isSelf)
                                {
                                    <a href="@Url.Action("Settings", "Teacher")" class="btn btn-sm btn-outline-emerald rounded-pill px-3" title="Use your personal settings to edit your own account."><i class="bi bi-person-check me-1"></i>This is you</a>
                                }
                                else
                                {
                                    <form method="post" action="/Admin/SetAccountActive" style="margin:0;" data-confirm="@(isActive ? "Deactivate" : "Activate") this teacher account across CAMS?" data-confirm-title="@(isActive ? "Deactivate" : "Activate") teacher" data-confirm-label="@(isActive ? "Deactivate" : "Activate")" data-confirm-variant="@(isActive ? "danger" : "success")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="accountRole" value="Teacher" />
                                        <input type="hidden" name="id" value="@t.TeacherId" />
                                        <input type="hidden" name="isActive" value="@(!isActive)" />
                                        <button class="btn btn-sm @(isActive ? "btn-outline-secondary" : "btn-outline-success") rounded-pill px-3"><i class="bi @(isActive ? "bi-person-dash" : "bi-person-check") me-1"></i>@(isActive ? "Deactivate" : "Activate")</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editTeacherModal-@t.TeacherId"><i class="bi bi-pencil me-1"></i> Edit</button>
                                    <form method="post" action="/Admin/DeleteTeacher" style="margin: 0;" data-confirm="Deactivate this teacher across CAMS while retaining historical records?" data-confirm-title="Deactivate teacher" data-confirm-label="Deactivate">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.TeacherId" />
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="bi bi-archive me-1"></i> Archive</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No teacher accounts registered yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create Teacher -->
<div class="modal fade" id="createTeacherModal" tabindex="-1" aria-labelledby="createTeacherModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                <h5 class="modal-title fw-bold" id="createTeacherModalLabel">
                    <i class="bi bi-person-plus me-2"></i> Register New Teacher
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/CreateTeacher">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small" for="teachers-first-name">First Name <span class="text-danger">*</span></label>
                            <input id="teachers-first-name" type="text" name="FirstName" class="form-control filter-control" required placeholder="First Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small" for="teachers-last-name">Last Name <span class="text-danger">*</span></label>
                            <input id="teachers-last-name" type="text" name="LastName" class="form-control filter-control" required placeholder="Last Name" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="teachers-username">Username <span class="text-danger">*</span></label>
                        <input id="teachers-username" type="text" name="Username" class="form-control filter-control" required placeholder="Username" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="teachers-password">Password <span class="text-danger">*</span></label>
                        <input id="teachers-password" type="password" name="PasswordHash" class="form-control filter-control" required placeholder="••••••••" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small" for="teachers-email-address">Email Address</label>
                            <input id="teachers-email-address" type="email" name="Email" class="form-control filter-control" placeholder="teacher@pardo.edu.ph" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small" for="teachers-contact-number">Contact Number</label>
                            <input id="teachers-contact-number" type="text" name="ContactNumber" class="form-control filter-control" placeholder="0917XXXXXXX" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="teachers-account-status">Account Status</label>
                        <select id="teachers-account-status" name="Status" class="form-select filter-control">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modals: Edit Teacher -->
@foreach (var t in Model)
{
    if (actorTeacherId.HasValue && actorTeacherId.Value == t.TeacherId) { continue; }
    <div class="modal fade" id="editTeacherModal-@t.TeacherId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-2"></i> Edit Teacher - @t.FirstName @t.LastName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="/Admin/UpdateTeacher">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TeacherId" value="@t.TeacherId" />
                    <div class="modal-body py-4">
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small" for="teachers-first-name-@t.TeacherId">First Name</label>
                                <input id="teachers-first-name-@t.TeacherId" type="text" name="FirstName" class="form-control filter-control" value="@t.FirstName" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small" for="teachers-last-name-@t.TeacherId">Last Name</label>
                                <input id="teachers-last-name-@t.TeacherId" type="text" name="LastName" class="form-control filter-control" value="@t.LastName" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="teachers-username-@t.TeacherId">Username</label>
                            <input id="teachers-username-@t.TeacherId" type="text" name="Username" class="form-control filter-control" value="@t.Username" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="teachers-new-password-leave-blank-to-keep-current-@t.TeacherId">New Password <span class="text-muted font-normal">(Leave blank to keep current)</span></label>
                            <input id="teachers-new-password-leave-blank-to-keep-current-@t.TeacherId" type="password" name="newPassword" class="form-control filter-control" placeholder="Optional new password" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small" for="teachers-email-address-@t.TeacherId">Email Address</label>
                                <input id="teachers-email-address-@t.TeacherId" type="email" name="Email" class="form-control filter-control" value="@t.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small" for="teachers-contact-number-@t.TeacherId">Contact Number</label>
                                <input id="teachers-contact-number-@t.TeacherId" type="text" name="ContactNumber" class="form-control filter-control" value="@t.ContactNumber" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="teachers-status-@t.TeacherId">Status</label>
                            <select id="teachers-status-@t.TeacherId" name="Status" class="form-select filter-control">
                                <option value="Active" selected="@(t.Status == "Active")">Active</option>
                                <option value="Inactive" selected="@(t.Status == "Inactive")">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
