@model IEnumerable<Server.Models.Teacher>
@{
    ViewData["Title"] = "Teacher Accounts";
    Layout = "_Layout";
}

<h4 class="fw-bold mb-4"><i class="bi bi-person-badge"></i> Manage Teacher Accounts</h4>

<div class="card mb-4">
    <div class="card-header fw-bold">Add Teacher</div>
    <div class="card-body">
        <form method="post" action="/Admin/CreateTeacher" class="row g-2">
            <div class="col-md-3"><input name="FirstName" class="form-control" placeholder="First Name" required /></div>
            <div class="col-md-3"><input name="LastName" class="form-control" placeholder="Last Name" required /></div>
            <div class="col-md-3"><input name="Email" class="form-control" type="email" placeholder="Email" /></div>
            <div class="col-md-3"><input name="Username" class="form-control" placeholder="Username" required /></div>
            <div class="col-md-3"><input name="PasswordHash" class="form-control" placeholder="Password" required /></div>
            <div class="col-md-3"><input name="ContactNumber" class="form-control" placeholder="Contact Number" /></div>
            <div class="col-md-3">
                <select name="Status" class="form-select">
                    <option>Active</option>
                    <option>Inactive</option>
                </select>
            </div>
            <div class="col-md-3"><button class="btn btn-primary w-100">Add Teacher</button></div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header fw-bold">Teacher List</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>ID</th><th>Name</th><th>Username</th><th>Email</th><th>Contact</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var t in Model)
                {
                    var formId = "t-update-" + t.TeacherId;
                    <tr>
                        <td>@t.TeacherId</td>
                        <td>
                            <input class="form-control form-control-sm mb-1" form="@formId" name="FirstName" value="@t.FirstName" />
                            <input class="form-control form-control-sm" form="@formId" name="LastName" value="@t.LastName" />
                        </td>
                        <td><input class="form-control form-control-sm" form="@formId" name="Username" value="@t.Username" /></td>
                        <td><input class="form-control form-control-sm" form="@formId" name="Email" value="@t.Email" /></td>
                        <td><input class="form-control form-control-sm" form="@formId" name="ContactNumber" value="@t.ContactNumber" /></td>
                        <td>
                            <select name="Status" form="@formId" class="form-select form-select-sm">
                                <option value="Active" selected="@(t.Status == "Active")">Active</option>
                                <option value="Inactive" selected="@(t.Status == "Inactive")">Inactive</option>
                            </select>
                        </td>
                        <td class="d-flex gap-1">
                            <button form="@formId" class="btn btn-sm btn-success">Save</button>
                            <form method="post" action="/Admin/DeleteTeacher">
                                <input type="hidden" name="id" value="@t.TeacherId" />
                                <button class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@foreach (var t in Model)
{
    <form id="t-update-@t.TeacherId" method="post" action="/Admin/UpdateTeacher">
        <input type="hidden" name="TeacherId" value="@t.TeacherId" />
    </form>
}
