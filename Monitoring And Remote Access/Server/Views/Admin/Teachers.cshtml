@model IEnumerable<Server.Models.Teacher>
@{
    ViewData["Title"] = "Teacher Management";
    Layout = "_Layout";

    var totalTeachers = Model.Count();
    var activeTeachers = Model.Count(t => t.Status == "Active");
    var inactiveTeachers = totalTeachers - activeTeachers;
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-person-badge-fill fs-3"></i>
        </div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">Teacher Management</h2>
            <p class="text-muted mb-0 small">Manage faculty, advisers, and instructor accounts</p>
        </div>
    </div>
    <button class="btn btn-emerald rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#createTeacherModal">
        <i class="bi bi-person-plus-fill me-1"></i> Add Teacher
    </button>
</div>

<!-- Metric Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Faculty</div>
                <div class="metric-value">@totalTeachers</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-person-badge-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Active Instructors</div>
                <div class="metric-value text-success">@activeTeachers</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-check-circle-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Inactive / On Leave</div>
                <div class="metric-value text-muted">@inactiveTeachers</div>
            </div>
            <div class="metric-icon-box bg-light text-secondary">
                <i class="bi bi-dash-circle-fill fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Teacher Directory Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Faculty Directory</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@totalTeachers Registered</span>
    </div>
    <div class="table-responsive">
        <table class="table custom-table mb-0">
            <thead>
                <tr>
                    <th>Teacher ID</th>
                    <th>Full Name</th>
                    <th>Username</th>
                    <th>Email Address</th>
                    <th>Contact No.</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">#T-@t.TeacherId.ToString("D3")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar-circle" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    @(!string.IsNullOrEmpty(t.FirstName) ? t.FirstName.Substring(0, 1) : "T")
                                </div>
                                <span class="fw-bold text-dark">@t.FirstName @t.LastName</span>
                            </div>
                        </td>
                        <td class="font-monospace text-emerald-700">@@@t.Username</td>
                        <td>@(string.IsNullOrEmpty(t.Email) ? "-" : t.Email)</td>
                        <td>@(string.IsNullOrEmpty(t.ContactNumber) ? "-" : t.ContactNumber)</td>
                        <td>
                            <span class="badge @(t.Status == "Active" ? "bg-success" : "bg-secondary") rounded-pill px-3 py-1">
                                @t.Status
                            </span>
                        </td>
                        <td>
                            <div class="d-flex justify-content-end gap-1">
                                <button type="button" class="btn btn-sm btn-outline-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editTeacherModal-@t.TeacherId">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </button>
                                <form method="post" action="/Admin/DeleteTeacher" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this teacher account?');">
                                    <input type="hidden" name="id" value="@t.TeacherId" />
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No teacher accounts registered yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create Teacher -->
<div class="modal fade" id="createTeacherModal" tabindex="-1" aria-labelledby="createTeacherModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                <h5 class="modal-title fw-bold" id="createTeacherModalLabel">
                    <i class="bi bi-person-plus me-2"></i> Register New Teacher
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/CreateTeacher">
                <div class="modal-body py-4">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small">First Name <span class="text-danger">*</span></label>
                            <input type="text" name="FirstName" class="form-control filter-control" required placeholder="First Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small">Last Name <span class="text-danger">*</span></label>
                            <input type="text" name="LastName" class="form-control filter-control" required placeholder="Last Name" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Username <span class="text-danger">*</span></label>
                        <input type="text" name="Username" class="form-control filter-control" required placeholder="Username" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Password <span class="text-danger">*</span></label>
                        <input type="password" name="PasswordHash" class="form-control filter-control" required placeholder="••••••••" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small">Email Address</label>
                            <input type="email" name="Email" class="form-control filter-control" placeholder="teacher@pardo.edu.ph" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small">Contact Number</label>
                            <input type="text" name="ContactNumber" class="form-control filter-control" placeholder="0917XXXXXXX" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Account Status</label>
                        <select name="Status" class="form-select filter-control">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modals: Edit Teacher -->
@foreach (var t in Model)
{
    <div class="modal fade" id="editTeacherModal-@t.TeacherId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-2"></i> Edit Teacher - @t.FirstName @t.LastName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="/Admin/UpdateTeacher">
                    <input type="hidden" name="TeacherId" value="@t.TeacherId" />
                    <div class="modal-body py-4">
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small">First Name</label>
                                <input type="text" name="FirstName" class="form-control filter-control" value="@t.FirstName" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small">Last Name</label>
                                <input type="text" name="LastName" class="form-control filter-control" value="@t.LastName" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Username</label>
                            <input type="text" name="Username" class="form-control filter-control" value="@t.Username" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">New Password <span class="text-muted font-normal">(Leave blank to keep current)</span></label>
                            <input type="password" name="newPassword" class="form-control filter-control" placeholder="Optional new password" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small">Email Address</label>
                                <input type="email" name="Email" class="form-control filter-control" value="@t.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small">Contact Number</label>
                                <input type="text" name="ContactNumber" class="form-control filter-control" value="@t.ContactNumber" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Status</label>
                            <select name="Status" class="form-select filter-control">
                                <option value="Active" selected="@(t.Status == "Active")">Active</option>
                                <option value="Inactive" selected="@(t.Status == "Inactive")">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
