@{
    ViewData["Title"] = "LAN Status";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary"><i class="bi bi-router-fill fs-3"></i></div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark">LAN Operational Status</h2>
            <p class="text-muted mb-0 small">Detected, read-only server information for deployment diagnostics</p>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-broadcast me-1"></i>Discovery service enabled</span>
        <a class="btn btn-success btn-sm rounded-pill px-3" href="@Url.Action("Index", "AdminDeployment")"><i class="bi bi-box-arrow-up-right me-1"></i>Deployment Hub</a>
    </div>
</div>

<div class="alert alert-info border-0 rounded-4 shadow-sm">
    CAMS does not configure DHCP, DNS, gateways, network adapters, or runtime server binding from this page. Configure those through the operating system and deployment settings.
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <h5 class="fw-bold mb-4"><i class="bi bi-activity me-2 text-emerald-700"></i>Detected Request Path</h5>
    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Current server endpoint</dt>
        <dd class="col-sm-8 font-monospace">@ViewBag.DetectedEndpoint</dd>
        <dt class="col-sm-4 text-muted">SignalR endpoint</dt>
        <dd class="col-sm-8 font-monospace">@ViewBag.RemoteMonitoringEndpoint</dd>
        <dt class="col-sm-4 text-muted">Client discovery</dt>
        <dd class="col-sm-8">The hosted discovery service advertises active IPv4 LAN interfaces on UDP port 5001.</dd>
        <dt class="col-sm-4 text-muted">Scope</dt>
        <dd class="col-sm-8 mb-0">Status only. No network settings are changed here.</dd>
    </dl>
</div>
