@model Server.Models.LanConfiguration
@{
    ViewData["Title"] = "LAN Configuration";
    Layout = "_Layout";
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-router-fill fs-3"></i>
        </div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">LAN Network Configuration</h2>
            <p class="text-muted mb-0 small">UDP auto-discovery ports, server IP binding, and laboratory network settings</p>
        </div>
    </div>
    <span class="badge bg-success rounded-pill px-3 py-2 fs-6">
        <i class="bi bi-wifi me-1"></i> UDP Broadcast Enabled
    </span>
</div>

<!-- LAN Settings Form Card -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <h5 class="fw-bold mb-4 text-dark">
        <i class="bi bi-hdd-network me-2 text-emerald-700"></i> Server & Subnet Parameters
    </h5>
    <form method="post" action="/Admin/SaveLanConfig" class="row g-3">
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted small">Server IP Address</label>
            <input name="ServerAddress" class="form-control filter-control" value="@Model.ServerAddress" placeholder="e.g. 192.168.1.100" />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted small">Server Port</label>
            <input name="ServerPort" type="number" class="form-control filter-control" value="@Model.ServerPort" placeholder="5000" />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted small">Default Gateway</label>
            <input name="Gateway" class="form-control filter-control" value="@Model.Gateway" placeholder="e.g. 192.168.1.1" />
        </div>

        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted small">DHCP Range Start</label>
            <input name="DhcpRangeStart" class="form-control filter-control" value="@Model.DhcpRangeStart" placeholder="192.168.1.10" />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted small">DHCP Range End</label>
            <input name="DhcpRangeEnd" class="form-control filter-control" value="@Model.DhcpRangeEnd" placeholder="192.168.1.200" />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted small">DNS Server</label>
            <input name="DnsServer" class="form-control filter-control" value="@Model.DnsServer" placeholder="8.8.8.8" />
        </div>

        <div class="col-12 mt-3">
            <div class="form-check">
                <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="chkActive" checked="@Model.IsActive" />
                <label class="form-check-label fw-semibold text-dark small" for="chkActive">
                    Enable UDP Auto-Discovery & Active Network Binding
                </label>
            </div>
        </div>

        <div class="col-12 mt-4">
            <button class="btn btn-emerald rounded-pill px-4 py-2.5 text-white fw-bold shadow-sm">
                <i class="bi bi-save me-1"></i> Save Network Configuration
            </button>
        </div>
    </form>
</div>
