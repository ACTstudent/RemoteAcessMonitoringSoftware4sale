@model IEnumerable<Server.Models.Computer>
@{
    ViewData["Title"] = "Computer Profiles";
    Layout = "_Layout";

    var totalComputers = Model.Count();
    var availableComputers = Model.Count(c => c.Status == "Available");
    var inUseComputers = Model.Count(c => c.Status == "In Use");
    var maintenanceComputers = Model.Count(c => c.Status == "Maintenance");
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-pc-display fs-3"></i>
        </div>
        <div>
            <h2 class="page-title">Computer Profiles</h2>
            <p class="text-muted mb-0 small">Manage laboratory workstations, status, and unit mapping</p>
        </div>
    </div>
</div>

<!-- Metric Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Workstations</div>
                <div class="metric-value">@totalComputers</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-pc-display fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Available</div>
                <div class="metric-value text-success">@availableComputers</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-check-circle-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="metric-card metric-card-active d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">In Use</div>
                <div class="metric-value text-primary">@inUseComputers</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-person-workspace fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Maintenance</div>
                <div class="metric-value text-warning">@maintenanceComputers</div>
            </div>
            <div class="metric-icon-box bg-warning text-dark">
                <i class="bi bi-tools fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Computer Directory Table Card -->
<div class="card crud-panel border-0 shadow-sm rounded-4 overflow-hidden mb-4" data-crud-list data-crud-label="workstations" data-crud-page-size="6">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Laboratory Workstation Directory</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@totalComputers Units Registered</span>
    </div>
    <div class="crud-toolbar">
        <input type="search" class="form-control crud-search" data-crud-search aria-label="Search workstations" placeholder="Search workstation..." />
        <select class="form-select" data-crud-filter="status" aria-label="Filter workstations by status">
            <option value="">All statuses</option>
            @foreach (var status in new[] { "Available", "In Use", "Maintenance", "Archived" }.Concat(Model.Select(c => c.Status)).Distinct().OrderBy(status => status))
            {
                <option value="@status">@status</option>
            }
        </select>
        <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#createComputerModal"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Workstation</button>
    </div>
    <div class="table-responsive">
        <table class="table custom-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Unit ID</th>
                    <th>Station Name</th>
                    <th>Status</th>
                    <th>Assigned Student ID</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr data-crud-item data-status="@c.Status">
                        <td class="fw-bold text-muted font-monospace">#PC-@c.ComputerId.ToString("D3")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-pc-display-horizontal fs-5 text-emerald-700"></i>
                                <span class="fw-bold text-dark fs-6">@c.LaboratoryStation</span>
                            </div>
                        </td>
                        <td>
                            @if (c.Status == "Available")
                            {
                                <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i> Available</span>
                            }
                            else if (c.Status == "In Use")
                            {
                                <span class="badge bg-primary rounded-pill px-3 py-1"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i> In Use</span>
                            }
                            else
                            {
                                <span class="badge @(c.Status == "Archived" ? "bg-secondary" : "bg-warning text-dark") rounded-pill px-3 py-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> @c.Status</span>
                            }
                        </td>
                        <td class="font-monospace">@(string.IsNullOrEmpty(c.AssignedTo) ? "-" : $"Student #{c.AssignedTo}")</td>
                        <td>
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-controller="Admin" asp-action="ComputerHistory" asp-route-id="@c.ComputerId" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="View global status history">
                                    <i class="bi bi-clock-history me-1"></i> History
                                </a>
                                @if (c.Status != "Archived")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editComputerModal-@c.ComputerId">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </button>
                                    <form method="post" action="/Admin/DeleteComputer" class="form-inline-action" data-confirm="Archive this workstation globally while retaining historical records?" data-confirm-title="Archive workstation" data-confirm-label="Archive">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.ComputerId" />
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="bi bi-archive me-1"></i> Archive
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center empty-state"><i class="bi bi-pc-display empty-state-icon" aria-hidden="true"></i><span class="empty-state-message">No computer profiles registered. Click "Add Workstation" above.</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="crud-no-results" data-crud-empty hidden>No workstations match your search.</div>
    <div class="crud-footer" data-crud-pagination></div>
</div>

<!-- Modal: Create Computer -->
<div class="modal fade" id="createComputerModal" tabindex="-1" aria-labelledby="createComputerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white surface-brand">
                <h5 class="modal-title fw-bold" id="createComputerModalLabel">
                    <i class="bi bi-pc-display me-2"></i> Register Workstation
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/CreateComputer">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="computers-laboratory-station-name">Laboratory Station Name <span class="text-danger">*</span></label>
                        <input id="computers-laboratory-station-name" type="text" name="LaboratoryStation" class="form-control filter-control" required placeholder="e.g. Unit 01 - Station A" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="computers-status">Status</label>
                        <select id="computers-status" name="Status" class="form-select filter-control">
                            <option value="Available">Available</option>
                            <option value="In Use">In Use</option>
                            <option value="Maintenance">Maintenance</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="computers-assigned-student-id-optional">Assigned Student ID (Optional)</label>
                        <input id="computers-assigned-student-id-optional" type="text" name="AssignedTo" class="form-control filter-control" placeholder="Optional Student ID" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Station</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modals: Edit Computer -->
@foreach (var c in Model)
{
    if (c.Status == "Archived") continue;
    <div class="modal fade" id="editComputerModal-@c.ComputerId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 text-white surface-brand">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-2"></i> Edit Workstation - @c.LaboratoryStation
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="/Admin/UpdateComputer">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ComputerId" value="@c.ComputerId" />
                    <div class="modal-body py-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="computers-laboratory-station-name-@c.ComputerId">Laboratory Station Name</label>
                            <input id="computers-laboratory-station-name-@c.ComputerId" type="text" name="LaboratoryStation" class="form-control filter-control" value="@c.LaboratoryStation" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="computers-status-@c.ComputerId">Status</label>
                            <select id="computers-status-@c.ComputerId" name="Status" class="form-select filter-control">
                                <option value="Available" selected="@(c.Status == "Available")">Available</option>
                                <option value="In Use" selected="@(c.Status == "In Use")">In Use</option>
                                <option value="Maintenance" selected="@(c.Status == "Maintenance")">Maintenance</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="computers-assigned-student-id-optional-@c.ComputerId">Assigned Student ID (Optional)</label>
                            <input id="computers-assigned-student-id-optional-@c.ComputerId" type="text" name="AssignedTo" class="form-control filter-control" value="@c.AssignedTo" placeholder="Optional Student ID" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
