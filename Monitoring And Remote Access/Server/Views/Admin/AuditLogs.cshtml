@model IEnumerable<Server.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Trail";
    ViewData["CrudPage"] = true;
    Layout = "_Layout";

    // One row per user, their events folded inside. A flat event list repeats the
    // role and the user id on every line, so a busy day pushes the thing an
    // administrator is actually looking for off the page.
    var actors = Model
        .GroupBy(entry => new { entry.UserType, entry.UserId })
        .Select(group => new
        {
            group.Key.UserType,
            group.Key.UserId,
            Events = group.OrderByDescending(entry => entry.Timestamp).ToList()
        })
        .OrderByDescending(actor => actor.Events[0].Timestamp)
        .ToList();
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-journal-text fs-3"></i>
        </div>
        <div>
            <h2 class="page-title">System Audit Trail</h2>
            <p class="text-muted mb-0 small">Security event tracking, administrative actions, and user login history</p>
        </div>
    </div>
    <a href="/Admin/ExportAuditCsv" class="btn btn-emerald rounded-pill px-4 py-2 fw-semibold text-white shadow-sm">
        <i class="bi bi-download me-1"></i> Export Audit CSV
    </a>
</div>

<!-- Audit Logs Table Card -->
<div class="card crud-panel border-0 shadow-sm rounded-4 overflow-hidden mb-4" data-crud-list data-crud-label="users" data-crud-page-size="15">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Audit Event Log</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@actors.Count Users &middot; @Model.Count() Events</span>
    </div>
    <div class="table-responsive">
        <table class="table custom-table align-middle mb-0 log-group-table">
            <thead>
                <tr>
                    <th scope="col" class="log-group-toggle-cell"><span class="visually-hidden">Expand</span></th>
                    <th scope="col">User Role</th>
                    <th scope="col">User ID</th>
                    <th scope="col">Events</th>
                    <th scope="col">Last Activity</th>
                    <th scope="col">Most Recent Action</th>
                    <th scope="col">Last IP Address</th>
                </tr>
            </thead>
            <tbody>
                @{ var actorIndex = 0; }
                @foreach (var actor in actors)
                {
                    actorIndex++;
                    var panelId = $"audit-actor-{actor.UserType}-{actor.UserId}-{actorIndex}";
                    var latest = actor.Events[0];
                    // UserId is nullable: system events have no account behind them,
                    // and "#" on its own reads like a value that failed to load.
                    var actorId = actor.UserId.HasValue ? $"#{actor.UserId}" : "—";
                    var actorName = actor.UserId.HasValue ? $"{actor.UserType} #{actor.UserId}" : $"{actor.UserType} events";
                    // Every action and detail the user has, so searching still reaches
                    // the events that are currently folded away.
                    var searchText = $"{actor.UserType} {actor.UserId} " +
                        string.Join(' ', actor.Events.Select(entry => $"{entry.Action} {entry.Details} {entry.IpAddress}"));

                    <tr data-crud-item data-log-group data-crud-search-text="@searchText">
                        <td class="log-group-toggle-cell">
                            <button type="button" class="log-group-toggle" aria-expanded="false" aria-controls="@panelId">
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                <span class="visually-hidden">Show the @actor.Events.Count audit events for @actorName</span>
                            </button>
                        </td>
                        <td>
                            <span class="badge @(actor.UserType == "Admin" ? "bg-dark" : "bg-success") rounded-pill px-3 py-1 font-monospace">
                                @actor.UserType
                            </span>
                        </td>
                        <td class="font-monospace fw-bold">@actorId</td>
                        <td><span class="badge bg-light text-dark font-monospace">@actor.Events.Count</span></td>
                        <td class="font-monospace text-muted">@latest.Timestamp.ToDisplayLocal().ToString("MMM dd, yyyy HH:mm:ss")</td>
                        <td class="fw-bold text-dark">@latest.Action</td>
                        <td class="font-monospace text-emerald-700">@(string.IsNullOrEmpty(latest.IpAddress) ? "127.0.0.1" : latest.IpAddress)</td>
                    </tr>
                    <tr class="log-group-detail" id="@panelId" data-log-detail hidden>
                        <td colspan="7">
                            <div class="log-group-events">
                                <table class="table table-sm custom-table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Timestamp</th>
                                            <th scope="col">Action</th>
                                            <th scope="col">Details</th>
                                            <th scope="col">IP Address</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entry in actor.Events)
                                        {
                                            <tr>
                                                <td class="font-monospace text-muted">@entry.Timestamp.ToDisplayLocal().ToString("MMM dd, yyyy HH:mm:ss")</td>
                                                <td class="fw-bold text-dark">@entry.Action</td>
                                                <td>@entry.Details</td>
                                                <td class="font-monospace text-emerald-700">@(string.IsNullOrEmpty(entry.IpAddress) ? "127.0.0.1" : entry.IpAddress)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                }
                @if (!actors.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center empty-state"><i class="bi bi-journal-text empty-state-icon" aria-hidden="true"></i><span class="empty-state-message">No audit trail records logged yet.</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="crud-no-results" data-crud-empty hidden>No audit trail records logged yet.</div>
    <div class="crud-footer" data-crud-pagination></div>
</div>

@section Scripts {
    <script src="~/js/log-groups.js" asp-append-version="true"></script>
}
