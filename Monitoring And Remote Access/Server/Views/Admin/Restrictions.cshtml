@model IEnumerable<Server.Models.RestrictionRule>
@{
    ViewData["Title"] = "Restriction Rules";
    Layout = "_Layout";
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-slash-circle-fill fs-3"></i>
        </div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">Whitelist & Blacklist Security Policies</h2>
            <p class="text-muted mb-0 small">Enforce application & website domain rules across all student workstations</p>
        </div>
    </div>
    <button class="btn btn-emerald rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#createRuleModal">
        <i class="bi bi-plus-circle-fill me-1"></i> Add Restriction Rule
    </button>
</div>

<!-- Rule Directory Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Active Security Policies</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@Model.Count() Rules</span>
    </div>
    <div class="table-responsive">
        <table class="table custom-table mb-0">
            <thead>
                <tr>
                    <th>Rule Type</th>
                    <th>Action Mode</th>
                    <th>Target (App / URL)</th>
                    <th>Description</th>
                    <th>Global</th>
                    <th>Active</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <span class="badge bg-dark rounded-pill px-3 py-1 font-monospace">@r.RuleType</span>
                        </td>
                        <td>
                            @if (r.Mode == "Allow")
                            {
                                <span class="badge bg-success rounded-pill px-3 py-1">Allow (Whitelist)</span>
                            }
                            else
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-1">Block (Blacklist)</span>
                            }
                        </td>
                        <td class="fw-bold font-monospace text-emerald-700">@r.Target</td>
                        <td>@r.Description</td>
                        <td>@(r.IsGlobal ? "Yes" : "No")</td>
                        <td>
                            <span class="badge @(r.IsActive ? "bg-success" : "bg-secondary") rounded-pill px-2 py-1">
                                @(r.IsActive ? "Enabled" : "Disabled")
                            </span>
                        </td>
                        <td class="text-end">
                            <form method="post" action="/Admin/DeleteRestriction" style="margin:0;" onsubmit="return confirm('Delete this security rule?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.RestrictionRuleId" />
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No security rules configured. Click "Add Restriction Rule" above.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create Rule -->
<div class="modal fade" id="createRuleModal" tabindex="-1" aria-labelledby="createRuleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                <h5 class="modal-title fw-bold" id="createRuleModalLabel">
                    <i class="bi bi-shield-plus me-2"></i> Add Restriction Rule
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/CreateRestriction">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small">Rule Type</label>
                            <select name="RuleType" class="form-select filter-control">
                                <option value="Application">Application (.exe)</option>
                                <option value="Website">Website Domain (URL)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small">Action Mode</label>
                            <select name="Mode" class="form-select filter-control">
                                <option value="Block" selected>Block (Blacklist)</option>
                                <option value="Allow">Allow (Whitelist)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Target Name / Domain <span class="text-danger">*</span></label>
                        <input type="text" name="Target" class="form-control filter-control" required placeholder="e.g. chrome.exe, facebook.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Description</label>
                        <input type="text" name="Description" class="form-control filter-control" placeholder="e.g. Block unauthorized gaming app" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Security Rule</button>
                </div>
            </form>
        </div>
    </div>
</div>
