@model Server.Models.PolicyManagementViewModel
@{
    ViewData["Title"] = "Restriction Rules";
    Layout = "_Layout";
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-slash-circle-fill fs-3"></i>
        </div>
        <div>
            <h2 class="page-title">Whitelist & Blacklist Security Policies</h2>
            <p class="text-muted mb-0 small">Enforce application & website domain rules across all student workstations</p>
        </div>
    </div>
</div>
<div class="alert alert-info">Allow rules are the whitelist. More-specific allow rules override broader matching blocks.</div>

@foreach (var categoryType in new[] { "Application", "Website" })
{
    var isApplication = categoryType == "Application";
    <div class="modal fade" id="create-@categoryType" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post" action="/Admin/Create@(categoryType)Category">@Html.AntiForgeryToken()<div class="modal-header"><h5>Add @categoryType Category</h5></div><div class="modal-body"><label for="restrictions-name-@categoryType">Name</label><input id="restrictions-name-@categoryType" name="Name" required maxlength="100" class="form-control mb-2" /><label for="restrictions-application-pattern-domain-pattern-@categoryType">@(isApplication ? "Application pattern" : "Domain pattern")</label><input id="restrictions-application-pattern-domain-pattern-@categoryType" name="@(isApplication ? "Pattern" : "DomainPattern")" required maxlength="300" class="form-control mb-2" /><label for="restrictions-mode-@categoryType">Mode</label><select id="restrictions-mode-@categoryType" name="Mode" class="form-select mb-2"><option>Block</option><option>Allow</option></select><label for="restrictions-description-@categoryType">Description</label><input id="restrictions-description-@categoryType" name="Description" maxlength="500" class="form-control mb-2" /><label><input type="checkbox" name="IsActive" value="true" checked /> Active</label></div><div class="modal-footer"><button class="btn btn-emerald">Save</button></div></form></div></div></div>
}

@foreach (var raw in Model.ApplicationCategories.Cast<object>().Concat(Model.WebsiteCategories.Cast<object>()))
{
    var app = raw as Server.Models.ApplicationCategory; var web = raw as Server.Models.WebsiteCategory;
    var isApplication = app != null; var categoryType = isApplication ? "Application" : "Website"; var id = app?.ApplicationCategoryId ?? web!.WebsiteCategoryId; var name = app?.Name ?? web!.Name; var pattern = app?.Pattern ?? web!.DomainPattern; var description = app?.Description ?? web!.Description; var mode = app?.Mode ?? web!.Mode; var active = app?.IsActive ?? web!.IsActive;
    <div class="modal fade" id="edit-@categoryType-@id" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post" action="/Admin/Update@(categoryType)Category">@Html.AntiForgeryToken()<input type="hidden" name="@(isApplication ? "ApplicationCategoryId" : "WebsiteCategoryId")" value="@id" /><div class="modal-header"><h5>Edit @categoryType Category</h5></div><div class="modal-body"><label>Name</label><input aria-label="Name" name="Name" value="@name" required maxlength="100" class="form-control mb-2" /><label>@(isApplication ? "Application pattern" : "Domain pattern")</label><input name="@(isApplication ? "Pattern" : "DomainPattern")" value="@pattern" required maxlength="300" class="form-control mb-2" /><label>Mode</label><select aria-label="Mode" name="Mode" class="form-select mb-2"><option value="Block" selected="@(mode == "Block" ? "selected" : null)">Block</option><option value="Allow" selected="@(mode == "Allow" ? "selected" : null)">Allow</option></select><label>Description</label><input aria-label="Description" name="Description" value="@description" maxlength="500" class="form-control mb-2" /><label><input type="checkbox" name="IsActive" value="true" @(active ? "checked" : "") /> Active</label></div><div class="modal-footer"><button class="btn btn-emerald">Save</button></div></form></div></div></div>
}

<!-- Rule Directory Card -->
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="metric-card d-flex justify-content-between align-items-center"><div><div class="metric-title">Total Rules</div><div class="metric-value">@Model.Restrictions.Count</div></div><div class="metric-icon-box"><i class="bi bi-shield-check fs-3" aria-hidden="true"></i></div></div></div>
    <div class="col-md-4"><div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center"><div><div class="metric-title">Active Rules</div><div class="metric-value">@Model.Restrictions.Count(rule => rule.IsActive)</div></div><div class="metric-icon-box"><i class="bi bi-check-circle fs-3" aria-hidden="true"></i></div></div></div>
    <div class="col-md-4"><div class="metric-card d-flex justify-content-between align-items-center"><div><div class="metric-title">Inactive Rules</div><div class="metric-value">@Model.Restrictions.Count(rule => !rule.IsActive)</div></div><div class="metric-icon-box"><i class="bi bi-pause-circle fs-3" aria-hidden="true"></i></div></div></div>
</div>

<div class="card crud-panel border-0 shadow-sm rounded-4 overflow-hidden mb-4" data-crud-list data-crud-label="restriction rules" data-crud-page-size="6">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Security Policies</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@Model.Restrictions.Count Rules</span>
    </div>
    <div class="crud-toolbar">
        <input type="search" class="form-control crud-search" data-crud-search aria-label="Search restriction rules" placeholder="Search restriction rule..." />
        <select class="form-select" data-crud-filter="status" aria-label="Filter restriction rules by status"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option></select>
        <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#createRuleModal"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Restriction Rule</button>
    </div>
    <div class="table-responsive">
        <table class="table custom-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Rule Type</th>
                    <th>Action Mode</th>
                    <th>Target (App / URL)</th>
                    <th>Description</th>
                    <th>Global</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Restrictions)
                {
                    <tr data-crud-item data-status="@(r.IsActive ? "Active" : "Inactive")">
                        <td>
                            <span class="badge bg-dark rounded-pill px-3 py-1 font-monospace">@r.RuleType</span>
                        </td>
                        <td>
                            @if (r.Mode == "Allow")
                            {
                                <span class="badge bg-success rounded-pill px-3 py-1">Allow (Whitelist)</span>
                            }
                            else
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-1">Block (Blacklist)</span>
                            }
                        </td>
                        <td class="fw-bold font-monospace text-emerald-700">@r.Target</td>
                        <td>@r.Description</td>
                        <td>@(r.IsGlobal ? "Yes" : "No")</td>
                        <td>
                            <span class="badge @(r.IsActive ? "bg-success" : "bg-secondary") rounded-pill px-2 py-1">
                                @(r.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editRule-@r.RestrictionRuleId">Edit</button>
                            <form method="post" action="/Admin/DeleteRestriction" class="form-inline-action" data-confirm="Delete this security rule?" data-confirm-title="Delete security rule" data-confirm-label="Delete">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.RestrictionRuleId" />
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Restrictions.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center empty-state"><i class="bi bi-shield-check empty-state-icon" aria-hidden="true"></i><span class="empty-state-message">No security rules configured. Click "Add Restriction Rule" above.</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="crud-no-results" data-crud-empty hidden>No restriction rules match your search.</div>
    <div class="crud-footer" data-crud-pagination></div>
</div>

<div class="row g-4 mb-4">
    @foreach (var categorySet in new[] { (Name: "Application", Items: Model.ApplicationCategories.Cast<object>()), (Name: "Website", Items: Model.WebsiteCategories.Cast<object>()) })
    {
        <div class="col-lg-6">
            <div class="card crud-panel border-0 shadow-sm rounded-4 overflow-hidden" data-crud-list data-crud-label="categories" data-crud-page-size="6">
                <div class="card-header bg-white py-3"><h5 class="fw-bold mb-0">@categorySet.Name Categories</h5></div>
                <div class="crud-toolbar">
                    <input type="search" class="form-control crud-search" data-crud-search aria-label="Search @categorySet.Name categories" placeholder="Search category..." />
                    <select class="form-select" data-crud-filter="status" aria-label="Filter @categorySet.Name categories by status"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option></select>
                    <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#create-@categorySet.Name"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Category</button>
                </div>
                <div class="table-responsive"><table class="table custom-table align-middle mb-0"><thead><tr><th>Name / Pattern</th><th>Mode</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
        @foreach (var raw in categorySet.Items)
        {
            var app = raw as Server.Models.ApplicationCategory; var web = raw as Server.Models.WebsiteCategory;
            var id = app?.ApplicationCategoryId ?? web?.WebsiteCategoryId ?? 0; var name = app?.Name ?? web?.Name ?? ""; var pattern = app?.Pattern ?? web?.DomainPattern ?? ""; var mode = app?.Mode ?? web?.Mode ?? "Block"; var active = app?.IsActive ?? web?.IsActive ?? false;
            <tr data-crud-item data-status="@(active ? "Active" : "Inactive")"><td><strong>@name</strong><br /><code>@pattern</code></td><td>@mode</td><td><span class="badge @(active ? "bg-success" : "bg-secondary")">@(active ? "Active" : "Inactive")</span></td><td class="text-end"><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#edit-@categorySet.Name-@id">Edit</button><form class="d-inline" method="post" action="/Admin/Delete@(categorySet.Name)Category" data-confirm="Delete this category?" data-confirm-title="Delete category" data-confirm-label="Delete">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@id" /><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>
        }
        @if (!categorySet.Items.Any()) { <tr><td colspan="4" class="text-center empty-state"><i class="bi bi-tags empty-state-icon" aria-hidden="true"></i><span class="empty-state-message">No categories configured.</span></td></tr> }
                </tbody></table></div>
                <div class="crud-no-results" data-crud-empty hidden>No categories match your search.</div>
                <div class="crud-footer" data-crud-pagination></div>
            </div>
        </div>
    }
</div>

@foreach (var r in Model.Restrictions)
{
    <div class="modal fade" id="editRule-@r.RestrictionRuleId" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post" action="/Admin/UpdateRestriction">@Html.AntiForgeryToken()<input type="hidden" name="RestrictionRuleId" value="@r.RestrictionRuleId" /><div class="modal-header"><h5>Edit Restriction Rule</h5></div><div class="modal-body"><label for="restrictions-type-@r.RestrictionRuleId">Type</label><select id="restrictions-type-@r.RestrictionRuleId" name="RuleType" class="form-select mb-2"><option value="Application" selected="@(r.RuleType == "Application" ? "selected" : null)">Application</option><option value="Website" selected="@(r.RuleType == "Website" ? "selected" : null)">Website</option></select><label for="restrictions-target-@r.RestrictionRuleId">Target</label><input id="restrictions-target-@r.RestrictionRuleId" name="Target" value="@r.Target" required maxlength="200" class="form-control mb-2" /><label for="restrictions-mode-@r.RestrictionRuleId">Mode</label><select id="restrictions-mode-@r.RestrictionRuleId" name="Mode" class="form-select mb-2"><option value="Block" selected="@(r.Mode == "Block" ? "selected" : null)">Block</option><option value="Allow" selected="@(r.Mode == "Allow" ? "selected" : null)">Allow</option></select><label for="restrictions-description-@r.RestrictionRuleId">Description</label><input id="restrictions-description-@r.RestrictionRuleId" name="Description" value="@r.Description" maxlength="500" class="form-control mb-2" /><label><input type="checkbox" name="IsGlobal" value="true" @(r.IsGlobal ? "checked" : "") /> Global</label> <label><input type="checkbox" name="IsActive" value="true" @(r.IsActive ? "checked" : "") /> Active</label></div><div class="modal-footer"><button class="btn btn-emerald">Save</button></div></form></div></div></div>
}

<!-- Modal: Create Rule -->
<div class="modal fade" id="createRuleModal" tabindex="-1" aria-labelledby="createRuleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white surface-brand">
                <h5 class="modal-title fw-bold" id="createRuleModalLabel">
                    <i class="bi bi-shield-plus me-2"></i> Add Restriction Rule
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/CreateRestriction">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small" for="restrictions-rule-type">Rule Type</label>
                            <select id="restrictions-rule-type" name="RuleType" class="form-select filter-control">
                                <option value="Application">Application (.exe)</option>
                                <option value="Website">Website Domain (URL)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small" for="restrictions-action-mode">Action Mode</label>
                            <select id="restrictions-action-mode" name="Mode" class="form-select filter-control">
                                <option value="Block" selected>Block (Blacklist)</option>
                                <option value="Allow">Allow (Whitelist)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="restrictions-target-name-domain">Target Name / Domain <span class="text-danger">*</span></label>
                        <input id="restrictions-target-name-domain" type="text" name="Target" class="form-control filter-control" required placeholder="e.g. chrome.exe, facebook.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="restrictions-description">Description</label>
                        <input id="restrictions-description" type="text" name="Description" class="form-control filter-control" placeholder="e.g. Block unauthorized gaming app" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Security Rule</button>
                </div>
            </form>
        </div>
    </div>
</div>
