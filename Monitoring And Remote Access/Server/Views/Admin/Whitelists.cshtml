@model IReadOnlyList<Server.Models.RestrictionRule>
@{
    ViewData["Title"] = "Whitelists";
    Layout = "_Layout";
}

<div class="page-header">
    <div class="page-header-main">
        <div class="icon-box-primary"><i class="bi bi-check-circle-fill fs-3"></i></div>
        <div>
            <h2>Whitelist Directory</h2>
            <p>School-wide allow rules take precedence over matching categories and blacklist entries.</p>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="metric-card d-flex justify-content-between align-items-center"><div><div class="metric-title">Total Rules</div><div class="metric-value">@Model.Count</div></div><div class="metric-icon-box"><i class="bi bi-shield-check fs-3" aria-hidden="true"></i></div></div></div>
    <div class="col-md-4"><div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center"><div><div class="metric-title">Active Rules</div><div class="metric-value">@Model.Count(rule => rule.IsActive)</div></div><div class="metric-icon-box"><i class="bi bi-check-circle fs-3" aria-hidden="true"></i></div></div></div>
    <div class="col-md-4"><div class="metric-card d-flex justify-content-between align-items-center"><div><div class="metric-title">Inactive Rules</div><div class="metric-value">@Model.Count(rule => !rule.IsActive)</div></div><div class="metric-icon-box"><i class="bi bi-pause-circle fs-3" aria-hidden="true"></i></div></div></div>
</div>

<div class="card crud-panel border-0 shadow-sm rounded-4 overflow-hidden" data-crud-list data-crud-label="whitelist rules" data-crud-page-size="6">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Allowed applications and websites</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@Model.Count Rules</span>
    </div>
    <div class="crud-toolbar">
        <input type="search" class="form-control crud-search" data-crud-search aria-label="Search whitelist rules" placeholder="Search whitelist rule..." />
        <select class="form-select" data-crud-filter="status" aria-label="Filter whitelist rules by status"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option></select>
        <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#createWhitelistModal"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add whitelist rule</button>
    </div>
    <div class="table-responsive">
        <table class="table custom-table align-middle mb-0">
            <thead><tr><th>Type</th><th>Target</th><th>Description</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (var rule in Model)
                {
                    <tr data-crud-item data-status="@(rule.IsActive ? "Active" : "Inactive")">
                        <td><span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3">@rule.RuleType</span></td>
                        <td><code>@rule.Target</code></td>
                        <td>@(string.IsNullOrWhiteSpace(rule.Description) ? "No description" : rule.Description)</td>
                        <td><span class="badge @(rule.IsActive ? "bg-success" : "bg-secondary") rounded-pill">@(rule.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editWhitelist-@rule.RestrictionRuleId">Edit</button>
                                <form method="post" action="/Admin/DeleteRestriction" data-confirm="Delete this global whitelist rule? This can affect every student workstation." data-confirm-title="Delete whitelist rule" data-confirm-label="Delete">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@rule.RestrictionRuleId" />
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center empty-state"><i class="bi bi-check-circle d-block fs-2 mb-2"></i>No whitelist rules configured.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="crud-no-results" data-crud-empty hidden>No whitelist rules match your search.</div>
    <div class="crud-footer" data-crud-pagination></div>
</div>

<div class="modal fade" id="createWhitelistModal" tabindex="-1" aria-labelledby="createWhitelistModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-header-themed">
                <h5 class="modal-title" id="createWhitelistModalLabel"><i class="bi bi-check-circle-fill me-2"></i>Add whitelist rule</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/CreateWhitelist">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IsGlobal" value="true" />
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label" for="whitelists-type">Type</label><select id="whitelists-type" name="RuleType" class="form-select"><option>Application</option><option>Website</option></select></div>
                    <div class="mb-3"><label class="form-label" for="whitelists-target">Target</label><input id="whitelists-target" name="Target" required maxlength="200" class="form-control" placeholder="e.g. learning.example.org or app.exe" /></div>
                    <div class="mb-3"><label class="form-label" for="whitelists-description">Description</label><textarea id="whitelists-description" name="Description" maxlength="500" class="form-control" rows="3" placeholder="Why this target is allowed"></textarea></div>
                    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="IsActive" value="true" id="createWhitelistActive" checked /><label class="form-check-label" for="createWhitelistActive">Rule is active</label></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-emerald rounded-pill px-4">Add rule</button></div>
            </form>
        </div>
    </div>
</div>

@foreach (var rule in Model)
{
    <div class="modal fade" id="editWhitelist-@rule.RestrictionRuleId" tabindex="-1" aria-labelledby="editWhitelistLabel-@rule.RestrictionRuleId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-themed"><h5 class="modal-title" id="editWhitelistLabel-@rule.RestrictionRuleId"><i class="bi bi-pencil-square me-2"></i>Edit whitelist rule</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <form method="post" action="/Admin/UpdateWhitelist">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="RestrictionRuleId" value="@rule.RestrictionRuleId" />
                    <input type="hidden" name="IsGlobal" value="true" />
                    <div class="modal-body">
                        <div class="mb-3"><label class="form-label" for="whitelists-type-@rule.RestrictionRuleId">Type</label><select id="whitelists-type-@rule.RestrictionRuleId" name="RuleType" class="form-select"><option selected="@(rule.RuleType == "Application" ? "selected" : null)">Application</option><option selected="@(rule.RuleType == "Website" ? "selected" : null)">Website</option></select></div>
                        <div class="mb-3"><label class="form-label" for="whitelists-target-@rule.RestrictionRuleId">Target</label><input id="whitelists-target-@rule.RestrictionRuleId" name="Target" value="@rule.Target" required maxlength="200" class="form-control" /></div>
                        <div class="mb-3"><label class="form-label" for="whitelists-description-@rule.RestrictionRuleId">Description</label><textarea id="whitelists-description-@rule.RestrictionRuleId" name="Description" maxlength="500" class="form-control" rows="3">@rule.Description</textarea></div>
                        <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editWhitelistActive-@rule.RestrictionRuleId" @(rule.IsActive ? "checked" : "") /><label class="form-check-label" for="editWhitelistActive-@rule.RestrictionRuleId">Rule is active</label></div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-emerald rounded-pill px-4">Save changes</button></div>
                </form>
            </div>
        </div>
    </div>
}
