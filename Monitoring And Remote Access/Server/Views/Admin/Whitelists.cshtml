@model IReadOnlyList<Server.Models.RestrictionRule>
@{ ViewData["Title"] = "Whitelists"; Layout = "_Layout"; }
<h2 class="fw-bold mb-3">Global Application and Website Whitelist</h2>
<p class="text-muted">These school-wide allow rules take precedence over matching categories and blacklist entries.</p>
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
<form method="post" action="/Admin/CreateWhitelist" class="row g-2 align-items-end">@Html.AntiForgeryToken()<div class="col-md-2"><label>Type</label><select name="RuleType" class="form-select"><option>Application</option><option>Website</option></select></div><div class="col-md-4"><label>Target</label><input name="Target" required maxlength="200" class="form-control" /></div><div class="col-md-4"><label>Description</label><input name="Description" maxlength="500" class="form-control" /></div><div class="col-md-1"><label><input type="checkbox" name="IsActive" value="true" checked /> Active</label><input type="hidden" name="IsGlobal" value="true" /></div><div class="col-md-1"><button class="btn btn-success">Add</button></div></form></div>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden"><table class="table custom-table mb-0"><thead><tr><th>Type</th><th>Target</th><th>Description</th><th>Active</th><th></th></tr></thead><tbody>
@foreach (var rule in Model) { <tr><td>@rule.RuleType</td><td><code>@rule.Target</code></td><td>@rule.Description</td><td>@(rule.IsActive ? "Enabled" : "Disabled")</td><td><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#edit-@rule.RestrictionRuleId">Edit</button><form method="post" action="/Admin/DeleteRestriction" class="d-inline" onsubmit="return confirm('Delete this global whitelist rule? This can affect every student workstation.');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@rule.RestrictionRuleId" /><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr><div class="modal fade" id="edit-@rule.RestrictionRuleId"><div class="modal-dialog"><div class="modal-content"><form method="post" action="/Admin/UpdateWhitelist">@Html.AntiForgeryToken()<input type="hidden" name="RestrictionRuleId" value="@rule.RestrictionRuleId" /><input type="hidden" name="IsGlobal" value="true" /><div class="modal-body"><label>Type</label><select name="RuleType" class="form-select"><option selected="@(rule.RuleType == "Application")">Application</option><option selected="@(rule.RuleType == "Website")">Website</option></select><label>Target</label><input name="Target" value="@rule.Target" required maxlength="200" class="form-control" /><label>Description</label><input name="Description" value="@rule.Description" maxlength="500" class="form-control" /><label><input type="checkbox" name="IsActive" value="true" @(rule.IsActive ? "checked" : "") /> Active</label></div><div class="modal-footer"><button class="btn btn-success">Save Global Rule</button></div></form></div></div></div> }
@if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">No whitelist rules configured.</td></tr> }
</tbody></table></div>
