@using Server.Services
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";

    var setupSteps = ViewBag.SetupSteps as IReadOnlyList<SetupStep>;
    var setupIncomplete = setupSteps is not null && !SetupChecklist.IsComplete(setupSteps);
    var nextStep = setupSteps is null ? null : SetupChecklist.NextStep(setupSteps);
    var lab = (Server.Models.LabSessionSummary)ViewBag.Lab;
}

@* FLOW-01. Shown only while something is outstanding: a running school does not
   need to be told every morning that its setup is finished. *@
@if (setupIncomplete)
{
    <section class="card border-0 shadow-sm rounded-4 mb-4 setup-checklist" aria-labelledby="setup-heading">
        <div class="card-body">
            <h2 class="h5 fw-bold mb-1" id="setup-heading">Finish setting up CAMS</h2>
            @{ var steps = setupSteps!; }
            <p class="text-muted small mb-3">
                @steps.Count(step => step.Done) of @steps.Count done.
                @if (nextStep is not null)
                {
                    <span>Next: <strong>@nextStep.Title</strong>.</span>
                }
            </p>

            <ol class="setup-step-list list-unstyled mb-0">
                @foreach (var step in steps)
                {
                    <li class="setup-step @(step.Done ? "is-done" : "is-outstanding")">
                        <i class="bi @(step.Done ? "bi-check-circle-fill" : "bi-circle") setup-step-icon"
                           aria-hidden="true"></i>
                        <div class="setup-step-body">
                            <span class="setup-step-title">@step.Title</span>
                            @if (!step.Done)
                            {
                                <span class="setup-step-why">@step.Why</span>
                                @if (step.Href is not null)
                                {
                                    <a class="setup-step-action" href="@step.Href">@step.NextAction</a>
                                }
                                else
                                {
                                    <span class="setup-step-action text-muted">@step.NextAction</span>
                                }
                            }
                        </div>
                        <span class="visually-hidden">@(step.Done ? "Done" : "Still to do")</span>
                    </li>
                }
            </ol>
        </div>
    </section>
}

<div class="mb-4">
    <div>
        <h2 class="page-title mb-1">Dashboard</h2>
        <p class="text-muted mb-0 small">School-wide overview of computer laboratories, users, and active sessions</p>
    </div>
</div>

<partial name="~/Views/Shared/_LabSessionBanner.cshtml" model="lab" />

@* data-lab-status: lab-status.js reloads the page when a teacher starts,
   pauses or ends the lab, so an administrator watching it sees the change. *@
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4" data-lab-status="@lab.Status" data-lab-elapsed="@lab.ElapsedSeconds">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-stopwatch me-2 text-emerald-700"></i>Lab-Wide Session Control</h5>
            <div class="text-muted small">
                @if (lab.IsOpen)
                {
                    <span>Students signed in: @lab.RunningStudents running, @lab.PausedStudents paused.</span>
                }
                else
                {
                    <span>No lab session is running. Students can sign in once a teacher starts one from Sessions.</span>
                }
                Pause freezes student PCs, Resume restores access, and End restarts connected student PCs.
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <form method="post" action="/Admin/PauseAllSessions" data-confirm-subject="All students &middot; All computers" data-confirm="Pause every active session? **Student PCs freeze behind a full-screen waiting message** until you resume." data-confirm-title="Pause all sessions" data-confirm-label="Pause PCs" data-confirm-variant="warning">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-warning rounded-pill px-3"><i class="bi bi-pause-fill me-1"></i>Pause all</button>
            </form>
            <form method="post" action="/Admin/ResumeAllSessions" data-confirm-subject="All students &middot; All computers" data-confirm="Resume all paused sessions and **restore student access to their computers**?" data-confirm-title="Resume paused sessions" data-confirm-label="Resume" data-confirm-variant="success">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-success rounded-pill px-3"><i class="bi bi-play-fill me-1"></i>Resume paused</button>
            </form>
            <form method="post" action="/Admin/EndAllSessions" data-confirm-subject="All students &middot; All computers" data-confirm="End all sessions and restart every connected student PC in 10 seconds? Open applications close and **unsaved work can be lost**. Ended sessions cannot be resumed." data-confirm-title="End sessions and restart PCs" data-confirm-label="End and restart PCs">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-danger rounded-pill px-3"><i class="bi bi-arrow-clockwise me-1"></i>End &amp; restart PCs</button>
            </form>
        </div>
    </div>
</div>

<!-- Metric Summary Cards -->
@* Every card carries a note line and fills its column, so the titles, values
   and icons line up - the Lab Session card needs its second line. That card is
   the teacher's; an administrator has three cards across the row. *@
@{
    var showLabCard = ViewBag.ShowLabSessionCard is true;
    var metricColumn = showLabCard ? "col-md-3 col-sm-6" : "col-md-4 col-sm-6";
}
<div class="row g-4 mb-4">
    <div class="@metricColumn">
        <div class="metric-card metric-card-emerald h-100 d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Students</div>
                <div class="metric-value">@ViewBag.StudentCount</div>
                <div class="metric-note">Removed students not counted</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-mortarboard-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="@metricColumn">
        <div class="metric-card metric-card-active h-100 d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Teachers</div>
                <div class="metric-value">@ViewBag.TeacherCount</div>
                <div class="metric-note">Every teacher account on record</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-person-badge-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="@metricColumn">
        <div class="metric-card metric-card-active h-100 d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Lab Computers</div>
                <div class="metric-value">@ViewBag.ComputerCount</div>
                <div class="metric-note">Registered lab computers</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-pc-display fs-3"></i>
            </div>
        </div>
    </div>
    @if (showLabCard)
    {
        <div class="@metricColumn">
            <div class="metric-card metric-card-emerald h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="metric-title">Lab Session</div>
                    <div class="metric-value @(lab.IsPaused ? "text-warning" : lab.IsOpen ? "text-success" : "text-muted")">@(lab.IsPaused ? "Paused" : lab.IsOpen ? "Running" : "None")</div>
                    <div class="metric-note">@(lab.IsOpen ? (lab.SignedInStudents == 1 ? "1 student signed in" : $"{lab.SignedInStudents} students signed in") : "No lab open")</div>
                </div>
                <div class="metric-icon-box">
                    <i class="bi bi-play-circle-fill fs-3"></i>
                </div>
            </div>
        </div>
    }
</div>

