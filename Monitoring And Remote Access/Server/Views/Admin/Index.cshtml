@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<h4 class="fw-bold mb-4"><i class="bi bi-grid"></i> Dashboard</h4>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Students</div>
                <div class="stat text-primary">@ViewBag.StudentCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Teachers</div>
                <div class="stat text-info">@ViewBag.TeacherCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Computers</div>
                <div class="stat text-warning">@ViewBag.ComputerCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Active Sessions</div>
                <div class="stat text-success">@ViewBag.ActiveSessions</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header fw-bold">Quick Actions</div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3"><a class="btn btn-outline-primary w-100" href="/Admin/Teachers">Manage Teacher Accounts</a></div>
            <div class="col-md-3"><a class="btn btn-outline-primary w-100" href="/Admin/Students">Manage Student Accounts</a></div>
            <div class="col-md-3"><a class="btn btn-outline-primary w-100" href="/Admin/Roles">Roles &amp; Permissions</a></div>
            <div class="col-md-3"><a class="btn btn-outline-primary w-100" href="/Admin/Restrictions">Restriction Rules</a></div>
            <div class="col-md-3"><a class="btn btn-outline-secondary w-100" href="/Admin/Blacklists">Website/App Blacklists</a></div>
            <div class="col-md-3"><a class="btn btn-outline-secondary w-100" href="/Admin/SessionRules">Session Rules</a></div>
            <div class="col-md-3"><a class="btn btn-outline-secondary w-100" href="/Admin/LanConfig">LAN Configuration</a></div>
            <div class="col-md-3"><a class="btn btn-outline-secondary w-100" href="/Admin/Reports">Generate Reports</a></div>
        </div>
    </div>
</div>
