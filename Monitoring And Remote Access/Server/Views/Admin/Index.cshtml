@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-extrabold mb-1 text-dark" style="letter-spacing: -0.5px;">Admin Dashboard</h2>
        <p class="text-muted mb-0 small">Overview of Pardo Elementary School Computer Laboratories & Users</p>
    </div>
    <div class="badge bg-success rounded-pill px-3 py-2 fs-6">
        <i class="bi bi-shield-check me-1"></i> System Online
    </div>
</div>

<!-- Metric Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Students</div>
                <div class="metric-value">@ViewBag.StudentCount</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-mortarboard-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="metric-card metric-card-active d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Faculty / Teachers</div>
                <div class="metric-value">@ViewBag.TeacherCount</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-person-badge-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="metric-card metric-card-active d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Lab Workstations</div>
                <div class="metric-value">@ViewBag.ComputerCount</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-pc-display fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Active Lab Sessions</div>
                <div class="metric-value text-success">@ViewBag.ActiveSessions</div>
            </div>
            <div class="metric-icon-box bg-success text-white">
                <i class="bi bi-play-circle-fill fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Quick Module Navigation Grid (pro Style) -->
<h5 class="fw-bold mb-3 text-dark">Management & Administration</h5>
<div class="row g-4">
    <div class="col-md-4 col-sm-6">
        <a href="/Admin/Classes" class="text-decoration-none">
            <div class="class-card h-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="icon-box-primary">
                        <i class="bi bi-folder-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-5">Class Management</div>
                        <div class="text-muted small">Advisory & Instructor classes</div>
                    </div>
                </div>
                <div class="btn btn-view-class w-100 py-2 fw-semibold">Open Classes</div>
            </div>
        </a>
    </div>

    <div class="col-md-4 col-sm-6">
        <a href="/Admin/Teachers" class="text-decoration-none">
            <div class="class-card h-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="icon-box-primary">
                        <i class="bi bi-person-badge-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-5">Teacher Management</div>
                        <div class="text-muted small">Manage faculty & staff accounts</div>
                    </div>
                </div>
                <div class="btn btn-view-class w-100 py-2 fw-semibold">Open Teachers</div>
            </div>
        </a>
    </div>

    <div class="col-md-4 col-sm-6">
        <a href="/Admin/Students" class="text-decoration-none">
            <div class="class-card h-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="icon-box-primary">
                        <i class="bi bi-mortarboard-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-5">Student Management</div>
                        <div class="text-muted small">Manage student records & IDs</div>
                    </div>
                </div>
                <div class="btn btn-view-class w-100 py-2 fw-semibold">Open Students</div>
            </div>
        </a>
    </div>

    <div class="col-md-4 col-sm-6">
        <a href="/Admin/Computers" class="text-decoration-none">
            <div class="class-card h-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="icon-box-primary">
                        <i class="bi bi-pc-display fs-3"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-5">Computer Profiles</div>
                        <div class="text-muted small">Manage lab workstation stations</div>
                    </div>
                </div>
                <div class="btn btn-view-class w-100 py-2 fw-semibold">Open Profiles</div>
            </div>
        </a>
    </div>

    <div class="col-md-4 col-sm-6">
        <a href="/Admin/Restrictions" class="text-decoration-none">
            <div class="class-card h-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="icon-box-primary">
                        <i class="bi bi-slash-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-5">Restriction Rules</div>
                        <div class="text-muted small">App & URL security policies</div>
                    </div>
                </div>
                <div class="btn btn-view-class w-100 py-2 fw-semibold">Open Restrictions</div>
            </div>
        </a>
    </div>

    <div class="col-md-4 col-sm-6">
        <a href="/Admin/Reports" class="text-decoration-none">
            <div class="class-card h-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="icon-box-primary">
                        <i class="bi bi-bar-chart-line-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-5">System Reports</div>
                        <div class="text-muted small">Lab usage & audit analytics</div>
                    </div>
                </div>
                <div class="btn btn-view-class w-100 py-2 fw-semibold">Generate Reports</div>
            </div>
        </a>
    </div>
</div>
