@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isTeacher = User.IsInRole("Teacher");
    var displayName = isTeacher
        ? ViewContext.HttpContext.Session.GetString("TeacherName") ?? "Teacher"
        : ViewContext.HttpContext.Session.GetString("AdminName") ?? "System Administrator";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CAMS @(isTeacher ? "Global Management" : "Admin") | Pardo Elementary School</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="app-shell">
    <div class="app-wrapper">
        <!-- Dark Emerald Sidebar -->
        <aside class="app-sidebar" id="appSidebar" aria-label="@(isTeacher ? "Teacher global management navigation" : "Administrator navigation")">
            <div class="sidebar-header">
                <img src="~/images/pardo_logo.png" alt="Pardo Elementary School" class="school-logo-img" />
                <div class="sidebar-brand-text">@(isTeacher ? "CAMS Global" : "CAMS Admin")</div>
                <div class="sidebar-brand-sub">Pardo Elementary School</div>
            </div>

            <nav class="sidebar-nav">
                @if (isTeacher)
                {
                    <a href="@Url.Action("Dashboard", "Teacher")" class="nav-item-custom">
                        <i class="bi bi-arrow-left-circle-fill"></i>
                        <span>My Teacher Portal</span>
                    </a>
                    <div class="sidebar-label">Global Operations</div>
                }

                <a href="@Url.Action("Index", "Admin")" class="nav-item-custom @(currentController == "Admin" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-grid-fill"></i>
                    <span>Global Dashboard & Sessions</span>
                </a>

                <div class="sidebar-label">Global People & Student Profiles</div>

                <a href="@Url.Action("Teachers", "Admin")" class="nav-item-custom @(currentAction == "Teachers" ? "active" : "")">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>Teachers</span>
                </a>

                <a href="@Url.Action("Students", "Admin")" class="nav-item-custom @(currentAction == "Students" ? "active" : "")">
                    <i class="bi bi-mortarboard-fill"></i>
                    <span>Students</span>
                </a>

                <a href="@Url.Action("Classes", "Admin")" class="nav-item-custom @(currentAction is "Classes" or "ClassDetails" ? "active" : "")">
                    <i class="bi bi-folder-fill"></i>
                    <span>Classes, Class Details & Import</span>
                </a>

                <div class="sidebar-label">Global Computers</div>

                <a href="@Url.Action("Computers", "Admin")" class="nav-item-custom @(currentAction is "Computers" or "ComputerHistory" ? "active" : "")">
                    <i class="bi bi-pc-display"></i>
                    <span>Computers, History & Mapping</span>
                </a>

                <div class="sidebar-label">Global Restrictions</div>

                <a href="@Url.Action("Restrictions", "Admin")" class="nav-item-custom @(currentAction == "Restrictions" ? "active" : "")">
                    <i class="bi bi-slash-circle-fill"></i>
                    <span>Rules & Categories</span>
                </a>

                <a href="@Url.Action("Blacklists", "Admin")" class="nav-item-custom @(currentAction == "Blacklists" ? "active" : "")">
                    <i class="bi bi-ban"></i>
                    <span>Blacklist Directory</span>
                </a>

                <a href="@Url.Action("Whitelists", "Admin")" class="nav-item-custom @(currentAction == "Whitelists" ? "active" : "")">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Whitelist Directory</span>
                </a>

                <a href="@Url.Action("SessionRules", "Admin")" class="nav-item-custom @(currentAction == "SessionRules" ? "active" : "")">
                    <i class="bi bi-hourglass-split"></i>
                    <span>Session Rules</span>
                </a>

                @if (!isTeacher)
                {
                    <div class="sidebar-label">Administrator Only</div>
                    <a href="@Url.Action("Settings", "Admin")" class="nav-item-custom @(currentAction == "Settings" ? "active" : "")"><i class="bi bi-person-gear"></i><span>Admin Accounts & Lockouts</span></a>
                    <a href="@Url.Action("Roles", "Admin")" class="nav-item-custom @(currentAction == "Roles" ? "active" : "")"><i class="bi bi-key-fill"></i><span>Roles & Permissions</span></a>
                    <a href="@Url.Action("LanConfig", "Admin")" class="nav-item-custom @(currentAction == "LanConfig" ? "active" : "")"><i class="bi bi-router-fill"></i><span>LAN Status</span></a>
                    <a href="@Url.Action("Index", "AdminDeployment")" class="nav-item-custom @(currentController == "AdminDeployment" ? "active" : "")"><i class="bi bi-box-seam-fill"></i><span>Deployment Hub</span></a>
                    <a href="@Url.Action("Index", "AdminDatabase")" class="nav-item-custom @(currentController == "AdminDatabase" ? "active" : "")"><i class="bi bi-database-gear"></i><span>Database Maintenance</span></a>
                    <a href="@Url.Action("Reports", "Admin")" class="nav-item-custom @(currentAction == "Reports" ? "active" : "")"><i class="bi bi-bar-chart-line-fill"></i><span>System Reports</span></a>
                    <a href="@Url.Action("AuditLogs", "Admin")" class="nav-item-custom @(currentAction == "AuditLogs" ? "active" : "")"><i class="bi bi-journal-text"></i><span>Audit Trail</span></a>
                    <a href="@Url.Action("SystemLogs", "Admin")" class="nav-item-custom @(currentAction == "SystemLogs" ? "active" : "")"><i class="bi bi-bug-fill"></i><span>System Logs</span></a>
                }
            </nav>
        </aside>
        <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

        <!-- Main Content Area -->
        <div class="app-main">
            <!-- Top Header Navbar -->
            <header class="app-header">
                <button class="btn-toggle-sidebar" id="sidebarToggle" type="button" aria-label="Toggle Navigation" aria-controls="appSidebar" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>

                <div class="d-flex align-items-center gap-3">
                    <div class="user-profile-badge">
                        <div class="user-avatar-circle">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div class="d-flex flex-column text-end">
                            <span class="fw-bold fs-6">@displayName</span>
                            <span class="badge bg-success small" style="font-size: 0.7rem;">@(isTeacher ? "Teacher · Global Operations" : "Administrator")</span>
                        </div>
                    </div>
                    <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger btn-sm rounded-pill px-3 ms-2" title="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </a>
                </div>
            </header>

            <!-- Body Content -->
            <main role="main" class="content-padding">
                <div class="alert @(isTeacher ? "alert-warning" : "alert-info") shadow-sm" role="status">
                    <i class="bi bi-globe2 me-2"></i><strong>Global scope:</strong>
                    Changes on this page can affect accounts, classes, computers, policies, or sessions across the school@(isTeacher ? ". Use My Teacher Portal for your personal classes and monitoring." : ".").
                </div>
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="~/Views/Shared/_ConfirmModal.cshtml" />
    <partial name="~/Views/Shared/_Toasts.cshtml" />

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (() => {
            const sidebar = document.getElementById('appSidebar');
            const toggle = document.getElementById('sidebarToggle');
            const backdrop = document.getElementById('sidebarBackdrop');
            const setOpen = (open) => {
                sidebar?.classList.toggle('show', open);
                backdrop?.classList.toggle('show', open);
                document.body.classList.toggle('sidebar-open', open);
                toggle?.setAttribute('aria-expanded', String(open));
            };
            toggle?.addEventListener('click', () => setOpen(!sidebar?.classList.contains('show')));
            backdrop?.addEventListener('click', () => setOpen(false));
            sidebar?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
            document.addEventListener('keydown', event => { if (event.key === 'Escape') setOpen(false); });
            window.addEventListener('resize', () => { if (window.innerWidth > 991) setOpen(false); });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
