@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var adminName = ViewContext.HttpContext.Session.GetString("AdminName") ?? "System Administrator";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CAMS Admin | Pardo Elementary School</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <div class="app-wrapper">
        <!-- Dark Emerald Sidebar -->
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-header">
                <img src="~/images/pardo_logo.png" alt="Pardo Elementary School" class="school-logo-img" />
                <div class="sidebar-brand-text">CAMS Admin</div>
                <div class="sidebar-brand-sub">Pardo Elementary School</div>
            </div>

            <nav class="sidebar-nav">
                <a href="/Admin" class="nav-item-custom @(currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>

                <div class="sidebar-label">User Management</div>

                <a href="/Admin/Teachers" class="nav-item-custom @(currentAction == "Teachers" ? "active" : "")">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>Teacher Management</span>
                </a>

                <a href="/Admin/Students" class="nav-item-custom @(currentAction == "Students" ? "active" : "")">
                    <i class="bi bi-mortarboard-fill"></i>
                    <span>Student Management</span>
                </a>

                <a href="/Admin/Classes" class="nav-item-custom @(currentAction is "Classes" or "ClassDetails" ? "active" : "")">
                    <i class="bi bi-folder-fill"></i>
                    <span>Class Management</span>
                </a>

                <a href="/Admin/Roles" class="nav-item-custom @(currentAction == "Roles" ? "active" : "")">
                    <i class="bi bi-key-fill"></i>
                    <span>Roles & Permissions</span>
                </a>

                <div class="sidebar-label">Lab & Infrastructure</div>

                <a href="/Admin/Computers" class="nav-item-custom @(currentAction == "Computers" ? "active" : "")">
                    <i class="bi bi-pc-display"></i>
                    <span>Computer Profiles</span>
                </a>

                <a href="/Admin/LanConfig" class="nav-item-custom @(currentAction == "LanConfig" ? "active" : "")">
                    <i class="bi bi-router-fill"></i>
                    <span>LAN Configuration</span>
                </a>

                <div class="sidebar-label">Policy & Security</div>

                <a href="/Admin/Restrictions" class="nav-item-custom @(currentAction == "Restrictions" ? "active" : "")">
                    <i class="bi bi-slash-circle-fill"></i>
                    <span>Restriction Rules</span>
                </a>

                <a href="/Admin/Blacklists" class="nav-item-custom @(currentAction == "Blacklists" ? "active" : "")">
                    <i class="bi bi-ban"></i>
                    <span>Blacklist Directory</span>
                </a>

                <a href="/Admin/SessionRules" class="nav-item-custom @(currentAction == "SessionRules" ? "active" : "")">
                    <i class="bi bi-hourglass-split"></i>
                    <span>Session Rules</span>
                </a>

                <div class="sidebar-label">Analytics & Logs</div>

                <a href="/Admin/Reports" class="nav-item-custom @(currentAction == "Reports" ? "active" : "")">
                    <i class="bi bi-bar-chart-line-fill"></i>
                    <span>System Reports</span>
                </a>

                <a href="/Admin/AuditLogs" class="nav-item-custom @(currentAction == "AuditLogs" ? "active" : "")">
                    <i class="bi bi-journal-text"></i>
                    <span>Audit Trail</span>
                </a>

                <a href="/Admin/SystemLogs" class="nav-item-custom @(currentAction == "SystemLogs" ? "active" : "")">
                    <i class="bi bi-bug-fill"></i>
                    <span>System Logs</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div class="app-main">
            <!-- Top Header Navbar -->
            <header class="app-header">
                <button class="btn-toggle-sidebar" id="sidebarToggle" type="button" aria-label="Toggle Navigation">
                    <i class="bi bi-list"></i>
                </button>

                <div class="d-flex align-items-center gap-3">
                    <div class="user-profile-badge">
                        <div class="user-avatar-circle">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div class="d-flex flex-column text-end">
                            <span class="fw-bold fs-6">@adminName</span>
                            <span class="badge bg-success small" style="font-size: 0.7rem;">Administrator</span>
                        </div>
                    </div>
                    <a href="/Account/Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 ms-2" title="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </a>
                </div>
            </header>

            <!-- Body Content -->
            <main role="main" class="content-padding">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('appSidebar')?.classList.toggle('show');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
