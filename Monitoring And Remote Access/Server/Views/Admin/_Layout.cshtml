@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var adminName = ViewContext.HttpContext.Session.GetString("AdminName") ?? "System Administrator";
    var successMessage = TempData["Message"]?.ToString();
    var errorMessage = TempData["ErrorMessage"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CAMS Admin | Pardo Elementary School</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <!-- Dark Emerald Sidebar -->
        <aside class="app-sidebar" id="appSidebar" aria-label="Administrator navigation">
            <div class="sidebar-header">
                <img src="~/images/pardo_logo.png" alt="Pardo Elementary School" class="school-logo-img" />
                <div class="sidebar-brand-text">CAMS Admin</div>
                <div class="sidebar-brand-sub">Pardo Elementary School</div>
            </div>

            <nav class="sidebar-nav">
                <a href="@Url.Action("Index", "Admin")" class="nav-item-custom @(currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>

                <div class="sidebar-label">User Management</div>

                <a href="@Url.Action("Teachers", "Admin")" class="nav-item-custom @(currentAction == "Teachers" ? "active" : "")">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>Teacher Management</span>
                </a>

                <a href="@Url.Action("Students", "Admin")" class="nav-item-custom @(currentAction == "Students" ? "active" : "")">
                    <i class="bi bi-mortarboard-fill"></i>
                    <span>Student Management</span>
                </a>

                <a href="@Url.Action("Classes", "Admin")" class="nav-item-custom @(currentAction is "Classes" or "ClassDetails" ? "active" : "")">
                    <i class="bi bi-folder-fill"></i>
                    <span>Class Management</span>
                </a>

                <a href="@Url.Action("Roles", "Admin")" class="nav-item-custom @(currentAction == "Roles" ? "active" : "")">
                    <i class="bi bi-key-fill"></i>
                    <span>Roles & Permissions</span>
                </a>

                <div class="sidebar-label">Lab & Infrastructure</div>

                <a href="@Url.Action("Computers", "Admin")" class="nav-item-custom @(currentAction == "Computers" ? "active" : "")">
                    <i class="bi bi-pc-display"></i>
                    <span>Computer Profiles</span>
                </a>

                <a href="@Url.Action("LanConfig", "Admin")" class="nav-item-custom @(currentAction == "LanConfig" ? "active" : "")">
                    <i class="bi bi-router-fill"></i>
                    <span>LAN Status</span>
                </a>

                <a href="@Url.Action("Index", "AdminDeployment")" class="nav-item-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminDeployment" ? "active" : "")">
                    <i class="bi bi-box-seam-fill"></i>
                    <span>Deployment Hub</span>
                </a>

                <a href="@Url.Action("Index", "AdminDatabase")" class="nav-item-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminDatabase" ? "active" : "")">
                    <i class="bi bi-database-gear"></i>
                    <span>Database Maintenance</span>
                </a>

                <div class="sidebar-label">Policy & Security</div>

                <a href="@Url.Action("Restrictions", "Admin")" class="nav-item-custom @(currentAction == "Restrictions" ? "active" : "")">
                    <i class="bi bi-slash-circle-fill"></i>
                    <span>Restriction Rules</span>
                </a>

                <a href="@Url.Action("Blacklists", "Admin")" class="nav-item-custom @(currentAction == "Blacklists" ? "active" : "")">
                    <i class="bi bi-ban"></i>
                    <span>Blacklist Directory</span>
                </a>

                <a href="@Url.Action("SessionRules", "Admin")" class="nav-item-custom @(currentAction == "SessionRules" ? "active" : "")">
                    <i class="bi bi-hourglass-split"></i>
                    <span>Session Rules</span>
                </a>

                <div class="sidebar-label">Analytics & Logs</div>

                <a href="@Url.Action("Reports", "Admin")" class="nav-item-custom @(currentAction == "Reports" ? "active" : "")">
                    <i class="bi bi-bar-chart-line-fill"></i>
                    <span>System Reports</span>
                </a>

                <a href="@Url.Action("AuditLogs", "Admin")" class="nav-item-custom @(currentAction == "AuditLogs" ? "active" : "")">
                    <i class="bi bi-journal-text"></i>
                    <span>Audit Trail</span>
                </a>

                <a href="@Url.Action("SystemLogs", "Admin")" class="nav-item-custom @(currentAction == "SystemLogs" ? "active" : "")">
                    <i class="bi bi-bug-fill"></i>
                    <span>System Logs</span>
                </a>

                <a href="@Url.Action("Settings", "Admin")" class="nav-item-custom @(currentAction == "Settings" ? "active" : "")">
                    <i class="bi bi-person-gear"></i>
                    <span>Account & Lockouts</span>
                </a>
            </nav>
        </aside>
        <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

        <!-- Main Content Area -->
        <div class="app-main">
            <!-- Top Header Navbar -->
            <header class="app-header">
                <button class="btn-toggle-sidebar" id="sidebarToggle" type="button" aria-label="Toggle Navigation" aria-controls="appSidebar" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>

                <div class="d-flex align-items-center gap-3">
                    <div class="user-profile-badge">
                        <div class="user-avatar-circle">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div class="d-flex flex-column text-end">
                            <span class="fw-bold fs-6">@adminName</span>
                            <span class="badge bg-success small" style="font-size: 0.7rem;">Administrator</span>
                        </div>
                    </div>
                    <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger btn-sm rounded-pill px-3 ms-2" title="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </a>
                </div>
            </header>

            <!-- Body Content -->
            <main role="main" class="content-padding">
                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert"><i class="bi bi-check-circle me-2"></i>@successMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button></div>
                }
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert"><i class="bi bi-exclamation-triangle me-2"></i>@errorMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button></div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const sidebar = document.getElementById('appSidebar');
            const toggle = document.getElementById('sidebarToggle');
            const backdrop = document.getElementById('sidebarBackdrop');
            const setOpen = (open) => {
                sidebar?.classList.toggle('show', open);
                backdrop?.classList.toggle('show', open);
                document.body.classList.toggle('sidebar-open', open);
                toggle?.setAttribute('aria-expanded', String(open));
            };
            toggle?.addEventListener('click', () => setOpen(!sidebar?.classList.contains('show')));
            backdrop?.addEventListener('click', () => setOpen(false));
            sidebar?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
            document.addEventListener('keydown', event => { if (event.key === 'Escape') setOpen(false); });
            window.addEventListener('resize', () => { if (window.innerWidth > 991) setOpen(false); });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
