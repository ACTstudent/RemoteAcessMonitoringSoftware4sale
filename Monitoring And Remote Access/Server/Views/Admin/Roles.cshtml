@model IEnumerable<Server.Models.Role>
@{
    ViewData["Title"] = "Roles & Permissions";
    Layout = "_Layout";
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-key-fill fs-3"></i>
        </div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">Roles & Permissions</h2>
            <p class="text-muted mb-0 small">Manage role-based access control (RBAC) privileges for Administrators, Teachers, and Students</p>
        </div>
    </div>
    <button class="btn btn-emerald rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#createRoleModal">
        <i class="bi bi-plus-circle-fill me-1"></i> Add Custom Role
    </button>
</div>

<!-- Roles Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Configured RBAC System Roles</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@Model.Count() Roles</span>
    </div>
    <div class="table-responsive">
        <table class="table custom-table mb-0">
            <thead>
                <tr>
                    <th>Role ID</th>
                    <th>Role Name</th>
                    <th>Description</th>
                    <th>Assigned Permissions</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted font-monospace">#ROLE-@r.RoleId.ToString("D2")</td>
                        <td>
                            <span class="badge bg-dark rounded-pill px-3 py-1 font-monospace fs-6">@r.Name</span>
                        </td>
                        <td>@r.Description</td>
                        <td>
                            @if (r.Permissions != null && r.Permissions.Any())
                            {
                                @foreach (var p in r.Permissions)
                                {
                                    <span class="badge bg-light text-dark border me-1">@p.Name</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Standard Access</span>
                            }
                        </td>
                        <td class="text-end">
                            <form method="post" action="/Admin/DeleteRole" style="margin:0;" data-confirm="Delete this role?" data-confirm-title="Delete role" data-confirm-label="Delete">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.RoleId" />
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No custom roles configured.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create Role -->
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-labelledby="createRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                <h5 class="modal-title fw-bold" id="createRoleModalLabel">
                    <i class="bi bi-key me-2"></i> Add Custom Role
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/CreateRole">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="roles-role-name">Role Name <span class="text-danger">*</span></label>
                        <input id="roles-role-name" type="text" name="Name" class="form-control filter-control" required placeholder="e.g. Lab Technician" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small" for="roles-description">Description</label>
                        <input id="roles-description" type="text" name="Description" class="form-control filter-control" placeholder="e.g. Can manage computer profiles and network settings" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Role</button>
                </div>
            </form>
        </div>
    </div>
</div>
