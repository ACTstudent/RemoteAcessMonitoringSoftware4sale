@model IEnumerable<Server.Models.Computer>
@{
    ViewData["Title"] = "Workstation Profiles";
    Layout = "_TeacherLayout";

    var total = Model.Count();
    var available = Model.Count(c => c.Status == "Available");
    var inUse = Model.Count(c => c.Status == "In Use");
    var maintenance = Model.Count(c => c.Status == "Maintenance");
    var studentNames = ViewBag.StudentNames as IDictionary<string, string> ?? new Dictionary<string, string>();
    var statusOptions = new[] { "Available", "Assigned", "In Use", "Maintenance", "Online", "Offline" };
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-pc-display fs-3"></i>
        </div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">Workstation Profiles</h2>
            <p class="text-muted mb-0 small">Monitor laboratory workstations, operational state, and station status</p>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
        <a href="/Teacher/Settings" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-key me-1"></i> Account Settings
        </a>
        <span class="badge bg-success rounded-pill px-3 py-2 fs-6">
            <i class="bi bi-check-circle me-1"></i> @available / @total Available
        </span>
    </div>
</div>

<!-- Metric Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Workstations</div>
                <div class="metric-value">@total</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-pc-display fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Available</div>
                <div class="metric-value text-success">@available</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-check-circle-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="metric-card metric-card-active d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">In Use</div>
                <div class="metric-value text-primary">@inUse</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-person-workspace fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Maintenance</div>
                <div class="metric-value text-warning">@maintenance</div>
            </div>
            <div class="metric-icon-box bg-warning text-dark">
                <i class="bi bi-tools fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Workstation List Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Laboratory Workstations</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@total Workstations</span>
    </div>
    <div class="table-responsive">
        <table class="table custom-table mb-0">
            <thead>
                <tr>
                    <th>Station Name</th>
                    <th>Status</th>
                    <th>Assigned Student ID</th>
                    <th class="text-end">Update Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var assignedName = c.AssignedTo != null && studentNames.TryGetValue(c.AssignedTo, out var name) ? name : null;
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-pc-display-horizontal fs-5 text-emerald-700"></i>
                                <span class="fw-bold text-dark fs-6">@c.LaboratoryStation</span>
                            </div>
                        </td>
                        <td>
                            @if (c.Status == "Available")
                            {
                                <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i> Available</span>
                            }
                            else if (c.Status == "In Use")
                            {
                                <span class="badge bg-primary rounded-pill px-3 py-1"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i> In Use</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Maintenance</span>
                            }
                        </td>
                        <td>
                            @if (assignedName != null)
                            {
                                <span class="fw-semibold">@assignedName</span><br />
                                <span class="small text-muted font-monospace">Student #@c.AssignedTo</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editComputerModal-@c.ComputerId">
                                <i class="bi bi-pencil me-1"></i> Edit Profile
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No workstations configured.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@foreach (var c in Model)
{
    <div class="modal fade" id="editComputerModal-@c.ComputerId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pc-display me-2"></i>Edit Workstation Profile</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="/Teacher/UpdateComputer">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ComputerId" value="@c.ComputerId" />
                    <div class="modal-body py-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Station Name</label>
                            <input type="text" name="LaboratoryStation" value="@c.LaboratoryStation" maxlength="50" class="form-control filter-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Operational Status</label>
                            <select name="Status" class="form-select filter-control" required>
                                @if (!statusOptions.Contains(c.Status))
                                {
                                    <option value="@c.Status" selected>@c.Status</option>
                                }
                                @foreach (var status in statusOptions)
                                {
                                    <option value="@status" selected="@(status == c.Status ? "selected" : null)">@status</option>
                                }
                            </select>
                        </div>
                        <div class="alert alert-light border mb-0 small text-muted">
                            Student assignment is administrator-managed and will not be changed when this profile is saved.
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Profile</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
