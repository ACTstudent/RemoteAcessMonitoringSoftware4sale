@using Microsoft.AspNetCore.Http
@using Microsoft.EntityFrameworkCore
@inject Server.Data.ApplicationDbContext Db
@{
    Layout = null;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var teacherName = ViewContext.HttpContext.Session.GetString("TeacherName") ?? "Teacher";
    var successMessage = TempData["Message"]?.ToString();
    var errorMessage = TempData["ErrorMessage"]?.ToString();
    var teacherId = ViewContext.HttpContext.Session.GetInt32("TeacherId");
    var openAlertCount = teacherId.HasValue
        ? await Db.MonitoringAlerts.AsNoTracking()
            .Where(alert => !alert.IsAcknowledged && alert.DismissedAt == null)
            .Where(alert => Db.Students.Any(student => student.StudentNumber == alert.StudentId &&
                (student.AdviserId == teacherId.Value || Db.Classes.Any(cls => cls.TeacherId == teacherId.Value &&
                    !cls.IsArchived && (cls.Status == "Active" || string.IsNullOrEmpty(cls.Status)) &&
                    (cls.ClassId == student.ClassId || Db.ClassStudents.Any(join => join.ClassId == cls.ClassId && join.StudentId == student.Id))))))
            .Select(alert => alert.GroupKey)
            .Distinct()
            .CountAsync()
        : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CAMS Teacher | Pardo Elementary School</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="app-shell">
    <div class="app-wrapper">
        <!-- Dark Emerald Sidebar -->
        <aside class="app-sidebar" id="appSidebar" aria-label="Teacher navigation">
            <div class="sidebar-header">
                <img src="~/images/pardo_logo.png" alt="Pardo Elementary School" class="school-logo-img" />
                <div class="sidebar-brand-text">CAMS Teacher</div>
                <div class="sidebar-brand-sub">Pardo Elementary School</div>
            </div>

            <nav class="sidebar-nav">
                <a href="@Url.Action("Dashboard", "Teacher")" class="nav-item-custom @(currentAction == "Dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>

                <div class="sidebar-label">Laboratory Control</div>

                <a href="@Url.Action("Sessions", "Teacher")" class="nav-item-custom @(currentAction == "Sessions" ? "active" : "")">
                    <i class="bi bi-play-circle-fill"></i>
                    <span>Session Management</span>
                </a>

                <a href="@Url.Action("Monitoring", "Teacher")" class="nav-item-custom @(currentAction == "Monitoring" ? "active" : "")">
                    <i class="bi bi-camera-video-fill"></i>
                    <span>Live Monitoring</span>
                </a>

                <a href="@Url.Action("RemoteHistory", "Teacher")" class="nav-item-custom @(currentAction == "RemoteHistory" ? "active" : "")">
                    <i class="bi bi-terminal-fill"></i>
                    <span>Remote-Control History</span>
                </a>

                <a href="@Url.Action("Computers", "Teacher")" class="nav-item-custom @(currentAction == "Computers" ? "active" : "")">
                    <i class="bi bi-pc-display"></i>
                    <span>Workstations</span>
                </a>

                <div class="sidebar-label">Classroom Management</div>

                <a href="@Url.Action("Classes", "Teacher")" class="nav-item-custom @(currentAction == "Classes" || currentAction == "ClassDetails" ? "active" : "")">
                    <i class="bi bi-folder-fill"></i>
                    <span>Class Management</span>
                </a>

                <a href="@Url.Action("Students", "Teacher")" class="nav-item-custom @(currentAction == "Students" ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    <span>Student Profiles</span>
                </a>

                <a href="@Url.Action("Restrictions", "Teacher")" class="nav-item-custom @(currentAction == "Restrictions" ? "active" : "")">
                    <i class="bi bi-slash-circle-fill"></i>
                    <span>Access Restrictions</span>
                </a>

                <a href="@Url.Action("Records", "Teacher")" class="nav-item-custom @(currentAction == "Records" ? "active" : "")">
                    <i class="bi bi-journal-check"></i>
                    <span>Classroom Records</span>
                </a>

                <a href="@Url.Action("LabUtilization", "Teacher")" class="nav-item-custom @(currentAction == "LabUtilization" ? "active" : "")">
                    <i class="bi bi-bar-chart-fill"></i>
                    <span>Lab Utilization</span>
                </a>

                <a href="@Url.Action("UnifiedTimeline", "Teacher")" class="nav-item-custom @(currentAction == "UnifiedTimeline" ? "active" : "")">
                    <i class="bi bi-clock-history"></i>
                    <span>Unified Timeline</span>
                </a>

                <a href="@Url.Action("BrowserMonitoringHistory", "Teacher")" class="nav-item-custom @(currentAction == "BrowserMonitoringHistory" ? "active" : "")">
                    <i class="bi bi-browser-chrome"></i>
                    <span>Browser Monitoring</span>
                </a>

                <a href="@Url.Action("Alerts", "Teacher")" class="nav-item-custom @(currentAction == "Alerts" ? "active" : "")">
                    <i class="bi bi-bell-fill"></i>
                    <span>Monitoring Alerts</span>
                    <span id="monitoringAlertBadge" class="badge bg-danger rounded-pill ms-auto @(openAlertCount == 0 ? "d-none" : "")">@openAlertCount</span>
                </a>

                <a href="@Url.Action("Settings", "Teacher")" class="nav-item-custom @(currentAction == "Settings" ? "active" : "")">
                    <i class="bi bi-person-gear"></i>
                    <span>Account Settings</span>
                </a>

                <div class="sidebar-label">Global Operations</div>

                <a href="@Url.Action("Index", "Admin")" class="nav-item-custom"><i class="bi bi-globe2"></i><span>Dashboard & All Sessions</span></a>
                <a href="@Url.Action("Teachers", "Admin")" class="nav-item-custom"><i class="bi bi-person-badge-fill"></i><span>Teachers</span></a>
                <a href="@Url.Action("Students", "Admin")" class="nav-item-custom"><i class="bi bi-mortarboard-fill"></i><span>Students</span></a>
                <a href="@Url.Action("Classes", "Admin")" class="nav-item-custom"><i class="bi bi-folder-symlink-fill"></i><span>Classes, Student Profiles & Import</span></a>
                <a href="@Url.Action("Computers", "Admin")" class="nav-item-custom"><i class="bi bi-pc-display-horizontal"></i><span>Computers, History & Mapping</span></a>
                <a href="@Url.Action("Restrictions", "Admin")" class="nav-item-custom"><i class="bi bi-shield-lock-fill"></i><span>Rules & Categories</span></a>
                <a href="@Url.Action("Blacklists", "Admin")" class="nav-item-custom"><i class="bi bi-ban"></i><span>Blacklists</span></a>
                <a href="@Url.Action("Whitelists", "Admin")" class="nav-item-custom"><i class="bi bi-check-circle-fill"></i><span>Whitelists</span></a>
                <a href="@Url.Action("SessionRules", "Admin")" class="nav-item-custom"><i class="bi bi-hourglass-split"></i><span>Session Rules</span></a>
            </nav>
        </aside>
        <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

        <!-- Main Content Area -->
        <div class="app-main">
            <!-- Top Header Navbar -->
            <header class="app-header">
                <button class="btn-toggle-sidebar" id="sidebarToggle" type="button" aria-label="Toggle Navigation" aria-controls="appSidebar" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>

                <div class="d-flex align-items-center gap-3">
                    <div class="user-profile-badge">
                        <div class="user-avatar-circle">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div class="d-flex flex-column text-end">
                            <span class="fw-bold fs-6">@teacherName</span>
                            <span class="badge bg-success small" style="font-size: 0.7rem;">Instructor</span>
                        </div>
                    </div>
                    <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger btn-sm rounded-pill px-3 ms-2" title="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </a>
                </div>
            </header>

            <!-- Body Content -->
            <main role="main" class="content-padding">
                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert"><i class="bi bi-check-circle me-2"></i>@successMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button></div>
                }
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert"><i class="bi bi-exclamation-triangle me-2"></i>@errorMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button></div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="~/Views/Shared/_ConfirmModal.cshtml" />

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (() => {
            const sidebar = document.getElementById('appSidebar');
            const toggle = document.getElementById('sidebarToggle');
            const backdrop = document.getElementById('sidebarBackdrop');
            const setOpen = (open) => {
                sidebar?.classList.toggle('show', open);
                backdrop?.classList.toggle('show', open);
                document.body.classList.toggle('sidebar-open', open);
                toggle?.setAttribute('aria-expanded', String(open));
            };
            toggle?.addEventListener('click', () => setOpen(!sidebar?.classList.contains('show')));
            backdrop?.addEventListener('click', () => setOpen(false));
            sidebar?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
            document.addEventListener('keydown', event => { if (event.key === 'Escape') setOpen(false); });
            window.addEventListener('resize', () => { if (window.innerWidth > 991) setOpen(false); });
        })();
    </script>
    <script>
        (() => {
            const badge = document.getElementById("monitoringAlertBadge");
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/remoteMonitoringHub")
                .withAutomaticReconnect()
                .build();
            const refreshAlertCount = async () => {
                if (!badge) return;
                const response = await fetch("/Teacher/OpenAlertCount", { credentials: "same-origin" });
                if (!response.ok) return;
                const count = Number((await response.json()).count) || 0;
                badge.textContent = String(count);
                badge.classList.toggle("d-none", count === 0);
            };
            connection.on("MonitoringAlertReceived", () => refreshAlertCount().catch(() => {}));
            window.teacherHubConnection = connection;
            window.teacherHubStarted = connection.start();
            window.teacherHubStarted.catch(error => {
                console.error("Teacher notifications connection failed", error);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
