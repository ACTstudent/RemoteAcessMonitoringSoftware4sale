@{
    // The page shell lives in Views/Shared/_AppLayout.cshtml, once for all three
    // portals. This file only says which portal is being rendered; the links,
    // branding and any portal-specific topbar or script come from
    // NavigationBuilder.
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["NavVariant"] = "Teacher";
}
@RenderBody()
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
