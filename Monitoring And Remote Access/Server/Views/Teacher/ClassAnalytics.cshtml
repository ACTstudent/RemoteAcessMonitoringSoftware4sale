@model Server.Models.ClassAnalyticsReport
@{ ViewData["Title"] = "Class Analytics"; Layout = "_TeacherLayout"; }
<h2 class="fw-bold">@Model.Class.ClassName Analytics</h2>
<p class="text-muted">@Model.From.ToLocalTime().ToString("d") - @Model.To.ToLocalTime().ToString("d")</p>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric-card"><div class="metric-title">Sessions</div><div class="metric-value">@Model.TotalSessions</div></div></div><div class="col-md-4"><div class="metric-card"><div class="metric-title">Lab Minutes</div><div class="metric-value">@Math.Round(Model.TotalMinutes, 1)</div></div></div><div class="col-md-4"><div class="metric-card"><div class="metric-title">Alerts</div><div class="metric-value">@Model.Alerts.Count</div></div></div></div>
<div class="card border-0 shadow-sm rounded-4"><table class="table custom-table mb-0"><thead><tr><th>Student</th><th>Sessions</th></tr></thead><tbody>@foreach (var item in Model.SessionsByStudent) { <tr><td>@item.Key</td><td>@item.Value</td></tr> }</tbody></table></div>
