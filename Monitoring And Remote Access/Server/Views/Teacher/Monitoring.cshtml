@{
    ViewData["Title"] = "Live Monitoring Grid";
    Layout = "_TeacherLayout";
}

<!-- Header & Live Status Banner -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-camera-video-fill fs-3"></i>
        </div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">Live Workstation Monitoring</h2>
            <p class="text-muted mb-0 small">Real-time SignalR WebSocket screen feeds & remote laboratory control</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-emerald rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#broadcastModal">
            <i class="bi bi-broadcast me-1"></i> Broadcast Screen
        </button>
        <button class="btn btn-outline-danger rounded-pill px-4 py-2 fw-semibold shadow-sm" onclick="lockAllStations()">
            <i class="bi bi-lock-fill me-1"></i> Lock All Units
        </button>
    </div>
</div>

<!-- Real-time Control Toolbar -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <div class="row g-3 align-items-center">
        <div class="col-md-3 col-sm-6">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success rounded-circle p-2"></span>
                <span class="fw-bold text-dark small">Status: <span id="lblSessionState" class="text-success">Ready</span></span>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-muted"></i>
                <span class="fw-bold text-dark small">Session Timer: <span id="lblSessionTimer" class="session-timer fs-5">00:00</span></span>
            </div>
        </div>
        <div class="col-md-4 col-sm-8">
            <div class="search-input-wrapper">
                <input type="text" id="gridSearch" class="form-control filter-control search-input py-1.5" placeholder="Filter workstations..." />
                <i class="bi bi-search search-icon text-muted"></i>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 text-end">
            <span class="badge bg-light text-dark font-monospace border py-2 px-3 rounded-pill" id="lblConnectedCount">0 Units Active</span>
        </div>
    </div>
</div>

<!-- Live Monitoring Workstations Grid Container -->
<div class="row g-4" id="workstationsGrid">
    <!-- SignalR dynamic workstation cards will be populated here -->
    <div class="col-12 text-center py-5 text-muted" id="emptyState">
        <i class="bi bi-display-slash display-3 d-block opacity-50 mb-3 text-emerald-800"></i>
        <h5 class="fw-bold">Awaiting Workstation Connections...</h5>
        <p class="small">Ensure student client agents are launched on workstations in the computer laboratory.</p>
    </div>
</div>

<!-- Modal: Broadcast Screen -->
<div class="modal fade" id="broadcastModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-broadcast me-2"></i> Broadcast Teacher Screen
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="text-muted small">Share your current display screen with all connected student workstations across the laboratory.</p>
                <div class="alert alert-info py-2 small">
                    <i class="bi bi-info-circle-fill me-1"></i> Students will receive the screen stream in full-screen mode.
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-emerald rounded-pill px-4 text-white" onclick="startBroadcast()">Start Broadcast</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        const hub = new signalR.HubConnectionBuilder()
            .withUrl("/remoteMonitoringHub")
            .withAutomaticReconnect()
            .build();

        const activeUnits = new Map();

        hub.on("ReceiveScreenStream", (connectionId, pcName, base64Image) => {
            updateWorkstationCard(connectionId, pcName, base64Image);
        });

        hub.on("GlobalSessionState", (state) => {
            document.getElementById("lblSessionState").textContent = state.status;
            const timerEl = document.getElementById("lblSessionTimer");
            const m = Math.floor(state.elapsedSeconds / 60), s = state.elapsedSeconds % 60;
            timerEl.textContent = String(m).padStart(2,"0") + ":" + String(s).padStart(2,"0");
        });

        function updateWorkstationCard(connId, pcName, base64Img) {
            document.getElementById("emptyState")?.remove();
            let card = document.getElementById("unit-card-" + connId);
            
            if (!card) {
                const col = document.createElement("div");
                col.className = "col-lg-3 col-md-4 col-sm-6 unit-col";
                col.id = "unit-card-" + connId;
                col.innerHTML = `
                    <div class="workstation-card h-100 d-flex flex-column justify-content-between">
                        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-success rounded-circle p-1"></span>
                                <span class="fw-bold text-dark font-monospace small">${pcName}</span>
                            </div>
                            <span class="badge badge-active">Online</span>
                        </div>
                        <div class="stream-container">
                            <img id="img-${connId}" class="stream-img" src="data:image/jpeg;base64,${base64Img}" alt="${pcName}" />
                        </div>
                        <div class="p-3 bg-light d-flex justify-content-between align-items-center">
                            <button class="btn btn-sm btn-outline-emerald rounded-pill px-3" onclick="lockUnit('${connId}')">
                                <i class="bi bi-lock-fill me-1"></i> Lock
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="logoutUnit('${connId}')">
                                <i class="bi bi-power me-1"></i> Logout
                            </button>
                        </div>
                    </div>
                `;
                document.getElementById("workstationsGrid").appendChild(col);
                activeUnits.set(connId, pcName);
            } else {
                document.getElementById("img-" + connId).src = "data:image/jpeg;base64," + base64Img;
            }
            document.getElementById("lblConnectedCount").textContent = activeUnits.size + " Units Active";
        }

        function lockAllStations() {
            if (confirm("Are you sure you want to lock all laboratory student workstations?")) {
                hub.invoke("LockAllWorkstations").catch(console.error);
            }
        }

        function startBroadcast() {
            hub.invoke("StartScreenBroadcast").catch(console.error);
            bootstrap.Modal.getInstance(document.getElementById('broadcastModal'))?.hide();
        }

        function lockUnit(connId) {
            hub.invoke("LockWorkstation", connId).catch(console.error);
        }

        function logoutUnit(connId) {
            hub.invoke("LogoutWorkstation", connId).catch(console.error);
        }

        document.getElementById("gridSearch")?.addEventListener("input", function() {
            const q = this.value.toLowerCase();
            document.querySelectorAll(".unit-col").forEach(col => {
                col.style.display = col.textContent.toLowerCase().includes(q) ? "" : "none";
            });
        });

        hub.start().catch(console.error);
    </script>
}
