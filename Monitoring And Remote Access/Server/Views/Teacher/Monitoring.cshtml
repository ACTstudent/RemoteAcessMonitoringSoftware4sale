@{
    ViewData["Title"] = "Live Monitoring";
    Layout = "_TeacherLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-camera-video"></i> Live Monitoring</h4>
    <div>
        <span class="badge bg-success me-2" id="onlineCount">0 online</span>
        <button class="btn btn-sm btn-danger me-2" id="btnBroadcast">Broadcast Screen</button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header fw-bold small">Active Application Tracker</div>
            <div class="card-body p-2" id="appTracker">
                <div class="text-muted small">No application data yet...</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header fw-bold small">Idle/Active Status Monitor</div>
            <div class="card-body p-2" id="idleMonitor">
                <div class="text-muted small">No status data yet...</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header fw-bold small">Broadcast Notification</div>
            <div class="card-body p-2">
                <div class="input-group input-group-sm">
                    <select id="notifType" class="form-select form-select-sm">
                        <option>Warning</option>
                        <option>Alert</option>
                        <option>Info</option>
                    </select>
                    <input id="notifMsg" class="form-control form-control-sm" placeholder="Message" />
                    <button class="btn btn-warning btn-sm" id="btnNotify">Notify</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="studentGrid" class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-3"></div>

<div class="modal fade" id="remoteControlModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="background-color: #1c1f27; color: #e6e6e6;">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="remoteModalTitle">Remote Access</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="closeRemoteControl()"></button>
            </div>
            <div class="modal-body text-center p-1 position-relative">
                <canvas id="remoteCanvas" tabindex="0" class="border border-secondary w-100"></canvas>
                <div id="remoteHint" class="small text-muted mt-2">Tip: move mouse to control cursor. Click to send clicks. Type to send keyboard. Press ESC to close.</div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder().withUrl("/remoteMonitoringHub").withAutomaticReconnect().build();
    const canvas = document.getElementById("remoteCanvas");
    const ctx = canvas.getContext("2d");
    let activeTargetConnectionId = null;
    let onlineCount = 0;

    connection.start().then(() => connection.invoke("RegisterTeacher")).catch(console.error);

    // Live frames
    connection.on("ReceiveScreenFrame", (cid, frame) => {
        const card = document.getElementById("card-" + cid);
        if (!card) createStudentCard(cid, frame.studentId, frame.pcName);
        const img = document.getElementById("img-" + cid);
        if (img) img.src = "data:image/jpeg;base64," + frame.frameBase64;
        if (activeTargetConnectionId === cid) {
            const image = new Image();
            image.onload = () => { canvas.width = image.width; canvas.height = image.height; ctx.drawImage(image, 0, 0); };
            image.src = "data:image/jpeg;base64," + frame.frameBase64;
        }
    });

    connection.on("StudentConnected", (student) => {
        if (!document.getElementById("card-" + student.connectionId)) createStudentCard(student.connectionId, student.studentId, student.pcName);
        onlineCount++; document.getElementById("onlineCount").textContent = onlineCount + " online";
    });

    connection.on("StudentDisconnected", (cid) => {
        const card = document.getElementById("card-" + cid);
        if (card) card.remove();
        if (onlineCount > 0) onlineCount--;
        document.getElementById("onlineCount").textContent = onlineCount + " online";
        if (activeTargetConnectionId === cid) { bootstrap.Modal.getInstance(document.getElementById("remoteControlModal"))?.hide(); activeTargetConnectionId = null; }
        removeFromTracker(cid);
    });

    // App tracker
    connection.on("ActiveAppReceived", (app) => {
        let el = document.getElementById("app-" + app.connectionId);
        if (!el) {
            el = document.createElement("div");
            el.id = "app-" + app.connectionId;
            el.className = "app-item mb-1 small d-flex justify-content-between align-items-center";
            document.getElementById("appTracker").appendChild(el);
        }
        el.innerHTML = `<span><b>${escapeHtml(app.pcName)}</b></span><span class="text-muted">${escapeHtml(app.applicationName)}</span>`;
    });

    // Idle monitor
    connection.on("IdleStatusReceived", (status) => {
        let el = document.getElementById("idle-" + status.connectionId);
        if (!el) {
            el = document.createElement("div");
            el.id = "idle-" + status.connectionId;
            el.className = "idle-item mb-1 small d-flex justify-content-between align-items-center";
            document.getElementById("idleMonitor").appendChild(el);
        }
        el.innerHTML = `<span><b>${escapeHtml(status.pcName)}</b></span><span class="badge ${status.isIdle ? 'bg-warning text-dark' : 'bg-success'}">${status.isIdle ? 'Idle' : 'Active'}</span>`;
    });

    function removeFromTracker(cid) {
        const a = document.getElementById("app-" + cid); if (a) a.remove();
        const i = document.getElementById("idle-" + cid); if (i) i.remove();
    }

    function escapeHtml(s) { return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

    function createStudentCard(cid, sid, pc) {
        const grid = document.getElementById("studentGrid");
        const html = `
            <div class="col" id="card-${cid}">
                <div class="card h-100 shadow-sm">
                    <div class="card-header p-2 d-flex justify-content-between align-items-center">
                        <small class="fw-bold text-truncate">${escapeHtml(pc)}</small>
                        <span class="badge bg-success">Online</span>
                    </div>
                    <div class="placeholder-box" id="ph-${cid}">Waiting for stream...</div>
                    <img id="img-${cid}" class="stream-img d-none" />
                    <div class="card-body p-2 d-grid gap-1">
                        <small class="d-block text-muted text-truncate">${escapeHtml(sid)}</small>
                        <button class="btn btn-sm btn-primary" onclick="openRemoteControl('${cid}','${sid}','${pc}')"><i class="bi bi-mouse"></i> Remote Access</button>
                        <button class="btn btn-sm btn-warning" onclick="lockPC('${cid}')"><i class="bi bi-lock"></i> Lock</button>
                        <button class="btn btn-sm btn-outline-light" onclick="unlockPC('${cid}')"><i class="bi bi-unlock"></i> Unlock</button>
                        <button class="btn btn-sm btn-danger" onclick="forceLogout('${cid}')"><i class="bi bi-box-arrow-right"></i> Force Logout</button>
                    </div>
                </div>
            </div>`;
        grid.insertAdjacentHTML("beforeend", html);
    }

    // ----- Teacher control commands -----
    function lockPC(cid) { connection.invoke("LockStudent", cid); }
    function unlockPC(cid) { connection.invoke("UnlockStudent", cid); }
    function forceLogout(cid) { connection.invoke("ForceLogout", cid); }

    document.getElementById("btnBroadcast").addEventListener("click", () => {
        const activeImg = document.getElementById("img-" + activeTargetConnectionId);
        if (activeImg) {
            connection.invoke("BroadcastScreen", activeImg.src.split(",")[1]);
        } else {
            // Broadcast current frame from first student if present
            const first = document.querySelector(".stream-img:not(.d-none)");
            if (first) connection.invoke("BroadcastScreen", first.src.split(",")[1]);
        }
    });

    document.getElementById("btnNotify").addEventListener("click", () => {
        const msg = document.getElementById("notifMsg").value;
        if (!msg) return;
        connection.invoke("SendNotification", {
            type: document.getElementById("notifType").value,
            title: "Teacher notification",
            message: msg,
            timestamp: new Date()
        });
    });

    // ----- Remote control -----
    function openRemoteControl(cid, sid, pc) {
        activeTargetConnectionId = cid;
        document.getElementById("remoteModalTitle").innerText = `Remote Access - ${pc} (${sid})`;
        new bootstrap.Modal(document.getElementById("remoteControlModal")).show();
        canvas.focus();
    }
    function closeRemoteControl() { activeTargetConnectionId = null; }

    function sendInput(type, e) {
        if (!activeTargetConnectionId) return;
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width, scaleY = canvas.height / rect.height;
        const x = Math.round((e.clientX - rect.left) * scaleX), y = Math.round((e.clientY - rect.top) * scaleY);
        connection.invoke("SendRemoteInput", activeTargetConnectionId, { eventType: type, x, y, keyCode: e.button || 0, isShift: e.shiftKey });
    }

    canvas.addEventListener("mousemove", (e) => sendInput("mousemove", e));
    canvas.addEventListener("mousedown", (e) => sendInput("mousedown", e));
    canvas.addEventListener("mouseup", (e) => sendInput("mouseup", e));
    canvas.addEventListener("wheel", (e) => {
        if (!activeTargetConnectionId) return;
        connection.invoke("SendRemoteInput", activeTargetConnectionId, { eventType: "scroll", x: 0, y: 0, keyCode: e.deltaY > 0 ? 1 : -1, isShift: false });
        e.preventDefault();
    }, { passive: false });
    canvas.addEventListener("keydown", (e) => {
        if (!activeTargetConnectionId) return;
        if (e.key === "Escape") { closeRemoteControl(); bootstrap.Modal.getInstance(document.getElementById("remoteControlModal"))?.hide(); return; }
        connection.invoke("SendRemoteInput", activeTargetConnectionId, { eventType: "keydown", x: 0, y: 0, keyCode: e.keyCode, isShift: e.shiftKey });
        e.preventDefault();
    });
</script>