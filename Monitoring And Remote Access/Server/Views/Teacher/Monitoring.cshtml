@using Server.Extensions
@{
    ViewData["Title"] = "Live Monitoring Grid";
    Layout = "_TeacherLayout";
}

<section class="monitoring-dashboard">
    <div class="monitoring-heading">
        <div>
            <p class="monitoring-eyebrow">Computer account management system</p>
            <h2 class="page-title">Laboratory Control Panel</h2>
            <p class="text-muted small mb-0">Pardo Elementary School · Live workstation monitoring</p>
        </div>
        <div class="monitoring-session">
            <div><span class="monitoring-eyebrow">Session elapsed</span><strong id="lblSessionTimer" class="session-timer">00:00</strong></div>
            <div><span id="lblSessionState" class="small">Waiting for the server</span><a asp-action="Sessions" class="btn btn-outline-primary btn-sm d-block mt-2">Session controls <i class="bi bi-arrow-right"></i></a></div>
        </div>
    </div>
    <div id="hubError" class="alert alert-danger d-none" role="alert"></div>
    <div class="monitoring-metrics">
        <div class="metric-card"><div class="metric-title">Units online <i class="bi bi-wifi"></i></div><div id="lblConnectedCount" class="metric-value">0</div><p>Connected student PCs</p></div>
        <div class="metric-card"><div class="metric-title">Active students <i class="bi bi-activity"></i></div><div id="lblActiveCount" class="metric-value">0</div><p>Reporting activity</p></div>
        <div class="metric-card"><div class="metric-title">Idle units <i class="bi bi-clock"></i></div><div id="lblIdleCount" class="metric-value">0</div><p>Reported idle by the client</p></div>
        <div class="metric-card"><div class="metric-title">Restriction alerts <i class="bi bi-shield-exclamation"></i></div><div id="lblAlertCount" class="metric-value">0</div><p>Received while this page is open</p></div>
    </div>
    <div class="monitoring-layout">
        <section class="monitoring-stations" aria-labelledby="stationsTitle">
            <div class="monitoring-panel-heading">
                <div><h5 id="stationsTitle">Live station monitor</h5><p class="text-muted small mb-0">Select a station to view its screen and controls.</p></div>
                <div class="station-filters" role="group" aria-label="Station status">
                    <button type="button" class="btn active" data-station-filter="all" aria-pressed="true">All</button>
                    <button type="button" class="btn" data-station-filter="active" aria-pressed="false">Active</button>
                    <button type="button" class="btn" data-station-filter="idle" aria-pressed="false">Idle</button>
                    <button type="button" class="btn" data-station-filter="attention" aria-pressed="false">Alerts</button>
                </div>
            </div>
            <div class="monitoring-tools">
                <input type="search" id="gridSearch" aria-label="Filter workstations" class="form-control" placeholder="Search station or student…" />
                <button class="btn btn-outline-primary" onclick="openWarning(true)"><i class="bi bi-megaphone me-1"></i>Warn all</button>
                <button id="broadcastButton" class="btn btn-outline-warning" onclick="toggleBroadcast()"><i class="bi bi-broadcast me-1"></i>Broadcast screen</button>
                <button class="btn btn-outline-emerald" onclick="bulkCommand('BulkLockStudents', 'lock')">Lock visible</button>
                <button class="btn btn-outline-danger" onclick="bulkCommand('BulkForceLogoutStudents', 'log out')">Log out visible</button>
            </div>
            <div class="row g-3" id="workstationsGrid">
                <div class="col-12 text-center py-5 text-muted" id="emptyState"><i class="bi bi-display display-5 d-block mb-3"></i><h5>Waiting for student PCs</h5><p class="small">Stations appear here when students connect to CAMS.</p></div>
            </div>
            <p id="stationFilterEmpty" class="text-center text-muted py-4" hidden>No stations match these filters.</p>
            <div class="monitoring-panel-footer"><span id="lblVisibleCount">0 stations shown</span><span id="lblRemoteControlState">Not in control</span></div>
        </section>
        <aside class="monitoring-alerts" aria-labelledby="monitoringAlertsTitle">
            <div class="monitoring-panel-heading"><h5 id="monitoringAlertsTitle"><i class="bi bi-exclamation-triangle me-2"></i>Alerts</h5><a asp-action="Alerts" class="small">View history</a></div>
            <ul id="monitoringAlertFeed" class="list-unstyled" aria-live="polite"><li id="monitoringAlertsEmpty" class="text-muted small">No new alerts. Events received here will appear as they happen.</li></ul>
            <div class="monitoring-panel-heading"><h5>Recent commands</h5></div>
            <ul id="commandFeed" class="command-feed list-unstyled" aria-live="polite" aria-label="Recent workstation commands"></ul>
        </aside>
    </div>
</section>

<div class="modal fade" id="liveViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white surface-brand">
                <h5 class="modal-title fw-bold" id="liveViewTitle">Live workstation view</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-2 bg-black">
                <img id="liveViewImage" class="img-fluid" alt="Selected workstation screen" style="max-height: 78vh; object-fit: contain;" />
                <canvas id="remoteCanvas" class="img-fluid d-none" tabindex="0" aria-label="Authorized remote-support screen"></canvas>
            </div>
            <div class="modal-footer border-0 d-flex flex-wrap gap-2 align-items-center">
                <span class="small text-muted me-auto">Monitoring is view-only until a teacher explicitly issues a command.</span>
                <button type="button" id="remoteSupportButton" class="btn btn-sm btn-outline-warning rounded-pill" onclick="toggleRemoteSupport()">Start Remote Support</button>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="openWarning(false)">Send Warning</button>
                <button type="button" class="btn btn-sm btn-outline-emerald rounded-pill" onclick="sendWorkstationCommand('LockStudent')">Lock</button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="sendWorkstationCommand('UnlockStudent')">Unlock</button>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="sendWorkstationCommand('RestartStudent', true)">Restart</button>
                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" onclick="sendWorkstationCommand('ShutdownStudent', true)">Shutdown</button>
                <button type="button" class="btn btn-sm btn-danger rounded-pill" onclick="sendWorkstationCommand('ForceLogout', true)">Log out</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="warningModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Send Student Warning</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body">
            <input type="hidden" id="warningTarget" />
            <label class="form-label" for="warningTitle">Title</label><input id="warningTitle" class="form-control mb-3" maxlength="120" value="Teacher Warning" />
            <label class="form-label" for="warningMessage">Message</label><textarea id="warningMessage" class="form-control" maxlength="1000" rows="4" required></textarea>
        </div>
        <div class="modal-footer"><button class="btn btn-primary" onclick="sendWarning()">Send Warning</button></div>
    </div></div>
</div>

@section Scripts {
    @* How each collector mode should read to a teacher. Server-owned so the
       live tiles and the history page describe a state the same way. *@
    <script type="application/json" id="browserModeLabels">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(BrowserMonitoringDisplay.ForScript()))</script>
    <script src="~/js/teacher-monitoring.js" asp-append-version="true"></script>
}
