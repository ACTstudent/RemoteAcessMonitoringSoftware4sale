@using Server.Extensions
@{
    ViewData["Title"] = "Live Monitoring Grid";
    Layout = "_TeacherLayout";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary"><i class="bi bi-camera-video-fill fs-3"></i></div>
        <div>
            <h2 class="page-title">Live Workstation Monitoring</h2>
            <p class="text-muted mb-0 small">Global live feeds and remote operations for every authenticated student workstation</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary rounded-pill px-3" onclick="openWarning(true)"><i class="bi bi-megaphone-fill me-1"></i> Warn all</button>
        <button id="broadcastButton" class="btn btn-outline-warning rounded-pill px-3" onclick="toggleBroadcast()"><i class="bi bi-broadcast me-1"></i> Broadcast screen</button>
        <button class="btn btn-outline-emerald rounded-pill px-3" onclick="bulkCommand('BulkLockStudents', 'lock')"><i class="bi bi-lock-fill me-1"></i> Lock visible</button>
        <button class="btn btn-outline-danger rounded-pill px-3" onclick="bulkCommand('BulkForceLogoutStudents', 'log out')"><i class="bi bi-power me-1"></i> Log out visible</button>
    </div>
</div>

<div id="hubError" class="alert alert-danger d-none rounded-3" role="alert"></div>

<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <div class="row g-3 align-items-center">
        <div class="col-md-3 col-sm-6">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success rounded-circle p-2"></span>
                <span class="fw-bold text-dark small">Status: <span id="lblSessionState" class="text-success">Connecting</span></span>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-muted"></i>
                <span class="fw-bold text-dark small">Session Timer: <span id="lblSessionTimer" class="session-timer fs-5">00:00</span></span>
            </div>
        </div>
        <div class="col-md-4 col-sm-8">
            <div class="search-input-wrapper">
                <input type="text" id="gridSearch" aria-label="Filter workstations" class="form-control filter-control search-input py-1.5" placeholder="Filter workstations..." />
                <i class="bi bi-search search-icon text-muted"></i>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 text-end">
            <span class="badge bg-light text-dark font-monospace border py-2 px-3 rounded-pill" id="lblConnectedCount">0 Units Active</span>
        </div>
    </div>
</div>

<div class="row g-4" id="workstationsGrid">
    <div class="col-12 text-center py-5 text-muted" id="emptyState">
        <i class="bi bi-display-slash display-3 d-block opacity-50 mb-3 text-emerald-800"></i>
        <h5 class="fw-bold">Awaiting Workstation Connections...</h5>
        <p class="small">Authenticated student clients will appear here when they connect.</p>
    </div>
</div>

<div class="modal fade" id="liveViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white surface-brand">
                <h5 class="modal-title fw-bold" id="liveViewTitle">Live workstation view</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-2 bg-black">
                <img id="liveViewImage" class="img-fluid" alt="Selected workstation screen" style="max-height: 78vh; object-fit: contain;" />
                <canvas id="remoteCanvas" class="img-fluid d-none" tabindex="0" aria-label="Authorized remote-support screen"></canvas>
            </div>
            <div class="modal-footer border-0 d-flex flex-wrap gap-2 align-items-center">
                <span class="small text-muted me-auto">Monitoring is view-only until a teacher explicitly issues a command.</span>
                <button type="button" id="remoteSupportButton" class="btn btn-sm btn-outline-warning rounded-pill" onclick="toggleRemoteSupport()">Start Remote Support</button>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="openWarning(false)">Send Warning</button>
                <button type="button" class="btn btn-sm btn-outline-emerald rounded-pill" onclick="sendWorkstationCommand('LockStudent')">Lock</button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="sendWorkstationCommand('UnlockStudent')">Unlock</button>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="sendWorkstationCommand('RestartStudent', true)">Restart</button>
                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" onclick="sendWorkstationCommand('ShutdownStudent', true)">Shutdown</button>
                <button type="button" class="btn btn-sm btn-danger rounded-pill" onclick="sendWorkstationCommand('ForceLogout', true)">Log out</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="warningModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Send Student Warning</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body">
            <input type="hidden" id="warningTarget" />
            <label class="form-label" for="warningTitle">Title</label><input id="warningTitle" class="form-control mb-3" maxlength="120" value="Teacher Warning" />
            <label class="form-label" for="warningMessage">Message</label><textarea id="warningMessage" class="form-control" maxlength="1000" rows="4" required></textarea>
        </div>
        <div class="modal-footer"><button class="btn btn-primary" onclick="sendWarning()">Send Warning</button></div>
    </div></div>
</div>

@section Scripts {
    @* How each collector mode should read to a teacher. Server-owned so the
       live tiles and the history page describe a state the same way. *@
    <script type="application/json" id="browserModeLabels">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(BrowserMonitoringDisplay.ForScript()))</script>
    <script src="~/js/teacher-monitoring.js" asp-append-version="true"></script>
}
