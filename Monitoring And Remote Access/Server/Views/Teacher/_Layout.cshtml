@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CAMS Teacher</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background-color: #12141a; color: #e6e6e6; }
        .card { background-color: #1c1f27; border: 1px solid #2a2e38; }
        .card-header { background-color: #232733; border-bottom: 1px solid #2a2e38; }
        .table { color: #e6e6e6; --bs-table-bg: transparent; }
        .table thead th { color: #9aa0b0; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }
        .nav-link { color: #b6bac6; }
        .nav-link.active { background-color: #3b82f6; color: #fff; }
        .nav-link:hover { color: #fff; }
        .stat { font-size: 1.6rem; font-weight: 700; }
        .stream-img { height: 140px; width: 100%; object-fit: contain; background-color: #000; }
        .placeholder-box { height: 140px; width: 100%; display: flex; align-items: center; justify-content: center; background: repeating-linear-gradient(45deg, #1c1f27, #1c1f27 10px, #21242e 10px, #21242e 20px); color: #5a6072; font-size: 0.85rem; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark navbar-expand-lg" style="background-color:#1a1d24;">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/Teacher/Dashboard"><i class="bi bi-person-workspace"></i> CAMS Teacher</a>
            <div class="d-flex align-items-center gap-2 text-light">
                <span class="small">@ViewContext.HttpContext.Session.GetString("TeacherName")</span>
                <a href="/Account/Logout" class="btn btn-sm btn-outline-danger">Logout</a>
            </div>
        </div>
    </nav>
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-2 col-md-3 pt-3">
                <ul class="nav nav-pills flex-column gap-1">
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" href="/Teacher/Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Sessions" ? "active" : "")" href="/Teacher/Sessions"><i class="bi bi-play-circle"></i> Session Management</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Monitoring" ? "active" : "")" href="/Teacher/Monitoring"><i class="bi bi-camera-video"></i> Live Monitoring</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Restrictions" ? "active" : "")" href="/Teacher/Restrictions"><i class="bi bi-slash-circle"></i> Access Restrictions</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Records" ? "active" : "")" href="/Teacher/Records"><i class="bi bi-journal"></i> Classroom Records</a></li>
                </ul>
            </div>
            <div class="col-lg-10 col-md-9 pt-3 pb-5">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>