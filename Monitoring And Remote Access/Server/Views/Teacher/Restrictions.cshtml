@using Microsoft.AspNetCore.Html
@model Server.Models.PolicyManagementViewModel
@{
    ViewData["Title"] = "Access Restrictions";
    Layout = "_TeacherLayout";
    var teacherId = (int)ViewBag.TeacherId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-extrabold mb-0 text-dark">Session Restriction Policies</h2>
        <p class="text-muted mb-0 small">Your rules are delivered only to students in your active sessions. Administrator global rules remain read-only.</p>
    </div>
    <button class="btn btn-sm btn-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#ruleModal">Add Session Rule</button>
</div>

@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
<div class="card border-0 shadow-sm rounded-4 p-3">
    <div class="table-responsive">
        <table class="table custom-table">
            <thead><tr><th>Scope</th><th>Type / Target</th><th>Mode</th><th>State</th><th></th></tr></thead>
            <tbody>
            @foreach (var rule in Model.Restrictions)
            {
                var owned = rule.TeacherId == teacherId;
                <tr>
                    <td><span class="badge @(owned ? "bg-primary" : "bg-dark")">@(owned ? "My sessions" : "Administrator global")</span></td>
                    <td><span class="badge bg-secondary">@rule.RuleType</span><br /><code>@rule.Target</code><small class="d-block text-muted">@rule.Description</small></td>
                    <td>@rule.Mode</td>
                    <td>@(rule.IsActive ? "Enabled" : "Disabled")</td>
                    <td class="text-end">
                    @if (owned)
                    {
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editRule-@rule.RestrictionRuleId">Edit</button>
                        <form class="d-inline" method="post" asp-action="DeleteRestriction" onsubmit="return confirm('Delete this rule?');">
                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@rule.RestrictionRuleId" /><button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                    </td>
                </tr>
            }
            @if (!Model.Restrictions.Any()) { <tr><td colspan="5" class="text-muted text-center">No rules configured.</td></tr> }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="ruleModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post" asp-action="CreateRestriction">@Html.AntiForgeryToken()<div class="modal-header"><h5>Add Session Rule</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">@RuleFields(null)</div><div class="modal-footer"><button class="btn btn-emerald">Save</button></div></form></div></div></div>
@foreach (var rule in Model.Restrictions.Where(rule => rule.TeacherId == teacherId))
{
    <div class="modal fade" id="editRule-@rule.RestrictionRuleId" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post" asp-action="UpdateRestriction">@Html.AntiForgeryToken()<input type="hidden" name="RestrictionRuleId" value="@rule.RestrictionRuleId" /><div class="modal-header"><h5>Edit Session Rule</h5></div><div class="modal-body">@RuleFields(rule)</div><div class="modal-footer"><button class="btn btn-emerald">Save</button></div></form></div></div></div>
}

@functions {
    public IHtmlContent RuleFields(Server.Models.RestrictionRule? rule) => new HtmlString($"<label>Type</label><select name='RuleType' class='form-select mb-2'><option {(rule?.RuleType == "Application" ? "selected" : "")}>Application</option><option {(rule?.RuleType == "Website" ? "selected" : "")}>Website</option></select><label>Mode</label><select name='Mode' class='form-select mb-2'><option {(rule?.Mode != "Allow" ? "selected" : "")}>Block</option><option {(rule?.Mode == "Allow" ? "selected" : "")}>Allow</option></select><label>Target or wildcard</label><input required name='Target' value='{System.Net.WebUtility.HtmlEncode(rule?.Target)}' class='form-control mb-2' maxlength='200' placeholder='chrome* or example.com' /><label>Description</label><input name='Description' value='{System.Net.WebUtility.HtmlEncode(rule?.Description)}' class='form-control mb-2' maxlength='500' /><label><input type='checkbox' name='IsActive' value='true' {(rule?.IsActive != false ? "checked" : "")} /> Active</label>");
}
