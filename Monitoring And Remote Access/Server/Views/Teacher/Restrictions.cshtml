@using Microsoft.AspNetCore.Html
@model Server.Models.PolicyManagementViewModel
@{
    ViewData["Title"] = "Access Restrictions";
    Layout = "_TeacherLayout";
    var teacherId = (int)ViewBag.TeacherId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary"><i class="bi bi-shield-check fs-3" aria-hidden="true"></i></div>
        <div>
            <h2 class="page-title">Session Restriction Policies</h2>
            <p class="text-muted mb-0 small">Your rules apply to your active sessions. Administrator global rules are read-only.</p>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="metric-card d-flex justify-content-between align-items-center"><div><div class="metric-title">Total Rules</div><div class="metric-value">@Model.Restrictions.Count</div></div><div class="metric-icon-box"><i class="bi bi-shield-check fs-3" aria-hidden="true"></i></div></div></div>
    <div class="col-md-4"><div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center"><div><div class="metric-title">Active Rules</div><div class="metric-value">@Model.Restrictions.Count(rule => rule.IsActive)</div></div><div class="metric-icon-box"><i class="bi bi-check-circle fs-3" aria-hidden="true"></i></div></div></div>
    <div class="col-md-4"><div class="metric-card d-flex justify-content-between align-items-center"><div><div class="metric-title">Inactive Rules</div><div class="metric-value">@Model.Restrictions.Count(rule => !rule.IsActive)</div></div><div class="metric-icon-box"><i class="bi bi-pause-circle fs-3" aria-hidden="true"></i></div></div></div>
</div>

<div class="card crud-panel border-0 shadow-sm rounded-4" data-crud-list data-crud-label="restriction rules" data-crud-page-size="6">
    <div class="crud-toolbar">
        <input type="search" class="form-control crud-search" data-crud-search aria-label="Search restriction rules" placeholder="Search restriction rule..." />
        <select class="form-select" data-crud-filter="status" aria-label="Filter restriction rules by status"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option></select>
        <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#ruleModal"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Session Rule</button>
    </div>
    <div class="table-responsive">
        <table class="table custom-table align-middle mb-0">
            <thead><tr><th>Scope</th><th>Type / Target</th><th>Mode</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var rule in Model.Restrictions)
            {
                var owned = rule.TeacherId == teacherId;
                <tr data-crud-item data-status="@(rule.IsActive ? "Active" : "Inactive")">
                    <td><span class="badge @(owned ? "bg-primary" : "bg-dark")">@(owned ? "My sessions" : "Administrator global")</span></td>
                    <td><span class="badge bg-secondary">@rule.RuleType</span><br /><code>@rule.Target</code><small class="d-block text-muted">@rule.Description</small></td>
                    <td>@rule.Mode</td>
                    <td><span class="badge @(rule.IsActive ? "bg-success" : "bg-secondary")">@(rule.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="text-end">
                    @if (owned)
                    {
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editRule-@rule.RestrictionRuleId">Edit</button>
                        <form class="d-inline" method="post" asp-action="DeleteRestriction" data-confirm="Delete this restriction rule?" data-confirm-title="Delete rule" data-confirm-label="Delete">
                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@rule.RestrictionRuleId" /><button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                    </td>
                </tr>
            }
            @if (!Model.Restrictions.Any()) { <tr><td colspan="5" class="text-center empty-state"><i class="bi bi-shield-check empty-state-icon" aria-hidden="true"></i><span class="empty-state-message">No rules configured.</span></td></tr> }
            </tbody>
        </table>
    </div>
    <div class="crud-no-results" data-crud-empty hidden>No restriction rules match your search.</div>
    <div class="crud-footer" data-crud-pagination></div>
</div>

<div class="modal fade" id="ruleModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post" asp-action="CreateRestriction">@Html.AntiForgeryToken()<div class="modal-header"><h5>Add Session Rule</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body">@RuleFields(null, "new")</div><div class="modal-footer"><button class="btn btn-emerald">Save</button></div></form></div></div></div>
@foreach (var rule in Model.Restrictions.Where(rule => rule.TeacherId == teacherId))
{
    <div class="modal fade" id="editRule-@rule.RestrictionRuleId" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post" asp-action="UpdateRestriction">@Html.AntiForgeryToken()<input type="hidden" name="RestrictionRuleId" value="@rule.RestrictionRuleId" /><div class="modal-header"><h5>Edit Session Rule</h5></div><div class="modal-body">@RuleFields(rule, rule.RestrictionRuleId.ToString())</div><div class="modal-footer"><button class="btn btn-emerald">Save</button></div></form></div></div></div>
}

@functions {
    // Rendered twice - once empty for "add" and once per rule for "edit" - so
    // every id carries a scope. Without it the two dialogs would share ids and
    // every label would point at whichever field the browser saw first.
    public IHtmlContent RuleFields(Server.Models.RestrictionRule? rule, string scope)
    {
        string Id(string field) => $"rule-{field}-{scope}";
        var target = System.Net.WebUtility.HtmlEncode(rule?.Target);
        var description = System.Net.WebUtility.HtmlEncode(rule?.Description);
        return new HtmlString(
            $"<label for='{Id("type")}'>Type</label>" +
            $"<select id='{Id("type")}' name='RuleType' class='form-select mb-2'>" +
            $"<option {(rule?.RuleType == "Application" ? "selected" : "")}>Application</option>" +
            $"<option {(rule?.RuleType == "Website" ? "selected" : "")}>Website</option></select>" +
            $"<label for='{Id("mode")}'>Mode</label>" +
            $"<select id='{Id("mode")}' name='Mode' class='form-select mb-2'>" +
            $"<option {(rule?.Mode != "Allow" ? "selected" : "")}>Block</option>" +
            $"<option {(rule?.Mode == "Allow" ? "selected" : "")}>Allow</option></select>" +
            $"<label for='{Id("target")}'>Target or wildcard</label>" +
            $"<input id='{Id("target")}' required name='Target' value='{target}' class='form-control mb-2' maxlength='200' placeholder='chrome* or example.com' />" +
            $"<label for='{Id("description")}'>Description</label>" +
            $"<input id='{Id("description")}' name='Description' value='{description}' class='form-control mb-2' maxlength='500' />" +
            $"<label for='{Id("active")}'><input type='checkbox' id='{Id("active")}' name='IsActive' value='true' {(rule?.IsActive != false ? "checked" : "")} /> Active</label>");
    }
}
