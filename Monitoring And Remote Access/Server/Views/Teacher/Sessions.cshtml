@model IEnumerable<Server.Models.LabSession>
@{
    ViewData["Title"] = "Session Control";
    Layout = "_TeacherLayout";

    var activeSessions = Model.Count(s => s.Status == "Running");
    var pausedSessions = Model.Count(s => s.Status == "Paused");
    var totalSessions = Model.Count();
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-play-circle-fill fs-3"></i>
        </div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">Session Control</h2>
            <p class="text-muted mb-0 small">Manage timed 45-minute laboratory sessions, pause/resume, and attendance</p>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 justify-content-end">
        <form asp-action="GlobalStartSession" method="post">@Html.AntiForgeryToken()<button class="btn btn-success rounded-pill px-3" onclick="return confirm('Resume every paused session across CAMS?');"><i class="bi bi-play-fill"></i> Resume All Sessions</button></form>
        <form asp-action="GlobalPauseSession" method="post">@Html.AntiForgeryToken()<button class="btn btn-warning rounded-pill px-3" onclick="return confirm('Pause every lab session whose rule permits pausing?');"><i class="bi bi-pause-fill"></i> Pause All Sessions</button></form>
        <form asp-action="GlobalEndSession" method="post">@Html.AntiForgeryToken()<button class="btn btn-danger rounded-pill px-3" onclick="return confirm('End every active lab session? Ended sessions cannot be resumed.');"><i class="bi bi-stop-fill"></i> End All Sessions</button></form>
        <button class="btn btn-emerald rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#startSessionModal">
            <i class="bi bi-play-circle me-1"></i> Start New Session
        </button>
    </div>
</div>

<!-- Metric Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Active Running Sessions</div>
                <div class="metric-value text-success">@activeSessions</div>
            </div>
            <div class="metric-icon-box bg-success text-white">
                <i class="bi bi-play-circle-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Paused Sessions</div>
                <div class="metric-value text-warning">@pausedSessions</div>
            </div>
            <div class="metric-icon-box bg-warning text-dark">
                <i class="bi bi-pause-circle-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Lab Logs</div>
                <div class="metric-value text-dark">@totalSessions</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-journal-text fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Active & Recent Sessions Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Session History & Live Log</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@totalSessions Recorded</span>
    </div>
    <div class="table-responsive">
        <table class="table custom-table mb-0">
            <thead>
                <tr>
                    <th>Session ID</th>
                    <th>Student Name</th>
                    <th>Station Name</th>
                    <th>Start Time</th>
                    <th>Status</th>
                    <th>Duration</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted font-monospace">#SES-@s.Id.ToString("D4")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar-circle" style="width: 30px; height: 30px; font-size: 0.8rem;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="fw-bold text-dark">@(s.Student?.Username ?? "?")</span>
                            </div>
                        </td>
                        <td class="font-monospace fw-semibold text-emerald-700">
                            <i class="bi bi-pc-display me-1"></i> @(s.Computer?.LaboratoryStation ?? s.PCName)
                        </td>
                        <td>@s.StartTime.ToString("MMM dd, hh:mm tt")</td>
                        <td>
                            @if (s.Status == "Running")
                            {
                                <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-play-circle-fill me-1"></i> Running</span>
                            }
                            else if (s.Status == "Paused")
                            {
                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="bi bi-pause-circle-fill me-1"></i> Paused</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill px-3 py-1">Ended</span>
                            }
                        </td>
                        <td>@(s.EndTime.HasValue ? Math.Round((s.EndTime.Value - s.StartTime).TotalMinutes).ToString() + " min" : s.Status == "Running" ? "Active" : "-")</td>
                        <td>
                            <div class="d-flex justify-content-end gap-1">
                                @if (s.Status != "Ended")
                                {
                                    <form method="post" action="/Teacher/TogglePause" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <button class="btn btn-sm @(s.Status == "Paused" ? "btn-emerald" : "btn-outline-warning") rounded-pill px-3 me-1">
                                            @(s.Status == "Paused" ? "Resume" : "Pause")
                                        </button>
                                    </form>
                                    <form method="post" action="/Teacher/EndSession" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3">End</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No session logs found. Click "Start New Session" above.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Start Session -->
<div class="modal fade" id="startSessionModal" tabindex="-1" aria-labelledby="startSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                <h5 class="modal-title fw-bold" id="startSessionModalLabel">
                    <i class="bi bi-play-circle me-2"></i> Start Laboratory Session
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Teacher/StartSession">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Select Student <span class="text-danger">*</span></label>
                        <select name="studentId" class="form-select filter-control" required>
                            <option value="" disabled selected>-- Select Student --</option>
                            @foreach (var s in ViewBag.Students)
                            {
                                <option value="@s.Id">@s.Username - @s.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Assigned Workstation (Optional)</label>
                        <select name="computerId" class="form-select filter-control">
                            <option value="" selected>-- Auto / No station --</option>
                            @foreach (var c in ViewBag.Computers)
                            {
                                <option value="@c.ComputerId">@c.LaboratoryStation</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Session Policy Rule</label>
                        <select name="sessionRuleId" class="form-select filter-control">
                            <option value="" selected>Default 45-minute rule</option>
                            @foreach (var r in ViewBag.SessionRules)
                            {
                                <option value="@r.SessionRuleId">@r.Name (@r.MaxDurationMinutes min)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Start Session</button>
                </div>
            </form>
        </div>
    </div>
</div>
