@model Server.Models.Class
@using Server.Models
@{
    ViewData["Title"] = "Class Details - " + Model.ClassName;
    Layout = "_TeacherLayout";
    var roster = Model.ClassStudents.Where(cs => cs.Student != null).OrderBy(cs => cs.Student!.LastName).ThenBy(cs => cs.Student!.FirstName).ToList();
    var students = ViewBag.AllStudents as IEnumerable<Student> ?? Enumerable.Empty<Student>();
    var availableStudents = students.Where(s => !roster.Any(r => r.StudentId == s.Id)).ToList();
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <a asp-controller="Teacher" asp-action="Classes" class="btn btn-outline-emerald btn-sm rounded-pill mb-3 px-3"><i class="bi bi-arrow-left me-1"></i>Back to classes</a>
        <p class="section-kicker text-uppercase text-muted small fw-bold mb-1">Class Details</p>
        <h2 class="fw-extrabold mb-1 text-dark">@Model.ClassName</h2>
        <p class="text-muted mb-0 small">@Model.Section · @Model.GradeLevel · @Model.Subject</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="badge @(Model.IsArchived ? "bg-secondary" : "badge-active") fs-6 px-3 py-2">@(Model.IsArchived ? "Archived" : "Active")</span>
        <form method="post" asp-controller="Teacher" asp-action="ArchiveClass" class="m-0"><input type="hidden" name="id" value="@Model.ClassId" />@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-secondary rounded-pill">@(Model.IsArchived ? "Restore" : "Archive")</button></form>
        <form method="post" asp-controller="Teacher" asp-action="DeleteClass" class="m-0" data-confirm="Delete this class and its enrollment links? Student accounts will be preserved." data-confirm-title="Delete class" data-confirm-label="Delete"><input type="hidden" name="classId" value="@Model.ClassId" />@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-danger rounded-pill">Delete</button></form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3 col-sm-6"><div class="metric-card"><div class="metric-title">Teacher</div><div class="metric-value fs-5">@(Model.Teacher == null ? "Unassigned" : $"{Model.Teacher.FirstName} {Model.Teacher.LastName}")</div></div></div>
    <div class="col-md-3 col-sm-6"><div class="metric-card"><div class="metric-title">Academic Year</div><div class="metric-value fs-5">@Model.AcademicYear</div></div></div>
    <div class="col-md-3 col-sm-6"><div class="metric-card metric-card-emerald"><div class="metric-title">Students</div><div class="metric-value fs-5 text-success">@roster.Count</div></div></div>
    <div class="col-md-3 col-sm-6"><div class="metric-card"><div class="metric-title">Schedule</div><div class="metric-value fs-6">@(string.IsNullOrWhiteSpace(Model.Schedule) ? "Flexible" : Model.Schedule)</div></div></div>
</div>

<div class="crud-panel" data-crud-list data-crud-label="enrolled students" data-crud-page-size="6">
<div class="crud-toolbar"><label class="visually-hidden" for="rosterSearch">Search enrolled students</label><input id="rosterSearch" type="search" class="form-control crud-search" data-crud-search placeholder="Search enrolled students..." aria-label="Search enrolled students" />
<span class="small text-muted ms-auto">@roster.Count enrolled</span></div>
    <div class="table-responsive"><table class="table custom-table align-middle mb-0"><thead><tr><th>Student ID</th><th>Full Name</th><th>Username</th><th>Date Enrolled</th><th class="text-end">Actions</th></tr></thead><tbody>
        @foreach (var membership in roster)
        {
            <tr data-crud-item><td class="fw-bold text-muted font-monospace">@membership.Student!.StudentNumber</td><td><div class="d-flex align-items-center gap-2"><div class="user-avatar-circle" style="width:32px;height:32px;font-size:.85rem;"><i class="bi bi-person-fill"></i></div><span class="fw-bold text-dark">@membership.Student.FullName</span></div></td><td class="font-monospace text-emerald-700">&#64;@membership.Student.Username</td><td>@membership.EnrolledAt.ToDisplayLocal().ToString("MMM dd, yyyy")</td><td class="text-end"><form method="post" asp-controller="Teacher" asp-action="RemoveStudent" class="m-0" data-confirm="Remove this student from the class? The account will be preserved." data-confirm-title="Remove student" data-confirm-label="Remove"><input type="hidden" name="classId" value="@Model.ClassId" /><input type="hidden" name="studentId" value="@membership.StudentId" />@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="bi bi-person-x me-1"></i>Remove</button></form></td></tr>
        }
        @if (roster.Count == 0)
        {
            <tr><td colspan="5" class="text-center empty-state"><i class="bi bi-mortarboard empty-state-icon" aria-hidden="true"></i><span class="empty-state-message">No students are enrolled in this class yet.</span></td></tr>
        }
    </tbody></table></div>
<div class="crud-no-results" data-crud-empty hidden></div>
<div class="crud-footer" data-crud-pagination></div>
</div>

@if (!Model.IsArchived)
{
<div class="row g-3">
    <div class="col-lg-4">
        <div class="action-card">
            <div>
                <i class="bi bi-person-plus-fill fs-3"></i>
                <h5 class="fw-bold mt-2 mb-1">Create students</h5>
                <p class="text-muted small mb-0">Add one account, or several at once.</p>
            </div>
            <button class="btn btn-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#createStudentForClassModal">Create</button>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="action-card">
            <div>
                <i class="bi bi-person-check-fill fs-3"></i>
                <h5 class="fw-bold mt-2 mb-1">Enroll students</h5>
                <p class="text-muted small mb-0">Enroll one existing student, or many.</p>
            </div>
            <button class="btn btn-outline-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#enrollStudentModal">Enroll</button>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="action-card">
            <div>
                <i class="bi bi-filetype-csv fs-3"></i>
                <h5 class="fw-bold mt-2 mb-1">Import from CSV</h5>
                <p class="text-muted small mb-0">Upload a roster file to add students.</p>
            </div>
            <button class="btn btn-outline-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#importStudentsModal">Import</button>
        </div>
    </div>
</div>
}

@if (!Model.IsArchived)
{
<div class="modal fade" id="createStudentForClassModal" tabindex="-1" aria-labelledby="createStudentForClassModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header modal-header-themed">
                <h5 class="modal-title" id="createStudentForClassModalLabel"><i class="bi bi-person-plus-fill me-2"></i>Create students</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul class="nav segmented-tabs mb-4" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#createSinglePane" type="button" role="tab">One student</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#createBulkPane" type="button" role="tab">Bulk students</button>
                    </li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="createSinglePane" role="tabpanel">
                        <form method="post" asp-controller="Teacher" asp-action="AddStudentToClass">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="classId" value="@Model.ClassId" />
                            <p class="text-muted small">The new account joins @Model.ClassName immediately.</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="teacher-classdetails-first-name">First name</label>
                                    <input id="teacher-classdetails-first-name" name="firstName" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="teacher-classdetails-last-name">Last name</label>
                                    <input id="teacher-classdetails-last-name" name="lastName" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="teacher-classdetails-username">Username <span class="text-muted">(optional)</span></label>
                                    <input id="teacher-classdetails-username" name="username" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="teacher-classdetails-password">Password</label>
                                    <input id="teacher-classdetails-password" name="password" type="password" minlength="8" class="form-control" required />
                                </div>
                            </div>
                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-emerald rounded-pill px-4">Create and enroll</button>
                            </div>
                        </form>
                    </div>
                    <div class="tab-pane fade" id="createBulkPane" role="tabpanel">
                        <form method="post" asp-controller="Teacher" asp-action="BulkAddStudents">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="classId" value="@Model.ClassId" />
                            <p class="text-muted small">Every filled row needs a first name, last name, and a password of at least eight characters.</p>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead><tr><th>First</th><th>Last</th><th>Username</th><th>Password</th></tr></thead>
                                    <tbody id="teacherClassBulkRows">
                                        <tr>
                                            <td><input aria-label="First name" name="bulkFirstNames" class="form-control form-control-sm" /></td>
                                            <td><input aria-label="Last name" name="bulkLastNames" class="form-control form-control-sm" /></td>
                                            <td><input aria-label="Username (optional)" name="bulkUserNames" class="form-control form-control-sm" /></td>
                                            <td><input aria-label="Password" name="bulkPasswords" type="password" minlength="8" class="form-control form-control-sm" /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <button type="button" class="btn btn-outline-emerald rounded-pill px-4 mt-3" data-bulk-add="#teacherClassBulkRows"><i class="bi bi-plus-lg me-1"></i>Add more rows</button>
                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-emerald rounded-pill px-4">Add filled rows</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="enrollStudentModal" tabindex="-1" aria-labelledby="enrollStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header modal-header-themed">
                <h5 class="modal-title" id="enrollStudentModalLabel"><i class="bi bi-person-check-fill me-2"></i>Enroll students</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul class="nav segmented-tabs mb-4" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#enrollSinglePane" type="button" role="tab">One student</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#enrollBulkPane" type="button" role="tab">Bulk enroll</button>
                    </li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="enrollSinglePane" role="tabpanel">
                        <form method="post" asp-controller="Teacher" asp-action="EnrollStudent" id="existingStudentForm"
                              data-move-confirm data-move-target="@Model.ClassName">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="classId" value="@Model.ClassId" />
                            <input type="hidden" name="moveStudent" id="moveStudent" value="false" data-move-flag />
                            <p class="text-muted small">Moving a student from another class requires confirmation.</p>
                            <label class="form-label" for="existingStudentSelect">Registered student</label>
                            <select name="studentId" id="existingStudentSelect" class="form-select" required data-move-select>
                                <option value="">Select a student</option>
                                @foreach (var student in availableStudents)
                                {
                                    <option value="@student.Id" data-current-class="@(student.ClassId.HasValue ? student.Class?.ClassName : "")">@student.StudentNumber - @student.FullName (&#64;@student.Username)</option>
                                }
                            </select>
                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-emerald rounded-pill px-4">Enroll student</button>
                            </div>
                        </form>
                    </div>
                    <div class="tab-pane fade" id="enrollBulkPane" role="tabpanel">
                        @if (!availableStudents.Any())
                        {
                            <p class="text-muted text-center py-4 mb-0">Every registered student is already enrolled in this class.</p>
                        }
                        else
                        {
                            <form method="post" asp-controller="Teacher" asp-action="EnrollStudents">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="classId" value="@Model.ClassId" />
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                    <label class="form-label mb-0">Select students to enroll</label>
                                    <button type="button" class="btn btn-sm btn-outline-emerald rounded-pill px-3" data-check-all="#enrollBulkList">Select all</button>
                                </div>
                                <input aria-label="Search by name, ID, or username" type="search" class="form-control mb-3" placeholder="Search by name, ID, or username" data-filter-list="#enrollBulkList" />
                                <div id="enrollBulkList" class="border rounded-3 p-2 bulk-select-list">
                                    @foreach (var student in availableStudents)
                                    {
                                        <label class="d-flex align-items-center gap-2 py-2 px-2 rounded-3 bulk-select-item">
                                            <input class="form-check-input m-0 flex-shrink-0" type="checkbox" name="studentIds" value="@student.Id" />
                                            <span class="fw-semibold text-dark">@student.FullName</span>
                                            <span class="text-muted small font-monospace">@student.StudentNumber</span>
                                            @if (student.ClassId.HasValue)
                                            {
                                                <span class="badge bg-light text-dark ms-auto">@student.Class?.ClassName</span>
                                            }
                                        </label>
                                    }
                                </div>
                                <div class="form-check mt-3">
                                    <input class="form-check-input" type="checkbox" name="moveStudent" value="true" id="bulkMoveStudent" />
                                    <label class="form-check-label small" for="bulkMoveStudent">Move students who already belong to another class</label>
                                </div>
                                <div class="d-flex justify-content-end gap-2 mt-4">
                                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-emerald rounded-pill px-4">Enroll selected</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="importStudentsModal" tabindex="-1" aria-labelledby="importStudentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-header-themed">
                <h5 class="modal-title" id="importStudentsModalLabel"><i class="bi bi-filetype-csv me-2"></i>Import from CSV</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" enctype="multipart/form-data" asp-controller="Teacher" asp-action="BulkPreviewCsv">
                @Html.AntiForgeryToken()
                <input type="hidden" name="classId" value="@Model.ClassId" />
                <div class="modal-body">
                    <label class="form-label" for="teacher-classdetails-roster-file">Roster file</label>
                    <input id="teacher-classdetails-roster-file" type="file" name="file" accept=".csv,text/csv" class="form-control" required />
                    <div class="form-text">Columns: student number, first name, last name, full name, username, password.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4">Preview CSV</button>
                </div>
            </form>
        </div>
    </div>
</div>
}

@section Scripts {
    <script src="~/js/student-move-confirm.js" asp-append-version="true"></script>
}
