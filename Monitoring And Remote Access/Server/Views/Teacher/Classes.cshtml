@model IEnumerable<Server.Models.Class>
@{
    ViewData["Title"] = "Class Management";
    Layout = "_TeacherLayout";

    var totalClasses = Model.Count();
    var activeClasses = Model.Count(c => !c.IsArchived);
    var archivedClasses = Model.Count(c => c.IsArchived);
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-folder-symlink-fill fs-3"></i>
        </div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">Class Management</h2>
            <p class="text-muted mb-0 small">Manage advisory and instructor class sections</p>
        </div>
    </div>
    <button class="btn btn-emerald rounded-pill px-4 py-2 fw-semibold shadow-sm text-white" data-bs-toggle="modal" data-bs-target="#createClassModal">
        <i class="bi bi-plus-circle-fill me-1"></i> Create Class
    </button>
</div>

<!-- Summary Metric Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Advisory Classes</div>
                <div class="metric-value">@totalClasses</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-folder-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Active Classes</div>
                <div class="metric-value text-success">@activeClasses</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-folder-check-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Archived Classes</div>
                <div class="metric-value text-muted">@archivedClasses</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-archive-fill fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Class Section Cards Grid -->
<div class="row g-4 mb-4">
    @foreach (var c in Model.Where(c => !c.IsArchived))
    {
        <div class="col-md-4 col-sm-6">
            <div class="class-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <!-- Card Header -->
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="fw-bold mb-0 text-dark">@c.ClassName</h5>
                        <span class="badge badge-active font-monospace">Active</span>
                    </div>

                    <!-- Card Info Rows -->
                    <div class="info-list mb-4">
                        <div class="d-flex justify-content-between py-1 border-bottom-subtle">
                            <span class="text-muted small">Section:</span>
                            <span class="fw-bold text-dark small">@(string.IsNullOrEmpty(c.Section) ? "Main" : c.Section)</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom-subtle">
                            <span class="text-muted small">Subject:</span>
                            <span class="fw-semibold text-dark small">@(string.IsNullOrEmpty(c.Subject) ? "General" : c.Subject)</span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-muted small">Total Students:</span>
                            <span class="fw-bold text-dark small">@c.ClassStudents.Count</span>
                        </div>
                    </div>
                </div>

                <!-- View Button -->
                <div>
                    <a href="/Teacher/ClassDetails/@c.ClassId" class="btn btn-view-class w-100 py-2 fw-semibold">
                        <i class="bi bi-folder2-open me-1"></i> View Class Details
                    </a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any(c => !c.IsArchived))
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-folder-x display-4 d-block mb-3 opacity-50"></i>
            <h5>No Active Classes Found</h5>
            <p class="small">Click "Create Class" above to create a section roster.</p>
        </div>
    }
</div>

<!-- Modal: Create Class -->
<div class="modal fade" id="createClassModal" tabindex="-1" aria-labelledby="createClassModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                <h5 class="modal-title fw-bold" id="createClassModalLabel">
                    <i class="bi bi-folder-plus me-2"></i> Create New Class
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Teacher/CreateClass">
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Class Name <span class="text-danger">*</span></label>
                        <input type="text" name="ClassName" class="form-control filter-control" required placeholder="e.g. Grade 7 - Sampaguita" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Section Name</label>
                        <input type="text" name="Section" class="form-control filter-control" placeholder="e.g. Section A" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Subject / Course</label>
                        <input type="text" name="Subject" class="form-control filter-control" placeholder="e.g. Computer Education 7" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Grade Level</label>
                        <input type="text" name="GradeLevel" class="form-control filter-control" placeholder="e.g. Grade 7" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Schedule / Time Slot</label>
                        <input type="text" name="Schedule" class="form-control filter-control" placeholder="e.g. Mon/Wed 08:00 AM - 09:30 AM" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Create Class</button>
                </div>
            </form>
        </div>
    </div>
</div>
