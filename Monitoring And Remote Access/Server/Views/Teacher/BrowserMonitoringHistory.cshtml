@using Server.Models
@using Shared.Contracts
@using Server.Extensions
@model IReadOnlyList<BrowserMonitoringRecord>
@{
    ViewData["Title"] = "Browser Monitoring History";
    Layout = "_TeacherLayout";
    var paging = ViewBag.Paging as PagedResult<BrowserMonitoringRecord>;
}

<div class="mb-4">
    <span class="text-uppercase small fw-bold text-success">Privacy-safe browser diagnostics</span>
    <h2 class="fw-extrabold mb-1">Browser Monitoring History</h2>
    <p class="text-muted mb-0">Records monitoring availability and mode only. Page content, credentials, cookies, paths, queries, and fragments are not stored.</p>
</div>

<div class="card crud-panel log-directory-panel">
    <form method="get" class="crud-toolbar log-toolbar">
        <div class="log-filter-field"><label class="form-label" for="browser-from">From</label><input id="browser-from" type="date" name="from" value="@ViewBag.From" class="form-control" /></div>
        <div class="log-filter-field"><label class="form-label" for="browser-to">To</label><input id="browser-to" type="date" name="to" value="@ViewBag.To" class="form-control" /></div>
        <div class="log-filter-field log-filter-wide"><label class="form-label" for="browser-name">Browser</label><select id="browser-name" name="browser" class="form-select"><option value="">Chrome and Brave</option><option value="chrome" selected="@(ViewBag.Browser == "chrome")">Chrome</option><option value="brave" selected="@(ViewBag.Browser == "brave")">Brave</option></select></div>
        <div class="log-filter-field log-filter-wide"><label class="form-label" for="browser-mode">Mode</label><select id="browser-mode" name="mode" class="form-select"><option value="">All modes</option>@foreach (var option in Enum.GetValues<BrowserMonitoringMode>()) { <option value="@option" selected="@(ViewBag.Mode?.ToString() == option.ToString())">@BrowserMonitoringDisplay.Label(option)</option> }</select></div>
        @* The export carries the same filter as the list, so the file matches the screen. *@
        <div class="log-toolbar-actions"><button class="btn btn-emerald" type="submit"><i class="bi bi-funnel me-1" aria-hidden="true"></i>Apply</button><a class="btn btn-outline-secondary" href="@Url.Action("BrowserMonitoringHistory", "Teacher")" title="Clear all filters">Reset</a><a class="btn btn-outline-emerald" href="@Url.Action("ExportBrowserMonitoringCsv", new { from = ViewBag.From, to = ViewBag.To, browser = ViewBag.Browser, mode = ViewBag.Mode })"><i class="bi bi-download me-1" aria-hidden="true"></i>Export CSV</a></div>
    </form>
    <div class="table-responsive">
        @{
            // One row per student, their collector states folded inside. The mode
            // is sampled repeatedly, so a flat list is mostly the same student
            // saying the same thing.
            var browserByStudent = Model
                .GroupBy(record => record.StudentId)
                .Select(group => new { Student = group.Key, Records = group.OrderByDescending(record => record.Timestamp).ToList() })
                .OrderByDescending(group => group.Records[0].Timestamp)
                .ToList();
            var browserIndex = 0;
        }
        <table class="table custom-table align-middle mb-0 log-group-table">
            <thead><tr><th scope="col" class="log-group-toggle-cell"><span class="visually-hidden">Expand</span></th><th scope="col">Student</th><th scope="col">Records</th><th scope="col">Last Seen</th><th scope="col">Latest Mode</th><th scope="col">Stations</th></tr></thead>
            <tbody>
            @foreach (var group in browserByStudent)
            {
                browserIndex++;
                var panelId = $"browser-history-{browserIndex}";
                var latest = group.Records[0];
                var latestClass = BrowserMonitoringDisplay.BadgeClass(latest.Mode);
                var latestLabel = BrowserMonitoringDisplay.Label(latest.Mode);
                var latestExplanation = BrowserMonitoringDisplay.Explanation(latest.Mode);

                <tr data-log-group>
                    <td class="log-group-toggle-cell">
                        <button type="button" class="log-group-toggle" aria-expanded="false" aria-controls="@panelId">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            <span class="visually-hidden">Show the @group.Records.Count browser monitoring records for student @group.Student</span>
                        </button>
                    </td>
                    <td class="font-monospace fw-bold">@group.Student</td>
                    <td><span class="badge bg-light text-dark font-monospace">@group.Records.Count</span></td>
                    <td class="text-nowrap">@latest.Timestamp.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</td>
                    <td><span class="badge rounded-pill @latestClass" title="@latestExplanation">@latestLabel</span></td>
                    <td class="text-muted">@string.Join(", ", group.Records.Select(record => record.PcName).Distinct())</td>
                </tr>
                <tr class="log-group-detail" id="@panelId" data-log-detail hidden>
                    <td colspan="6">
                        <div class="log-group-events">
                            <table class="table table-sm custom-table align-middle mb-0">
                                <thead><tr><th scope="col">Time</th><th scope="col">Station</th><th scope="col">Browser</th><th scope="col">Mode</th><th scope="col">Detail</th></tr></thead>
                                <tbody>
                                @foreach (var record in group.Records)
                                {
                                    var modeClass = BrowserMonitoringDisplay.BadgeClass(record.Mode);
                                    var modeLabel = BrowserMonitoringDisplay.Label(record.Mode);
                                    var modeExplanation = BrowserMonitoringDisplay.Explanation(record.Mode);
                                    <tr><td class="text-nowrap font-monospace text-muted">@record.Timestamp.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</td><td>@record.PcName</td><td class="text-capitalize">@record.Browser</td><td><span class="badge rounded-pill @modeClass" title="@modeExplanation">@modeLabel</span></td><td class="text-muted">@(record.Detail ?? "-")</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            }
            @if (!browserByStudent.Any()) { <tr><td colspan="6" class="text-center empty-state log-empty-state"><i class="bi bi-globe2 empty-state-icon" aria-hidden="true"></i><span class="empty-state-message">No browser monitoring records match these filters.</span></td></tr> }
            </tbody>
        </table>
    </div>
    @if (paging is not null)
    {
        @await Html.PartialAsync("_CrudPager", PagerViewModel.For(paging, "records", "BrowserMonitoringHistory", new { from = ViewBag.From, to = ViewBag.To, browser = ViewBag.Browser, mode = ViewBag.Mode }))
    }
</div>

@section Scripts {
    <script src="~/js/log-groups.js" asp-append-version="true"></script>
}
