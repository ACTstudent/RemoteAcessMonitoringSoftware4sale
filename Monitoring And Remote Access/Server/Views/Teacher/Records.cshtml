@model IEnumerable<Server.Models.LabSession>
@{
    ViewData["Title"] = "Classroom Records";
    Layout = "_TeacherLayout";
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div>
            <h2 class="page-title">Classroom Records & Reports</h2>
            <p class="text-muted mb-0 small">Historical attendance logs, lab duration, and session metrics</p>
        </div>
    </div>
    @* Each table on this page downloads as a CSV file. The one button here used
       to call the browser's Print, which produced a picture of the page. *@
    <div class="d-flex gap-2 flex-wrap">
        <a href="@Url.Action("ExportRecordsCsv", "Teacher")" class="btn btn-emerald rounded-pill px-3 py-2 fw-semibold shadow-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i> Session CSV
        </a>
        <a href="@Url.Action("ExportWebsiteActivityCsv", "Teacher")" class="btn btn-outline-emerald rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-download me-1" aria-hidden="true"></i> Website CSV
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Website Activity History</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@(((IEnumerable<Server.Models.WebsiteUsageLog>)(ViewBag.WebsiteUsage ?? new List<Server.Models.WebsiteUsageLog>())).Count()) Events</span>
    </div>
    <div class="table-responsive">
        @{
            // One row per student, their visits folded inside. A class of thirty
            // browsing for an hour produces thousands of lines otherwise, and the
            // student's name is repeated on every one of them.
            var websiteByStudent = ((IEnumerable<Server.Models.WebsiteUsageLog>)(ViewBag.WebsiteUsage ?? new List<Server.Models.WebsiteUsageLog>()))
                .GroupBy(log => log.Student?.Username ?? log.StudentId?.ToString() ?? "?")
                .Select(group => new { Student = group.Key, Events = group.OrderByDescending(log => log.Timestamp).ToList() })
                .OrderByDescending(group => group.Events[0].Timestamp)
                .ToList();
            var websiteIndex = 0;
        }
        <table data-crud-table="students" class="table custom-table align-middle mb-0 log-group-table">
            <thead><tr><th scope="col" class="log-group-toggle-cell"><span class="visually-hidden">Expand</span></th><th scope="col">Student</th><th scope="col">Sites</th><th scope="col">Events</th><th scope="col">Last Recorded</th></tr></thead>
            <tbody>
                @foreach (var group in websiteByStudent)
                {
                    websiteIndex++;
                    var panelId = $"records-website-{websiteIndex}";
                    var searchText = $"{group.Student} " + string.Join(' ', group.Events.Select(log => $"{log.Domain} {log.Browser}"));

                    <tr data-log-group data-crud-search-text="@searchText">
                        <td class="log-group-toggle-cell">
                            <button type="button" class="log-group-toggle" aria-expanded="false" aria-controls="@panelId">
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                <span class="visually-hidden">Show the @group.Events.Count website events for @group.Student</span>
                            </button>
                        </td>
                        <td class="fw-bold">@group.Student</td>
                        <td><span class="badge bg-light text-dark font-monospace">@group.Events.Select(log => log.Domain).Distinct().Count()</span></td>
                        <td><span class="badge bg-light text-dark font-monospace">@group.Events.Count</span></td>
                        <td>@group.Events[0].Timestamp.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</td>
                    </tr>
                    <tr class="log-group-detail" id="@panelId" data-log-detail hidden>
                        <td colspan="5">
                            <div class="log-group-events">
                                <table class="table table-sm custom-table align-middle mb-0">
                                    <thead><tr><th scope="col">Domain</th><th scope="col">Browser</th><th scope="col">Recorded At</th></tr></thead>
                                    <tbody>
                                        @foreach (var log in group.Events)
                                        {
                                            <tr><td>@log.Domain</td><td>@log.Browser</td><td class="font-monospace text-muted">@log.Timestamp.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                }
                @if (!websiteByStudent.Any())
                {
                    <tr><td colspan="5" class="text-center empty-state"><i class="bi bi-globe2 empty-state-icon" aria-hidden="true"></i><span class="empty-state-message">No website activity recorded yet.</span></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Metric Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Recorded Sessions</div>
                <div class="metric-value text-success">@ViewBag.TotalSessions</div>
            </div>
            <div class="metric-icon-box bg-success text-white">
                <i class="bi bi-journal-text fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Cumulative Lab Time</div>
                <div class="metric-value text-dark">@Math.Round((double)ViewBag.TotalMinutes) mins</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-clock-history fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Session Usage Logs Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Attendance & Session Usage Logs</h5>
        <span class="badge bg-light text-dark font-monospace fs-6">@Model.Count() Logs</span>
    </div>
    <div class="table-responsive">
        <table data-crud-table="session records" class="table custom-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Student Username</th>
                    <th>Station Name</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Duration</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var dur = s.EndTime.HasValue ? (int)Math.Round((s.EndTime.Value - s.StartTime).TotalMinutes) : 0;
                    <tr>
                        <td class="fw-bold text-dark font-monospace">
                            <i class="bi bi-person me-1"></i> @(s.Student?.Username ?? "?")
                        </td>
                        <td class="font-monospace text-emerald-700">
                            <i class="bi bi-pc-display me-1"></i> @(s.Computer?.LaboratoryStation ?? s.PCName)
                        </td>
                        <td>@s.StartTime.ToDisplayLocal().ToString("MMM dd, yyyy HH:mm")</td>
                        <td>@(s.EndTime?.ToDisplayLocal().ToString("MMM dd, yyyy HH:mm") ?? "-")</td>
                        <td class="fw-bold text-dark">@dur mins</td>
                        <td>
                            <span class="badge @(s.Status == "Running" ? "bg-success" : s.Status == "Paused" ? "bg-warning text-dark" : "bg-secondary") rounded-pill px-3 py-1">
                                @s.Status
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center empty-state"><i class="bi bi-journal-text empty-state-icon" aria-hidden="true"></i><span class="empty-state-message">No attendance logs recorded yet.</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/log-groups.js" asp-append-version="true"></script>
}
