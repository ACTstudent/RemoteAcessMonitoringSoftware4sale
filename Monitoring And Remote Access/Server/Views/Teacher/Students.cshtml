@model IEnumerable<Server.Models.Student>
@{
    ViewData["Title"] = "Student Profiles";
    Layout = "_TeacherLayout";

    var totalStudents = Model.Count();
    var activeStudents = Model.Count(s => string.IsNullOrWhiteSpace(s.Status) || string.Equals(s.Status, "Active", StringComparison.OrdinalIgnoreCase));
    var inactiveStudents = totalStudents - activeStudents;
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div>
            <h2 class="page-title">Student Profiles</h2>
            <p class="text-muted mb-0 small">Manage your classroom student profiles and account details</p>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap justify-content-end">
        <a href="/Teacher/Settings" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-key me-1"></i> Account Settings
        </a>
    </div>
</div>

<!-- Metric Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Total Students</div>
                <div class="metric-value">@totalStudents</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-mortarboard-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Active Students</div>
                <div class="metric-value text-success">@activeStudents</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-person-check-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Inactive Students</div>
                <div class="metric-value text-muted">@inactiveStudents</div>
            </div>
            <div class="metric-icon-box bg-light text-secondary">
                <i class="bi bi-person-dash-fill fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Student Table Card -->
<div class="card crud-panel border-0 shadow-sm rounded-4 overflow-hidden mb-4" data-crud-list data-crud-label="students" data-crud-page-size="6">
    <div class="crud-toolbar">
        <form method="get" action="/Teacher/Students" class="d-flex gap-2 flex-grow-1" role="search">
            <input type="search" name="search" value="@ViewBag.Search" class="form-control crud-search" data-crud-search placeholder="Search student name, ID, or username..." aria-label="Search students" />
            <button type="submit" class="btn btn-outline-emerald"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">Search all accessible students</span></button>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <a href="/Teacher/Students" class="btn btn-light">Show All</a>
            }
        </form>
        <select class="form-select" data-crud-filter="status" aria-label="Filter students by status">
            <option value="">All Statuses</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
        </select>
        <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#addStudentModal">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Add Student
        </button>
    </div>
    <div class="table-responsive">
        <table class="table custom-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Username</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var isActive = string.IsNullOrWhiteSpace(s.Status) || string.Equals(s.Status, "Active", StringComparison.OrdinalIgnoreCase);
                    <tr data-crud-item data-status="@(isActive ? "Active" : "Inactive")">
                        <td class="fw-bold text-muted font-monospace">@s.StudentNumber</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar-circle user-avatar-sm">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="fw-bold text-dark">@s.FullName</span>
                            </div>
                        </td>
                        <td class="font-monospace text-emerald-700">@@@s.Username</td>
                        <td><span class="badge @(isActive ? "bg-success" : "bg-secondary") rounded-pill">@(isActive ? "Active" : "Inactive")</span></td>
                        <td>
                            <div class="crud-actions d-flex justify-content-end gap-1">
                                <button type="button" class="btn btn-sm btn-outline-emerald crud-action" data-bs-toggle="modal" data-bs-target="#editStudentModal-@s.Id" title="Edit student" aria-label="Edit @s.FullName">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                </button>
                                <a class="btn btn-sm btn-outline-primary crud-action" asp-action="StudentDetails" asp-route-id="@s.Id" title="Student analytics" aria-label="View analytics for @s.FullName">
                                    <i class="bi bi-graph-up" aria-hidden="true"></i>
                                </a>
                                <form method="post" action="/Teacher/DeleteStudent" class="form-inline-action" data-confirm-subject="@s.FullName" data-confirm="Remove this student from CAMS? They disappear from the student lists and can no longer log in. **Their session history is kept**, and an administrator can restore the account." data-confirm-title="Remove student" data-confirm-label="Remove"><input type="hidden" name="search" value="@ViewBag.Search" />
                                    <input type="hidden" name="studentId" value="@s.Id" />
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger crud-action" title="Remove student" aria-label="Remove @s.FullName">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center empty-state"><i class="bi bi-mortarboard empty-state-icon" aria-hidden="true"></i><span class="empty-state-message">No accessible students match the current search.</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="crud-no-results" data-crud-empty hidden>No students match your search.</div>
    <div class="crud-footer" data-crud-pagination></div>
</div>

<!-- Modals: Edit Student -->
@foreach (var s in Model)
{
    <div class="modal fade" id="editStudentModal-@s.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-2"></i> Edit Student - @s.FullName
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="/Teacher/UpdateStudent"><input type="hidden" name="search" value="@ViewBag.Search" />
                    <input type="hidden" name="Id" value="@s.Id" />
                    @Html.AntiForgeryToken()
                    <div class="modal-body py-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="edit-student-number-@s.Id">Student ID Number</label>
                            <input type="text" id="edit-student-number-@s.Id" name="StudentNumber" class="form-control filter-control" value="@s.StudentNumber" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="edit-student-fullname-@s.Id">Full Name</label>
                            <input type="text" id="edit-student-fullname-@s.Id" name="FullName" class="form-control filter-control" value="@s.FullName" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="edit-student-username-@s.Id">Username</label>
                            <input type="text" id="edit-student-username-@s.Id" name="Username" class="form-control filter-control" value="@s.Username" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small" for="edit-student-password-@s.Id">New Password <span class="text-muted font-normal">(Leave blank to keep current)</span></label>
                            <input type="password" id="edit-student-password-@s.Id" name="newPassword" class="form-control filter-control" placeholder="Optional new password" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal: Add Student. Works with or without a class; with none, the
     teacher becomes the student's adviser. -->
@{
    var addClasses = (IEnumerable<Server.Models.Class>)(ViewBag.Classes ?? Enumerable.Empty<Server.Models.Class>());
}
<div class="modal fade" id="addStudentModal" tabindex="-1" aria-labelledby="addStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="addStudentModalLabel">
                    <i class="bi bi-person-plus me-2"></i> Add Student
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Teacher/CreateStudent">
                @Html.AntiForgeryToken()
                <input type="hidden" name="search" value="@ViewBag.Search" />
                <div class="modal-body py-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold text-muted small" for="add-student-first">First Name <span class="text-danger">*</span></label>
                            <input type="text" id="add-student-first" name="FirstName" class="form-control filter-control" maxlength="100" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold text-muted small" for="add-student-last">Last Name <span class="text-danger">*</span></label>
                            <input type="text" id="add-student-last" name="LastName" class="form-control filter-control" maxlength="100" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold text-muted small" for="add-student-number">Student ID Number</label>
                            <input type="text" id="add-student-number" name="StudentNumber" class="form-control filter-control" maxlength="50" placeholder="Made for you if blank" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold text-muted small" for="add-student-username">Username</label>
                            <input type="text" id="add-student-username" name="Username" class="form-control filter-control" maxlength="50" placeholder="Made from the name if blank" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold text-muted small" for="add-student-password">Password <span class="text-danger">*</span></label>
                            <input type="password" id="add-student-password" name="PasswordHash" class="form-control filter-control" minlength="8" required autocomplete="new-password" aria-describedby="add-student-password-hint" />
                            <div id="add-student-password-hint" class="form-text">At least 8 characters.</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold text-muted small" for="add-student-class">Class</label>
                            <select id="add-student-class" name="classId" class="form-select filter-control">
                                <option value="">No class yet</option>
                                @foreach (var cls in addClasses)
                                {
                                    <option value="@cls.ClassId">@cls.ClassName</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Add Student</button>
                </div>
            </form>
        </div>
    </div>
</div>