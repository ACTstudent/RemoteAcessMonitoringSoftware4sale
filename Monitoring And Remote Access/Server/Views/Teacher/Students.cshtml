@model IEnumerable<Server.Models.Student>
@{
    ViewData["Title"] = "Student Profiles";
    Layout = "_TeacherLayout";

    var totalStudents = Model.Count();
}

<!-- Header Row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-box-primary">
            <i class="bi bi-people-fill fs-3"></i>
        </div>
        <div>
            <h2 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">Student Profiles</h2>
            <p class="text-muted mb-0 small">Manage assigned classroom students & credentials</p>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap justify-content-end">
        <a href="/Teacher/Settings" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-key me-1"></i> Account Settings
        </a>
        <a asp-controller="Teacher" asp-action="Classes" class="btn btn-emerald rounded-pill px-4 py-2 fw-semibold shadow-sm text-white">
            <i class="bi bi-folder-plus me-1"></i> Add from Class
        </a>
    </div>
</div>

<!-- Metric Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="metric-card metric-card-emerald d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Enrolled Students</div>
                <div class="metric-value text-success">@totalStudents</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-mortarboard-fill fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="metric-card d-flex justify-content-between align-items-center">
            <div>
                <div class="metric-title">Laboratory Status</div>
                <div class="metric-value text-dark fs-4">Active Profiles</div>
            </div>
            <div class="metric-icon-box">
                <i class="bi bi-journal-check fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Student Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="fw-bold mb-0 text-dark">Enrolled Student Profiles</h5>
        <form method="get" action="/Teacher/Students" class="d-flex gap-2" role="search">
            <input type="search" name="search" value="@ViewBag.Search" class="form-control filter-control" placeholder="Search name, ID, or username" aria-label="Search students" />
            <button type="submit" class="btn btn-outline-emerald rounded-pill px-3"><i class="bi bi-search"></i> Search</button>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <a href="/Teacher/Students" class="btn btn-light rounded-pill px-3">Clear</a>
            }
        </form>
    </div>
    <div class="table-responsive">
        <table class="table custom-table mb-0">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Username</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted font-monospace">@s.StudentNumber</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar-circle" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="fw-bold text-dark">@s.FullName</span>
                            </div>
                        </td>
                        <td class="font-monospace text-emerald-700">@@@s.Username</td>
                        <td>
                            <div class="d-flex justify-content-end gap-1">
                                <button type="button" class="btn btn-sm btn-outline-emerald rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editStudentModal-@s.Id">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </button>
                                <a class="btn btn-sm btn-outline-primary rounded-pill px-3" asp-action="StudentDetails" asp-route-id="@s.Id">
                                    <i class="bi bi-graph-up me-1"></i> Analytics
                                </a>
                                <form method="post" action="/Teacher/DeleteStudent" style="margin: 0;" data-confirm="Remove @s.FullName from your student profiles?" data-confirm-title="Remove student" data-confirm-label="Remove">
                                    <input type="hidden" name="studentId" value="@s.Id" />
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="bi bi-trash me-1"></i> Remove
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No accessible students match the current search.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modals: Edit Student -->
@foreach (var s in Model)
{
    <div class="modal fade" id="editStudentModal-@s.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 text-white" style="background-color: var(--sidebar-bg);">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-2"></i> Edit Student - @s.FullName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="/Teacher/UpdateStudent">
                    <input type="hidden" name="Id" value="@s.Id" />
                    @Html.AntiForgeryToken()
                    <div class="modal-body py-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Student ID Number</label>
                            <input type="text" name="StudentNumber" class="form-control filter-control" value="@s.StudentNumber" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Full Name</label>
                            <input type="text" name="FullName" class="form-control filter-control" value="@s.FullName" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Username</label>
                            <input type="text" name="Username" class="form-control filter-control" value="@s.Username" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">New Password <span class="text-muted font-normal">(Leave blank to keep current)</span></label>
                            <input type="password" name="newPassword" class="form-control filter-control" placeholder="Optional new password" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-emerald rounded-pill px-4 text-white">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
