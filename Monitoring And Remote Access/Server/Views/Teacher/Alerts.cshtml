@model IReadOnlyList<Server.Models.MonitoringAlert>
@{ ViewData["Title"] = "Monitoring Alerts"; Layout = "_TeacherLayout"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="fw-extrabold mb-1">Monitoring Alerts</h2><p class="text-muted mb-0">Review and acknowledge alerts from your students.</p></div><a class="btn btn-outline-secondary rounded-pill" href="@Url.Action("Alerts", new { includeAcknowledged = true })">Show all</a></div>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive"><table class="table custom-table mb-0"><thead><tr><th>Created</th><th>Student ID</th><th>Alert</th><th>Severity</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var alert in Model) { <tr><td>@alert.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td><td>@alert.StudentId</td><td><strong>@alert.Title</strong><br /><small>@alert.Message</small></td><td>@alert.Severity</td><td>@(alert.IsAcknowledged ? "Acknowledged" : "Open")</td><td>@if (!alert.IsAcknowledged) { <form method="post" asp-action="AcknowledgeAlert">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@alert.MonitoringAlertId" /><button class="btn btn-sm btn-success rounded-pill" type="submit">Acknowledge</button></form> }</td></tr> }
@if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No alerts found.</td></tr> }
</tbody></table></div></div>
