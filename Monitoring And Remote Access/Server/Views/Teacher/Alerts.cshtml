@model IReadOnlyList<Server.Models.MonitoringAlert>
@{ ViewData["Title"] = "Monitoring Alerts"; Layout = "_TeacherLayout"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="fw-extrabold mb-1">Monitoring Alerts</h2><p class="text-muted mb-0">Review and acknowledge alerts from your students.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-emerald rounded-pill" href="@Url.Action("ExportAlertsCsv", new { from = ViewBag.From, to = ViewBag.To, severity = ViewBag.Severity, studentId = ViewBag.StudentId })">Export CSV</a><a class="btn btn-outline-secondary rounded-pill" href="@Url.Action("Alerts", new { includeAcknowledged = true })">Show all</a></div></div>
<form method="get" class="row g-2 mb-3"><input type="hidden" name="includeAcknowledged" value="@Context.Request.Query["includeAcknowledged"]" /><div class="col-md-3"><input type="date" name="from" class="form-control" value="@ViewBag.From" /></div><div class="col-md-3"><input type="date" name="to" class="form-control" value="@ViewBag.To" /></div><div class="col-md-2"><select name="severity" class="form-select"><option value="">All severities</option><option selected="@(ViewBag.Severity == "Critical")">Critical</option><option selected="@(ViewBag.Severity == "Warning")">Warning</option></select></div><div class="col-md-2"><input name="studentId" class="form-control" placeholder="Student ID" value="@ViewBag.StudentId" /></div><div class="col-md-2"><button class="btn btn-emerald w-100">Filter</button></div></form>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive"><table class="table custom-table mb-0"><thead><tr><th>Created</th><th>Student ID</th><th>Alert</th><th>Severity</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var alert in Model) { <tr><td>@alert.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td><td>@alert.StudentId</td><td><strong>@alert.Title</strong><br /><small>@alert.Message</small></td><td>@alert.Severity</td><td>@(alert.IsAcknowledged ? "Acknowledged" : "Open")</td><td><a class="btn btn-sm btn-outline-secondary rounded-pill" href="@Url.Action("AlertHistory", new { id = alert.MonitoringAlertId })">History</a> <form class="d-inline" method="post" asp-action="AcknowledgeAlert">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@alert.MonitoringAlertId" /><input type="hidden" name="acknowledged" value="@(alert.IsAcknowledged ? "false" : "true")" /><button class="btn btn-sm @(alert.IsAcknowledged ? "btn-outline-warning" : "btn-success") rounded-pill" type="submit">@(alert.IsAcknowledged ? "Reopen" : "Acknowledge")</button></form></td></tr> }
@if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No alerts found.</td></tr> }
</tbody></table></div></div>
@if (ViewBag.Paging is Server.Models.PagedResult<Server.Models.MonitoringAlert> p && p.PageCount > 1) { <nav class="mt-3"><a class="btn btn-sm btn-outline-secondary @(p.Page == 1 ? "disabled" : "")" href="@Url.Action("Alerts", new { includeAcknowledged = Context.Request.Query["includeAcknowledged"], from = ViewBag.From, to = ViewBag.To, severity = ViewBag.Severity, page = p.Page - 1 })">Previous</a> <span class="mx-2">Page @p.Page of @p.PageCount</span><a class="btn btn-sm btn-outline-secondary @(p.Page == p.PageCount ? "disabled" : "")" href="@Url.Action("Alerts", new { includeAcknowledged = Context.Request.Query["includeAcknowledged"], from = ViewBag.From, to = ViewBag.To, severity = ViewBag.Severity, page = p.Page + 1 })">Next</a></nav> }
