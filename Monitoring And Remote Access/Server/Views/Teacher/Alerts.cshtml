@using Server.Models
@model AlertListViewModel
@{
    ViewData["Title"] = "Monitoring Alerts";
    Layout = "_TeacherLayout";
    var filter = Model.Filter;
    var paging = Model.Alerts;
    var selectedStatus = filter.ResolvedStatusName;
    var showMoreFilters = filter.From.HasValue || filter.To.HasValue || !string.IsNullOrWhiteSpace(filter.StudentId);
}

<div class="mb-4">
    <h2 class="fw-extrabold mb-1">Monitoring Alerts</h2>
    <p class="text-muted mb-0">Related occurrences stay grouped while each group moves through a clear alert lifecycle.</p>
</div>

@if (!string.IsNullOrEmpty(Model.FilterWarning))
{
    <div class="alert alert-warning rounded-4 border-0 d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div>@Model.FilterWarning</div>
    </div>
}

<div class="card crud-panel log-directory-panel">
<form method="get">
    @*
        The status dropdown is the single control for which alerts are listed.
        includeAcknowledged rides along so that choosing "All statuses" actually
        widens the list instead of falling back to open alerts only.
    *@
    <input type="hidden" name="includeAcknowledged" value="true" />
    <div class="crud-toolbar log-toolbar">
        <label class="visually-hidden" for="alert-station">Station</label>
        <input id="alert-station" type="search" name="station" class="form-control crud-search" value="@filter.Station" placeholder="Search station..." />
        <div class="log-filter-field">
            <label class="visually-hidden" for="alert-severity">Severity</label>
            <select id="alert-severity" name="severity" class="form-select">
                <option value="">All severities</option>
                <option value="Critical" selected="@(filter.Severity == "Critical")">Critical</option>
                <option value="Warning" selected="@(filter.Severity == "Warning")">Warning</option>
                <option value="Information" selected="@(filter.Severity == "Information")">Information</option>
            </select>
        </div>
        <div class="log-filter-field">
            <label class="visually-hidden" for="alert-status">Status</label>
            <select id="alert-status" name="status" class="form-select">
                <option value="" selected="@(selectedStatus.Length == 0)">All statuses</option>
                @foreach (var status in Enum.GetValues<MonitoringAlertStatus>())
                {
                    <option value="@status" selected="@(selectedStatus == status.ToString())">@status</option>
                }
            </select>
        </div>
        <div class="log-toolbar-actions">
            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#alert-more-filters" aria-controls="alert-more-filters" aria-expanded="@(showMoreFilters ? "true" : "false")"><i class="bi bi-sliders me-1" aria-hidden="true"></i>More filters</button>
            <button class="btn btn-emerald" type="submit"><i class="bi bi-funnel me-1" aria-hidden="true"></i>Apply</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Alerts")" title="Clear all filters">Reset</a>
            @* The export carries the same filter as the list, so the file matches the screen. *@
            <a class="btn btn-outline-emerald" href="@Url.Action("ExportAlertsCsv", filter.ToRouteValues())"><i class="bi bi-download me-1" aria-hidden="true"></i>Export CSV</a>
        </div>
    </div>
    <div id="alert-more-filters" class="collapse @(showMoreFilters ? "show" : "")">
        <div class="crud-toolbar log-toolbar log-filter-options">
            <div class="log-filter-field"><label class="form-label" for="alert-from">From</label><input id="alert-from" type="date" name="from" class="form-control" value="@filter.From?.ToString("yyyy-MM-dd")" /></div>
            <div class="log-filter-field"><label class="form-label" for="alert-to">To</label><input id="alert-to" type="date" name="to" class="form-control" value="@filter.To?.ToString("yyyy-MM-dd")" /></div>
            <div class="log-filter-field"><label class="form-label" for="alert-student">Student ID</label><input id="alert-student" name="studentId" class="form-control" value="@filter.StudentId" /></div>
        </div>
    </div>
</form>

<form id="bulk-alert-form" method="post" data-alert-bulk-form>
    @Html.AntiForgeryToken()
    <partial name="_AlertFilterFields" model="filter" />
</form>
@if (paging.Items.Count > 0)
{
    <div class="log-bulk-toolbar">
        <div class="flex-grow-1">
            <label for="dismissal-reason" class="form-label small text-muted mb-1">Dismissal reason (applies only to Dismiss)</label>
            <input id="dismissal-reason" name="reason" form="bulk-alert-form" maxlength="500" class="form-control" placeholder="Optional operational note" />
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" form="bulk-alert-form" formaction="@Url.Action("BulkAcknowledgeAlerts", "Teacher")" class="btn btn-emerald"><i class="bi bi-check2-circle me-1"></i>Acknowledge</button>
            <button type="submit" form="bulk-alert-form" formaction="@Url.Action("BulkDismissAlerts", "Teacher")" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-archive me-1"></i>Dismiss</button>
            <button type="submit" form="bulk-alert-form" formaction="@Url.Action("BulkReopenAlerts", "Teacher")" class="btn btn-outline-warning rounded-pill"><i class="bi bi-arrow-counterclockwise me-1"></i>Reopen</button>
        </div>
    </div>
}

    <div class="table-responsive">
        <table class="table custom-table align-middle mb-0">
            <thead><tr><th class="ps-3"><input id="select-all-alerts" class="form-check-input" type="checkbox" data-alert-select-all aria-label="Select all alerts" disabled="@(paging.Items.Count == 0)" /></th><th scope="col" class="log-group-toggle-cell"><span class="visually-hidden">Expand</span></th><th scope="col">Student / station</th><th scope="col">Alert groups</th><th scope="col">Occurrences</th><th scope="col">Open</th><th scope="col">Last seen</th></tr></thead>
            <tbody>
            @{
                // One row per student, their alert groups folded inside. The list was
                // already deduplicated into groups with an occurrence count; this
                // takes the second step, so a teacher reads the room by pupil rather
                // than scrolling one student's twelve alerts to reach the next.
                var alertsByStudent = paging.Items
                    .GroupBy(alert => alert.StudentId)
                    .Select(group => new { Student = group.Key, Alerts = group.OrderByDescending(alert => alert.LastSeenAt).ToList() })
                    .OrderByDescending(group => group.Alerts[0].LastSeenAt)
                    .ToList();
                var alertIndex = 0;
            }
            @foreach (var group in alertsByStudent)
            {
                alertIndex++;
                var panelId = $"alerts-student-{alertIndex}";
                var newest = group.Alerts[0];
                var openCount = group.Alerts.Count(alert => alert.Status == MonitoringAlertStatus.Open);
                var stations = string.Join(", ", group.Alerts.Select(alert => alert.PcName).Where(name => !string.IsNullOrWhiteSpace(name)).Distinct());

                <tr data-log-group>
                    <td class="ps-3"></td>
                    <td class="log-group-toggle-cell">
                        <button type="button" class="log-group-toggle" aria-expanded="false" aria-controls="@panelId">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            <span class="visually-hidden">Show the @group.Alerts.Count alert groups for student @group.Student</span>
                        </button>
                    </td>
                    <td><span class="font-monospace fw-bold">@group.Student</span><small class="d-block text-muted">@stations</small></td>
                    <td><span class="badge bg-light text-dark font-monospace">@group.Alerts.Count</span></td>
                    <td><span class="fs-5 fw-bold">@group.Alerts.Sum(alert => alert.OccurrenceCount)</span></td>
                    <td>
                        @if (openCount > 0)
                        {
                            <span class="badge rounded-pill text-bg-danger">@openCount open</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill text-bg-success">All handled</span>
                        }
                    </td>
                    <td class="text-nowrap">@newest.LastSeenAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                </tr>
                <tr class="log-group-detail" id="@panelId" data-log-detail hidden>
                    <td colspan="7">
                        <div class="log-group-events">
                            <table class="table table-sm custom-table align-middle mb-0">
                                <thead><tr><th scope="col" class="ps-3"><span class="visually-hidden">Select</span></th><th scope="col">Alert group</th><th scope="col">Occurrences</th><th scope="col">First / last seen</th><th scope="col">Status</th><th scope="col" class="text-end pe-3">Actions</th></tr></thead>
                                <tbody>
                                @foreach (var alert in group.Alerts)
                                {
                                    var status = alert.Status;
                                    var statusClass = status switch
                                    {
                                        MonitoringAlertStatus.Open => "text-bg-danger",
                                        MonitoringAlertStatus.Acknowledged => "text-bg-success",
                                        _ => "text-bg-secondary"
                                    };
                                    <tr>
                                        <td class="ps-3"><input class="form-check-input alert-selector" type="checkbox" data-alert-select name="alertIds" value="@alert.MonitoringAlertId" form="bulk-alert-form" aria-label="Select @alert.Title" disabled /></td>
                                        <td><span class="badge rounded-pill bg-light text-dark border mb-1">@alert.Severity</span><strong class="d-block">@alert.Title</strong><small class="text-muted">@alert.Message</small></td>
                                        <td><span class="fs-5 fw-bold">@alert.OccurrenceCount</span></td>
                                        <td><span class="d-block">@alert.FirstSeenAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span><small class="text-muted">Last: @alert.LastSeenAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</small></td>
                                        <td>
                                            <span class="badge rounded-pill @statusClass">@status</span>
                                            @if (status == MonitoringAlertStatus.Dismissed && !string.IsNullOrWhiteSpace(alert.DismissalReason))
                                            {
                                                <small class="d-block text-muted mt-1" title="@alert.DismissalReason">@alert.DismissalReason</small>
                                            }
                                            @if (status == MonitoringAlertStatus.Dismissed && alert.DismissedAt.HasValue)
                                            {
                                                <small class="d-block text-muted mt-1">Teacher #@alert.DismissedByTeacherId, @alert.DismissedAt.Value.ToLocalTime().ToString("MMM dd HH:mm")</small>
                                            }
                                            else if (status == MonitoringAlertStatus.Acknowledged && alert.AcknowledgedAt.HasValue)
                                            {
                                                <small class="d-block text-muted mt-1">Teacher #@alert.AcknowledgedByTeacherId, @alert.AcknowledgedAt.Value.ToLocalTime().ToString("MMM dd HH:mm")</small>
                                            }
                                        </td>
                                        <td class="text-end pe-3 text-nowrap">
                                            <a class="btn btn-sm btn-outline-secondary rounded-pill" href="@Url.Action("AlertHistory", new { id = alert.MonitoringAlertId })">History</a>
                                            <form class="d-inline" method="post" asp-action="AcknowledgeAlert">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@alert.MonitoringAlertId" />
                                                <input type="hidden" name="acknowledged" value="@(status == MonitoringAlertStatus.Open ? "true" : "false")" />
                                                <partial name="_AlertFilterFields" model="filter" />
                                                <button class="btn btn-sm @(status == MonitoringAlertStatus.Open ? "btn-success" : "btn-outline-warning") rounded-pill" type="submit">@(status == MonitoringAlertStatus.Open ? "Acknowledge" : "Reopen")</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            }
            @if (paging.Items.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted log-empty-state">
                    <i class="bi bi-check2-circle fs-3 d-block mb-2"></i>
                    No alert groups match these filters.
                    <a class="d-block mt-2 empty-state-link" href="@Url.Action("Alerts")">Clear the filters</a>
                </td></tr>
            }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_CrudPager", PagerViewModel.For(paging, "alert groups", "Alerts", filter.ToRouteValues()))
</div>

@section Scripts {
    <script src="~/js/alert-bulk.js" asp-append-version="true"></script>
    <script src="~/js/log-groups.js" asp-append-version="true"></script>
}
