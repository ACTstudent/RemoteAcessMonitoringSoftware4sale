@{
    ViewData["Title"] = "Login - CAMS";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - CAMS | Pardo Elementary School</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem 1rem;
            background: radial-gradient(circle at 15% 15%, #1D5C2E 0%, transparent 55%),
                        linear-gradient(135deg, var(--sidebar-bg) 0%, #1A1712 100%);
        }

        .login-shell {
            width: 100%;
            max-width: 26rem;
        }

        .login-card {
            background: #fff;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
            overflow: hidden;
        }

        .login-banner {
            padding: 2rem 1.5rem 1.6rem;
            text-align: center;
            color: #fff;
            background: linear-gradient(135deg, var(--sidebar-bg), var(--sidebar-active-bg));
        }

        .login-banner h1 {
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            margin: 0.35rem 0 0.15rem;
        }

        .login-banner p {
            margin: 0;
            font-size: 0.8rem;
            color: #BBF3C6;
        }

        .login-body {
            padding: 1.6rem 1.5rem 1.75rem;
        }

        .login-body .form-label {
            font-size: 0.8rem;
            font-weight: 700;
            color: #44403C;
            margin-bottom: 0.4rem;
        }

        .login-body .form-control {
            min-height: 46px;
            border-radius: 12px;
            border-color: #DAD4C9;
        }

        .login-body .form-control:focus {
            border-color: var(--accent-emerald);
            box-shadow: 0 0 0 3px rgba(23, 128, 58, 0.16);
        }

        .btn-login {
            min-height: 48px;
            font-weight: 700;
            border-radius: 12px;
        }

        .login-footnote {
            margin-top: 1.25rem;
            text-align: center;
            font-size: 0.78rem;
            color: rgba(255, 255, 255, 0.55);
        }
    </style>
</head>
<body>
    <div class="login-shell">
        <div class="login-card">
            <div class="login-banner">
                <img src="~/images/pardo_logo.png" alt="" class="school-logo-img" style="width:72px;height:72px;margin-bottom:0;" />
                <h1>CAMS Portal</h1>
                <p>Pardo Elementary School &middot; Cebu City</p>
            </div>

            <div class="login-body">
                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="alert alert-danger d-flex align-items-start gap-2 rounded-3 py-2 px-3 small mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form method="post" action="/Account/Login" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label" for="loginUsername">Username</label>
                        <input type="text"
                               name="username"
                               id="loginUsername"
                               class="form-control"
                               placeholder="Your username or student number"
                               autocomplete="username"
                               autocapitalize="none"
                               spellcheck="false"
                               autofocus
                               required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="loginPassword">Password</label>
                        <div class="password-field">
                            <input type="password"
                                   name="password"
                                   id="loginPassword"
                                   class="form-control"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   required />
                            <button type="button" class="password-toggle" data-password-toggle="#loginPassword" aria-label="Show password">
                                <i class="bi bi-eye-fill"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-emerald w-100 btn-login shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign in
                    </button>
                </form>

                <p class="text-muted small text-center mb-0 mt-3">
                    Use the account issued by your CAMS administrator.
                </p>
            </div>
        </div>

        <div class="login-footnote">&copy; 2026 CAMS &middot; Computer Account Management System</div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
