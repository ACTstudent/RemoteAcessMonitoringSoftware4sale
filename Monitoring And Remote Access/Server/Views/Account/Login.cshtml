@{
    ViewData["Title"] = "Login - CAMS";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - CAMS | Pardo Elementary School</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #0B3C26 0%, #18181b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
            overflow: hidden;
        }
        .login-header-banner {
            background-color: var(--sidebar-bg);
            color: white;
            padding: 2.2rem 1.5rem 1.8rem 1.5rem;
            text-align: center;
        }
        .quick-role-badge {
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 0.8rem;
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
        }
        .quick-role-badge:hover {
            opacity: 0.85;
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-4 col-md-6 col-sm-10">
                <div class="login-card">
                    <div class="login-header-banner">
                        <img src="~/images/pardo_logo.png" alt="Pardo Elementary School" class="school-logo-img mb-2" style="width: 80px; height: 80px;" />
                        <h4 class="fw-extrabold mb-0" style="letter-spacing: -0.5px;">CAMS Portal</h4>
                        <p class="small text-emerald-200 mb-0 opacity-75">Pardo Elementary School Cebu City</p>
                    </div>

                    <div class="p-4">
                        @if (!string.IsNullOrEmpty(ViewBag.Error))
                        {
                            <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2 small mb-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <form method="post" action="/Account/Login">
                            @Html.AntiForgeryToken()
                            
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small">Username</label>
                                <div class="search-input-wrapper">
                                    <input type="text" name="username" id="loginUsername" class="form-control filter-control" placeholder="e.g. admin, teacher1, student1" required />
                                    <i class="bi bi-person-fill search-icon text-muted"></i>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold text-muted small">Password</label>
                                <div class="search-input-wrapper">
                                    <input type="password" name="password" id="loginPassword" class="form-control filter-control" placeholder="••••••••" required />
                                    <i class="bi bi-lock-fill search-icon text-muted"></i>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-emerald w-100 py-2.5 fw-bold shadow-sm mb-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Portal
                            </button>
                        </form>

                         <div class="border-top pt-3 text-center">
                             <span class="text-muted small">Use the account created by your CAMS administrator. Default passwords are not shipped.</span>
                         </div>
                    </div>
                </div>

                <div class="text-center text-white-50 small mt-4">
                    &copy; 2026 CAMS — Classroom Automated Monitoring System
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
