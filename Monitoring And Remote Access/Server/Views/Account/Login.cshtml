@{
    ViewData["Title"] = "Login - CAMS";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - CAMS | Pardo Elementary School</title>
    <link rel="icon" href="~/images/cams-mark.png" type="image/png" asp-append-version="true" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    <link href="~/css/warm-theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/motion.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="login-page">
    <div class="login-shell">
        <div class="login-card">
            <div class="login-banner">
                <img src="~/images/pardo_logo.png" alt="Pardo Elementary School seal" class="school-logo-img" asp-append-version="true" />
                <h1>CAMS Portal</h1>
                <p>Pardo Elementary School &middot; Cebu City</p>
            </div>

            <div class="login-body">
                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="alert alert-danger d-flex align-items-start gap-2 rounded-3 py-2 px-3 small mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form method="post" action="/Account/Login" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label" for="loginUsername">Username</label>
                        <input type="text"
                               name="username"
                               id="loginUsername"
                               class="form-control"
                               placeholder="Your username or student number"
                               autocomplete="username"
                               autocapitalize="none"
                               spellcheck="false"
                               autofocus
                               required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="loginPassword">Password</label>
                        <div class="password-field">
                            <input type="password"
                                   name="password"
                                   id="loginPassword"
                                   class="form-control"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   required />
                            <button type="button" class="password-toggle" data-password-toggle="#loginPassword" aria-label="Show password">
                                <i class="bi bi-eye-fill"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-emerald w-100 btn-login shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign in
                    </button>
                </form>

                <p class="text-muted small text-center mb-0 mt-3">
                    Use the account issued by your CAMS administrator.
                </p>
            </div>
        </div>

        <div class="login-footnote">&copy; 2026 CAMS &middot; Computer Account Management System</div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
