@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Session Information";
    Layout = "_StudentLayout";
    var session = ViewBag.CurrentSession as Server.Models.LabSession;
    var studentName = Context.Session.GetString("FullName") ?? "Student";
    var rules = ViewBag.Rules as List<Server.Models.RestrictionRule> ?? new List<Server.Models.RestrictionRule>();
    var blacklist = ViewBag.Blacklist as List<Server.Models.BlacklistItem> ?? new List<Server.Models.BlacklistItem>();
    var status = session?.Status ?? "Ended";
    var statusBadge = status == "Running" ? "badge-active"
        : status == "Paused" ? "bg-warning text-dark"
        : "bg-secondary";
}

<div class="student-hero">
    <div>
        <h2>Hello, @studentName</h2>
        <p>Here is your current laboratory session.</p>
    </div>
    <span class="hero-station">
        <i class="bi bi-pc-display"></i>
        @(session?.Computer?.LaboratoryStation ?? "No workstation assigned")
    </span>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4 col-sm-6">
        <div class="metric-card metric-card-emerald">
            <div class="metric-title">Remaining time</div>
            <div class="stat text-success" id="countdown">@(ViewBag.Remaining) min</div>
            <div class="small text-muted">Updates automatically</div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="metric-card">
            <div class="metric-title">Assigned unit</div>
            <div class="stat" id="assignedUnit">@(session?.Computer?.LaboratoryStation ?? "Unassigned")</div>
            <div class="small text-muted">@(session?.StartTime.ToLocalTime().ToString("MMM dd, HH:mm") ?? "No active session")</div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="metric-card">
            <div class="metric-title">Session status</div>
            <div class="mt-2" id="sessionStatus">
                <span class="badge @statusBadge fs-6 px-3 py-2">@status</span>
            </div>
            <div class="small text-muted mt-2">Set by your teacher</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-check me-2 text-success"></i>Current restrictions</h5>
                <span class="badge bg-light text-dark font-monospace">@rules.Count</span>
            </div>
            <div class="card-body">
                @if (rules.Count == 0)
                {
                    <p class="empty-state text-center mb-0">No restriction rules are active right now.</p>
                }
                else
                {
                    foreach (var rule in rules)
                    {
                        <div class="info-row">
                            <span class="badge bg-light text-dark">@rule.RuleType</span>
                            <span class="info-value">@rule.Target</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-slash-circle me-2 text-danger"></i>Blocked sites and apps</h5>
                <span class="badge bg-light text-dark font-monospace">@blacklist.Count</span>
            </div>
            <div class="card-body">
                @if (blacklist.Count == 0)
                {
                    <p class="empty-state text-center mb-0">Nothing is blocked right now.</p>
                }
                else
                {
                    foreach (var item in blacklist)
                    {
                        <div class="info-row">
                            <span class="badge bg-danger-subtle text-danger-emphasis">@item.TargetType</span>
                            <span class="info-value">@item.Value</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Keep the student's own session card in step with the server.
    (function () {
        const countdown = document.getElementById("countdown");
        const statusBox = document.getElementById("sessionStatus");
        const unitBox = document.getElementById("assignedUnit");

        function badgeClass(status) {
            if (status === "Running") return "badge-active";
            if (status === "Paused") return "bg-warning text-dark";
            return "bg-secondary";
        }

        async function refresh() {
            try {
                const response = await fetch("/Student/_SessionStatusJson");
                if (!response.ok) return;
                const data = await response.json();
                if (!data || !data.active) return;
                if (countdown) countdown.textContent = (data.remaining ?? "-") + " min";
                if (statusBox) {
                    const badge = document.createElement("span");
                    badge.className = "badge fs-6 px-3 py-2 " + badgeClass(data.status);
                    badge.textContent = data.status;
                    statusBox.replaceChildren(badge);
                }
                if (unitBox && data.station) unitBox.textContent = data.station;
            } catch (error) {
                // A transient poll failure should not disturb the page.
            }
        }

        setInterval(refresh, 30000);
    })();
</script>
}
