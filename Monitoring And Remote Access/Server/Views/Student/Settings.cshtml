@model Server.Models.PasswordChangeInput
@{
    ViewData["Title"] = "Account Settings";
    Layout = "_StudentLayout";
}

<div class="page-header">
    <div class="page-header-main">
        <div>
            <h2><i class="bi bi-gear-fill me-2 text-success"></i>Account Settings</h2>
            <p>Change the password you use to sign in to CAMS.</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark">Change password</h5>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="alert alert-danger d-flex align-items-start gap-2 rounded-3 py-2 px-3 small" role="alert">
                        <i class="bi bi-exclamation-triangle-fill mt-1"></i><span>@ViewBag.Error</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(ViewBag.Success))
                {
                    <div class="alert alert-success d-flex align-items-start gap-2 rounded-3 py-2 px-3 small" role="alert">
                        <i class="bi bi-check-circle-fill mt-1"></i><span>@ViewBag.Success</span>
                    </div>
                }

                <form method="post" action="/Student/ResetPassword" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label" for="currentPassword">Current password</label>
                        <div class="password-field">
                            <input type="password" name="CurrentPassword" id="currentPassword" class="form-control" autocomplete="current-password" required />
                            <button type="button" class="password-toggle" data-password-toggle="#currentPassword" aria-label="Show password"><i class="bi bi-eye-fill"></i></button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="newPassword">New password</label>
                        <div class="password-field">
                            <input type="password" name="NewPassword" id="newPassword" class="form-control" minlength="8" autocomplete="new-password" required />
                            <button type="button" class="password-toggle" data-password-toggle="#newPassword" aria-label="Show password"><i class="bi bi-eye-fill"></i></button>
                        </div>
                        <div class="form-text">Use at least 8 characters.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="confirmPassword">Confirm new password</label>
                        <div class="password-field">
                            <input type="password" name="ConfirmPassword" id="confirmPassword" class="form-control" minlength="8" autocomplete="new-password" required />
                            <button type="button" class="password-toggle" data-password-toggle="#confirmPassword" aria-label="Show password"><i class="bi bi-eye-fill"></i></button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-emerald rounded-pill px-4">
                            <i class="bi bi-shield-lock me-1"></i>Update password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
