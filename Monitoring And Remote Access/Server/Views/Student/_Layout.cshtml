@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CAMS Student</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background-color: #12141a; color: #e6e6e6; }
        .card { background-color: #1c1f27; border: 1px solid #2a2e38; }
        .card-header { background-color: #232733; border-bottom: 1px solid #2a2e38; }
        .nav-link { color: #b6bac6; }
        .nav-link.active { background-color: #3b82f6; color: #fff; }
        .nav-link:hover { color: #fff; }
        .stat { font-size: 1.6rem; font-weight: 700; }
        .list-group-item { background-color: transparent; border-color: #2a2e38; color: #e6e6e6; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark navbar-expand-lg" style="background-color:#1a1d24;">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/Student"><i class="bi bi-person-circle"></i> CAMS Student</a>
            <div class="d-flex align-items-center gap-2 text-light">
                <span class="small">@ViewContext.HttpContext.Session.GetString("FullName")</span>
                <a href="/Account/Logout" class="btn btn-sm btn-outline-danger">Logout</a>
            </div>
        </div>
    </nav>
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-2 col-md-3 pt-3">
                <ul class="nav nav-pills flex-column gap-1">
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" href="/Student"><i class="bi bi-info-circle"></i> Session Info</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Alerts" ? "active" : "")" href="/Student/Alerts"><i class="bi bi-bell"></i> Alert Center</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")" href="/Student/Settings"><i class="bi bi-gear"></i> Account Settings</a></li>
                </ul>
            </div>
            <div class="col-lg-10 col-md-9 pt-3 pb-5">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>