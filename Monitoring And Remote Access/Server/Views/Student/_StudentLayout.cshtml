@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var studentName = ViewContext.HttpContext.Session.GetString("FullName") ?? "Student";
    var assignedUnit = ViewContext.HttpContext.Session.GetString("AssignedUnit") ?? "Unit -";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CAMS Student | Pardo Elementary School</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <!-- Sticky Overlay Toolbar -->
    <div class="bg-white border-bottom py-2 shadow-sm sticky-top">
        <div class="container-fluid d-flex align-items-center justify-content-between px-4 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <button class="btn-toggle-sidebar d-lg-none" id="sidebarToggle" type="button" aria-label="Toggle Navigation" aria-controls="appSidebar" aria-expanded="false"><i class="bi bi-list"></i></button>
                <img src="~/images/pardo_logo.png" alt="Pardo Elementary School" style="height: 38px;" />
                <span class="fw-bold fs-5 text-dark" style="letter-spacing: -0.5px;">CAMS Student</span>
                <span class="badge bg-success rounded-pill px-3 py-2" id="toolbarUnit">
                    <i class="bi bi-pc-display me-1"></i> @assignedUnit
                </span>
                <span class="badge bg-secondary rounded-pill px-3 py-2" id="toolbarSession">No Session</span>
            </div>
            <div class="d-flex align-items-center gap-4">
                <div class="d-flex align-items-center gap-2">
                    <div class="user-avatar-circle" style="width: 34px; height: 34px; font-size: 0.9rem;">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <span class="fw-semibold text-dark fs-6">@studentName</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-muted"></i>
                    <span class="session-timer fs-4" id="toolbarTimer">--:--</span>
                </div>
                <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="app-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="app-sidebar" id="appSidebar" style="min-height: calc(100vh - 60px);">
            <nav class="sidebar-nav pt-4">
                <a href="@Url.Action("Index", "Student")" class="nav-item-custom @(currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>Session Information</span>
                </a>
                <a href="@Url.Action("Alerts", "Student")" class="nav-item-custom @(currentAction == "Alerts" ? "active" : "")">
                    <i class="bi bi-bell-fill"></i>
                    <span>Alert Center</span>
                </a>
                <a href="@Url.Action("Settings", "Student")" class="nav-item-custom @(currentAction == "Settings" ? "active" : "")">
                    <i class="bi bi-gear-fill"></i>
                    <span>Account Settings</span>
                </a>
            </nav>
        </aside>
        <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

        <!-- Main Content Area -->
        <div class="app-main">
            <main role="main" class="content-padding">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Warning / Notification Popup Modal -->
    <div class="modal fade" id="alertModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 text-white" id="alertModalHeader" style="background-color: var(--sidebar-bg);">
                    <h5 class="modal-title fw-bold" id="alertModalTitle">Notification</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4 fs-6" id="alertModalBody">-</div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-emerald rounded-pill px-4" data-bs-dismiss="modal">I Understand</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        const conn = new signalR.HubConnectionBuilder().withUrl("/remoteMonitoringHub").withAutomaticReconnect().build();
        const sidebar = document.getElementById("appSidebar");
        const sidebarToggle = document.getElementById("sidebarToggle");
        const sidebarBackdrop = document.getElementById("sidebarBackdrop");
        const setSidebarOpen = (open) => {
            sidebar?.classList.toggle("show", open);
            sidebarBackdrop?.classList.toggle("show", open);
            document.body.classList.toggle("sidebar-open", open);
            sidebarToggle?.setAttribute("aria-expanded", String(open));
        };
        sidebarToggle?.addEventListener("click", () => setSidebarOpen(!sidebar?.classList.contains("show")));
        sidebarBackdrop?.addEventListener("click", () => setSidebarOpen(false));
        sidebar?.querySelectorAll("a").forEach(link => link.addEventListener("click", () => setSidebarOpen(false)));
        document.addEventListener("keydown", event => { if (event.key === "Escape") setSidebarOpen(false); });
        let sStatus = "None";
        let sElapsed = 0;
        const tTimer = document.getElementById("toolbarTimer");
        const tSession = document.getElementById("toolbarSession");
        const alertModalEl = document.getElementById("alertModal");

        function fmt(sec) {
            const m = Math.floor(sec / 60), s = sec % 60;
            return String(m).padStart(2, "0") + ":" + String(s).padStart(2, "0");
        }
        function render() {
            tTimer.textContent = fmt(Math.max(0, sElapsed));
            tTimer.classList.remove("expired", "warn");
            tSession.textContent = sStatus;
            tSession.className = "badge rounded-pill px-3 py-2 " + (sStatus === "Running" ? "bg-success" : sStatus === "Paused" ? "bg-warning text-dark" : "bg-secondary");
        }
        setInterval(() => { if (sStatus === "Running") { sElapsed++; render(); } }, 1000);
        render();

        conn.on("GlobalSessionState", (state) => {
            sStatus = state.status;
            if (state.status === "Running") sElapsed = state.elapsedSeconds;
            render();
        });
        conn.on("SessionEnded", () => {
            sStatus = "Ended"; sElapsed = 0; render();
            alert("The laboratory session has been ended by the teacher. You will be logged out.");
            location.href = "/Account/Logout";
        });
        conn.on("SendWarningPopup", (w) => {
            document.getElementById("alertModalHeader").style.backgroundColor = "#dc2626";
            document.getElementById("alertModalTitle").textContent = w.title || "Warning";
            document.getElementById("alertModalBody").innerHTML = escapeHtml(w.message || "");
            new bootstrap.Modal(alertModalEl).show();
        });
        conn.on("SendNotification", (n) => {
            document.getElementById("alertModalHeader").style.backgroundColor = "var(--sidebar-bg)";
            document.getElementById("alertModalTitle").textContent = n.title || "Notification";
            document.getElementById("alertModalBody").innerHTML = escapeHtml(n.message || "");
            new bootstrap.Modal(alertModalEl).show();
        });
        conn.on("BroadcastScreen", (b) => {
            document.getElementById("alertModalHeader").style.backgroundColor = "var(--sidebar-bg)";
            document.getElementById("alertModalTitle").textContent = "Teacher Screen Broadcast";
            document.getElementById("alertModalBody").innerHTML = "The teacher is sharing their screen on this unit. Watch the broadcast window on the Student Client.";
            new bootstrap.Modal(alertModalEl).show();
        });

        function escapeHtml(s) { return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }
        conn.start().catch(console.error);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
