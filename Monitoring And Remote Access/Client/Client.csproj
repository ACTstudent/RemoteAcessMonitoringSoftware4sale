<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Gives the executable itself the CAMS mark, so it carries the product
         icon in Explorer, the taskbar and Task Manager, not just at runtime. -->
    <ApplicationIcon>cams.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.30" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="client-settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded, not copied out: the release publish is single-file, which
         never left a loose cams.ico on disk, so the tray fell back to its
         placeholder on every installed machine. BrandIcon reads it from here
         and picks the frame for the size Windows actually asks for. -->
    <EmbeddedResource Include="cams.ico" LogicalName="cams.ico" />
    <!-- The school seal on the sign-in screen. Linked from the portal rather
         than copied, so the client and the web pages always show the same one. -->
    <EmbeddedResource Include="..\Server\wwwroot\images\pardo_logo.png" LogicalName="pardo_logo.png" Link="pardo_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
