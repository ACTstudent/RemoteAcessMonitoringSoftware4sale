        <mxCell id="title" value="CAMS - Database Schema (Crow's Foot ERD)" style="text;html=1;align=left;fontSize=28;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1500" height="40" as="geometry"/></mxCell>
        <mxCell id="legend" value="Every column of every table is shown with its SQLite storage type and nullability, generated from the EF Core model. PK primary key, FK foreign key, UK unique index, UQ composite or filtered unique index. Solid connector = foreign key enforced by the database. Dashed connector = CreatedByType and CreatedById actor pair, correlated by identifier only. Crow foot notation: a bar and circle on the parent end means optional one, a double bar means exactly one, and the fork means zero or many." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="74" width="1500" height="46" as="geometry"/></mxCell>
