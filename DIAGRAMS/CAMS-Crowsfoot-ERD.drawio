        <mxCell id="rel11" value="advises" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#64748b;fontSize=11;fontColor=#64748b;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="TEACHER" target="STUDENT"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1033" y="168"/><mxPoint x="1605" y="168"/></Array></mxGeometry></mxCell>
        <mxCell id="rel12" value="primary class" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#64748b;fontSize=11;fontColor=#64748b;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="CLASS" target="STUDENT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rel13" value="produces" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#64748b;fontSize=11;fontColor=#64748b;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="STUDENT" target="USAGE_LOG"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rel14" value="produces" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#64748b;fontSize=11;fontColor=#64748b;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="STUDENT" target="WEBSITE_USAGE_LOG"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rel15" value="creates" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#b45309;dashed=1;fontSize=11;fontColor=#b45309;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="ADMIN" target="TEACHER"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rel16" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#b45309;dashed=1;fontSize=11;fontColor=#b45309;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="ADMIN" target="STUDENT"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="443" y="196"/><mxPoint x="1583" y="196"/></Array></mxGeometry></mxCell>
        <mxCell id="rel17" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#b45309;dashed=1;fontSize=11;fontColor=#b45309;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="ADMIN" target="CLASS"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="465" y="224"/><mxPoint x="1079" y="224"/></Array></mxGeometry></mxCell>
        <mxCell id="rel18" value="changes status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#b45309;dashed=1;fontSize=11;fontColor=#b45309;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="ADMIN" target="COMPUTER_STATUS_HISTORY"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="487" y="1357"/><mxPoint x="1605" y="1357"/></Array></mxGeometry></mxCell>
      </root>
