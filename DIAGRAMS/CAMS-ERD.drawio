        <mxCell id="SYSTEM_LOG__rows" value="PK  SystemLogId  INTEGER NOT NULL&lt;br&gt;    Level        TEXT(20) NOT NULL&lt;br&gt;    Message      TEXT(500) NOT NULL&lt;br&gt;    StackTrace   TEXT(2000) NOT NULL&lt;br&gt;    Timestamp    TEXT NOT NULL" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#12312A;fontFamily=Courier New;" vertex="1" parent="SYSTEM_LOG"><mxGeometry x="0" y="34" width="367" height="101" as="geometry"/></mxCell>
        <mxCell id="erd-note-0" value="The dashed links are CreatedByType and CreatedById, not foreign keys. A teacher can create these rows too, so the type says which table the id belongs to - the same pair audit entries and workstation status history use. The database cannot enforce it: delete an admin and those ids point at nobody." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#4B5C51;" vertex="1" parent="1"><mxGeometry x="40" y="1468" width="320" height="96" as="geometry"/></mxCell>
        <mxCell id="erd-note-1" value="Role, Permission and RolePermissions are seeded metadata that the Roles and Permissions page displays. They do not grant access: the role of an account is decided by which account table it is in and stamped on the login cookie as a claim. No account table links to Role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#4B5C51;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="320" height="96" as="geometry"/></mxCell>
