        <mxCell id="NOTIFICATION__rows" value="PK  NotificationId&lt;br&gt;     StudentId (no FK)&lt;br&gt;     Type&lt;br&gt;     Title / Message&lt;br&gt;     IsRead / CreatedAt" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#12312A;fontFamily=Courier New;" vertex="1" parent="NOTIFICATION"><mxGeometry x="0" y="30" width="340" height="104" as="geometry"/></mxCell>
        <mxCell id="erd-note-0" value="Admin has no foreign key in either direction. An administrator is recorded in audit and status history by UserType and ChangedByType, which is a stored value, not a relationship. Deleting an admin row breaks nothing and cleans up nothing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#4B5C51;" vertex="1" parent="1"><mxGeometry x="40" y="379" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="erd-note-1" value="Role, Permission and RolePermissions are seeded metadata that the Roles and Permissions page displays. They do not grant access: the role of an account is decided by which account table it is in and stamped on the login cookie as a claim. No account table links to Role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#4B5C51;" vertex="1" parent="1"><mxGeometry x="40" y="795" width="300" height="76" as="geometry"/></mxCell>
