<mxfile host="app.diagrams.net" agent="CAMS diagram generator" version="24.7.17">
  <diagram id="CAMS-Chen-ERD" name="CAMS Chen ERD">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="chen-title" value="CAMS - Conceptual Model (Chen notation)" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#12472F;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="chen-legend" value="Rectangle = entity.   Diamond = relationship.   Ellipse = attribute, key underlined.   The 1, N or M sits at the end of the entity it describes.   A double line means every row of that entity must take part; a single line means it need not." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#4B5C51;" vertex="1" parent="1"><mxGeometry x="200" y="100" width="1500" height="60" as="geometry"/></mxCell>
        <mxCell id="note_creates" value="Creates is the CreatedByType and CreatedById pair, not a foreign key: the type names the table the id belongs to. A teacher can create students and classes too, and carries the same pair; only the Admin links are drawn, to keep one line per idea. Seeded rows, and rows older than the columns, read System." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5C51;" vertex="1" parent="1"><mxGeometry x="200" y="500" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="note_sessions" value="Filtered unique indexes allow at most one active lab session per student and at most one per workstation. A student or a workstation may have many sessions over time, but only one running at once." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5C51;" vertex="1" parent="1"><mxGeometry x="2860" y="1900" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="note_absent" value="Left out deliberately: Role and Permission, which are seeded metadata that no account table links to, and the telemetry that identifies a student by value rather than by foreign key - activity events, idle intervals, browser records and alerts. Both appear in the crow's foot diagram." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5C51;" vertex="1" parent="1"><mxGeometry x="200" y="2320" width="620" height="130" as="geometry"/></mxCell>
