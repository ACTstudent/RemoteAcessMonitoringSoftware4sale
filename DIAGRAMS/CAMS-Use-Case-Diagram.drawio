        <mxCell id="uc-overview-t" value="CAMS - Use Case Diagram  ·  Overview" style="text;html=1;align=left;fontSize=24;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="uc-overview-l" value="Three actors use CAMS. Administrator and Teacher share most of the administration surface: AdminController is authorised for either role and admits a teacher to every action marked [TeacherSharedAction], which is 56 of them, so a case reaches both actors unless it is one of the administrator-only pages. The workstation client and the scheduled background work are part of the system, not actors, so what they do is drawn as included behaviour. Later pages open each package." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#5A6673;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="900" height="42" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
