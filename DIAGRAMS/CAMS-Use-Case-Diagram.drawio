        <mxCell id="uc-auth-l" value="A line from an actor is an association. A dashed arrow marked «include» runs from the base case to behaviour it always performs; one marked «extend» runs from the optional case back to the case it extends." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#5A6673;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1090" height="42" as="geometry"/></mxCell>
