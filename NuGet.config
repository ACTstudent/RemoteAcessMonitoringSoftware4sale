<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear drops any feed configured machine-wide, so a restore here resolves
         from the same place on every machine and on CI. Every package this
         solution references is pinned to an exact version and comes from
         nuget.org; there is no private feed to preserve. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
